      modify \\\"$box\\\" --secret \\\"GH_TOKEN@${MSW_GITHUB_SECRET_HOSTS}\\\" --restart
      >/dev/null\\n unset token\\n}\\n\\nremove_github_secret() {\\n local box=\\\"$1\\\"
      inspect_rc\\n if sandbox_inspect_state \\\"$box\\\"; then\\n :\\n else\\n inspect_rc=$?\\n if
      (( inspect_rc == 1 )); then return 0; fi\\n printf 'msw: could not inspect workspace %s before
      removing its GitHub secret\\\\n' \\\"$box\\\" >&2\\n return 1\\n fi\\n \\\"$MSB_BIN\\\" modify
      \\\"$box\\\" --secret-rm GH_TOKEN --restart >/dev/null\\n}\\n\\nhost_safe_path() {\\n local
      path=\\\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin\\\" dir tool\\n for
      tool in \\\"$GIT_BIN\\\" \\\"$(command -v git-lfs 2>/dev/null || true)\\\"
      \\\"$ASKPASS_BIN\\\"; do\\n [[ -n \\\"$tool\\\" ]] || continue\\n dir=\\\"$(dirname
      \\\"$tool\\\")\\\"\\n case \\\":$path:\\\" in *\\\":$dir:\\\"*) ;; *) path=\\\"$dir:$path\\\"
      ;; esac\\n done\\n printf '%s\\\\n' \\\"$path\\\"\\n}\\n\\nhost_git_run() {\\n local
      temp_home=\\\"$1\\\" box=\\\"$2\\\"; shift 2\\n mkdir -p \\\"$temp_home\\\"\\n env -i \\\\\\n
      HOME=\\\"$temp_home\\\" \\\\\\n XDG_CONFIG_HOME=\\\"$temp_home/.config\\\" \\\\\\n
      TMPDIR=\\\"${TMPDIR:-/tmp}\\\" \\\\\\n PATH=\\\"$(host_safe_path)\\\" \\\\\\n
      GIT_CONFIG_NOSYSTEM=1 \\\\\\n GIT_CONFIG_GLOBAL=/dev/null \\\\\\n GIT_TERMINAL_PROMPT=0
      \\\\\\n GIT_ASKPASS=\\\"$ASKPASS_BIN\\\" \\\\\\n GIT_ASKPASS_REQUIRE=force \\\\\\n
      SSH_ASKPASS=\\\"$ASKPASS_BIN\\\" \\\\\\n MSW_KEYCHAIN_SERVICE=\\\"$WRITE_KEYCHAIN_SERVICE\\\"
      \\\\\\n MSW_KEYCHAIN_ACCOUNT=\\\"$box\\\" \\\\\\n
      MSW_TEST_KEYCHAIN_DIR=\\\"${MSW_TEST_KEYCHAIN_DIR:-}\\\" \\\\\\n GIT_LFS_SKIP_SMUDGE=1 \\\\\\n
      \\\"$@\\\"\\n}\\n\\nhost_remote_url() {\\n local canonical=\\\"$1\\\" path owner repo\\n if [[
      -n \\\"${MSW_TEST_GITHUB_REMOTE_ROOT:-}\\\" ]]; then\\n
      path=\\\"${canonical#https://github.com/}\\\"\\n path=\\\"${path%.git}\\\"\\n
      owner=\\\"${path%%/*}\\\"; repo=\\\"${path#*/}\\\"\\n printf '%s/%s/%s.git\\\\n'
      \\\"$MSW_TEST_GITHUB_REMOTE_ROOT\\\" \\\"$owner\\\" \\\"$repo\\\"\\n else\\n printf '%s\\\\n'
      \\\"$canonical\\\"\\n fi\\n}\\n\\nhost_delete_branch() {\\n local box=\\\"$1\\\"
      canonical_url=\\\"$2\\\" branch=\\\"$3\\\" temp temp_home repo remote\\n temp=\\\"$(mktemp -d
      \\\"${TMPDIR:-/tmp}/msw-delete.XXXXXX\\\")\\\"\\n temp_home=\\\"$temp/home\\\";
      repo=\\\"$temp/repo\\\"; remote=\\\"$(host_remote_url \\\"$canonical_url\\\")\\\"\\n
      \\\"$GIT_BIN\\\" init -q \\\"$repo\\\"\\n host_git_run \\\"$temp_home\\\" \\\"$box\\\"
      \\\"$GIT_BIN\\\" -C \\\"$repo\\\" \\\\\\n -c credential.helper= -c core.hooksPath=/dev/null
      \\\\\\n push \\\"$remote\\\" \\\":refs/heads/$branch\\\"\\n rm -rf \\\"$temp\\\"\\n}\\n\\n if
      (( preexisting_quarantine )); then\\n quarantine_workspace \\\"$box\\\" \\\"GitHub repair
      verification failed\\\" >/dev/null 2>&1 || true\\n setup_transaction_disarm\\n
      github_lock_release\\n warn \\\"GitHub repair verification failed; workspace remains
      quarantined\\\"\\n unset old_read old_write\\n return 1\\n fi\\n if ! clear_quarantine
      \\\"$box\\\"; then fatal \\\"could not clear GitHub workspace quarantine for $box\\\"; fi\\n
      setup_transaction_disarm\\n github_lock_release\\n unset old_read old_write\\n return 1\\n
      fi\\n if ! clear_quarantine \\\"$box\\\"; then fatal \\\"could not clear GitHub workspace
      quarantine for $box\\\"; fi\\n setup_transaction_disarm\\n github_lock_release\\n unset
      old_read old_write\\n ok \\\"GitHub configured for $box
      ($mode)\\\"\\n}\\n\\ncmd_github_status() {\\n local target=\\\"${1:-all}\\\" box repo
      read_state write_state\\n printf '%-13s %-10s %-10s %s\\\\n' WORKSPACE GUEST_READ HOST_WRITE
      VERIFICATION_REPO\\n while IFS= read -r box; do\\n if keychain_has
      \\\"$READ_KEYCHAIN_SERVICE\\\" \\\"$box\\\"; then read_state=present; else read_state=missing;
      fi\\n if keychain_has \\\"$WRITE_KEYCHAIN_SERVICE\\\" \\\"$box\\\"; then write_state=present;
      else write_state=missing; fi\\n repo=\\\"$(metadata_repo \\\"$box\\\" 2>/dev/null || printf
      '-')\\\"\\n printf '%-13s %-10s %-10s %s\\\\n' \\\"$box\\\" \\\"$read_state\\\"
      \\\"$write_state\\\" \\\"$repo\\\"\\n done < <(for_targets
      \\\"$target\\\")\\n}\\n\\ncmd_github_remove() {\\n local box=\\\"$1\\\" meta_file
      cleanup_failed=0\\n validate_workspace \\\"$box\\\"\\n if ! github_lock_acquire \\\"$box\\\";
      then fatal \\\"could not acquire GitHub workspace lock for $box\\\"; fi\\n
      meta_file=\\\"$(metadata_file \\\"$box\\\")\\\"\\n rm -f \\\"$meta_file\\\"\\n [[ ! -e
      \\\"$meta_file\\\" ]] || fatal \\\"could not revoke GitHub host-write metadata for $box\\\"\\n
      if ! remove_github_secret \\\"$box\\\"; then cleanup_failed=1; fi\\n if ! keychain_delete
      \\\"$READ_KEYCHAIN_SERVICE\\\" \\\"$box\\\"; then cleanup_failed=1; fi\\n if ! keychain_delete
      \\\"$WRITE_KEYCHAIN_SERVICE\\\" \\\"$box\\\"; then cleanup_failed=1; fi\\n if ((
      cleanup_failed )); then\\n if ! quarantine_workspace \\\"$box\\\" \\\"GitHub credential
      removal failed\\\"; then\\n fatal \\\"GitHub credential removal failed and workspace
      quarantine could not be recorded\\\"\\n fi\\n fatal \\\"GitHub credential removal failed;
      workspace quarantined\\\"\\n fi\\n if ! clear_quarantine \\\"$box\\\"; then fatal \\\"could
      not clear GitHub workspace quarantine for $box\\\"; fi\\n github_lock_release\\n ok
      \\\"removed GitHub credentials for $box\\\"\\n}\\n\\ncmd_github() {\\n local
      sub=\\\"${1:-status}\\\"; shift || true\\n case \\\"$sub\\\" in\\n setup)\\n (( $# >= 2 && $#
      <= 3 )) || fatal \\\"usage: msw github setup WORKSPACE OWNER/REPO [--read-only]\\\"\\n
      cmd_github_setup \\\"$1\\\" \\\"$2\\\" \\\"${3:-}\\\"\\n ;;\\n verify)\\n (( $# >= 1 && $# <=
      2 )) || fatal \\\"usage: msw github verify WORKSPACE [REPO]\\\"\\n cmd_github_verify
      \\\"$1\\\" \\\"${2:-}\\\"\\n ;;\\n status)\\n cmd_github_status \\\"${1:-all}\\\"\\n ;;\\n
      remove)\\n (( $# == 1 )) || fatal \\\"usage: msw github remove WORKSPACE\\\"\\n
      cmd_github_remove \\\"$1\\\"\\n ;;\\n *) fatal \\\"unknown github command '$sub'\\\" ;;\\n
      esac\\n}\\n\\nhost_network_check() {\\n local failed=0 box ip host\\n if [[
      \\\"${MSW_TEST_MODE:-0}\\\" == 1 ]]; then\\n local root=\\\"$HOME/.config/msw/test-host\\\"\\n
      [[ -f \\\"$root/hosts\\\" && -f \\\"$root/loopback\\\" ]] || return 1\\n return 0\\n fi\\n for
      box in \\\"${WORKSPACES[@]}\\\"; do\\n ip=\\\"$(workspace_ip \\\"$box\\\")\\\";
      host=\\\"$(workspace_host \\\"$box\\\")\\\"\\n /sbin/ifconfig lo0 | /usr/bin/grep -q \\\"inet
      ${ip} \\\" || { echo \\\"$box: loopback $ip missing\\\" >&2; failed=1; }\\n
      /usr/bin/dscacheutil -q host -a name \\\"$host\\\" | /usr/bin/grep -q \\\"$ip\\\" || { echo
      \\\"$box: hostname $host missing\\\" >&2; failed=1; }\\n done\\n return
      \\\"$failed\\\"\\n}\\n\\ncmd_check_quick() {\\n local failed=0 box\\n note \\\"MicroSandbox
      runtime\\\"\\n \\\"$MSB_BIN\\\" doctor || failed=1\\n note \\\"Host browser and SSH
      integration\\\"\\n host_network_check || failed=1\\n [[ -f
      \\\"$HOME/.ssh/config.d/msw.conf\\\" ]] || { echo \\\"SSH config missing\\\" >&2; failed=1;
      }\\n [[ -x \\\"$HOME/.local/bin/msw-ssh-proxy\\\" ]] || { echo \\\"SSH proxy missing\\\" >&2;
      failed=1; }\\n [[ -x \\\"$ASKPASS_BIN\\\" ]] || { echo \\\"Git askpass helper missing\\\" >&2;
      failed=1; }\\n note \\\"Base snapshot and workspace storage\\\"\\n snapshot_exists
      \\\"$MSW_BASE_SNAPSHOT\\\" || { echo \\\"snapshot $MSW_BASE_SNAPSHOT missing\\\" >&2;
      failed=1; }\\n for box in \\\"${WORKSPACES[@]}\\\"; do\\n sandbox_exists \\\"$box\\\" || {
      echo \\\"$box: sandbox missing\\\" >&2; failed=1; }\\n volume_exists \\\"$(workspace_volume
      \\\"$box\\\" workspace)\\\" || { echo \\\"$box: workspace volume missing\\\" >&2; failed=1;
      }\\n volume_exists \\\"$(workspace_volume \\\"$box\\\" runtime)\\\" || { echo \\\"$box:
      runtime volume missing\\\" >&2; failed=1; }\\n done\\n (( failed == 0 )) || fatal \\\"one or
      more checks failed; rerun setup.sh\\\"\\n ok \\\"quick checks
      passed\\\"\\n}\\n\\ncheck_one_deep() {\\n local box=\\\"$1\\\" was_running=0 failed=0 host
      direct_url docker_url direct_unit docker_name\\n \\\"$MSB_BIN\\\" ping -q \\\"$box\\\"
      >/dev/null 2>&1 && was_running=1\\n ensure_running \\\"$box\\\"\\n host=\\\"$(workspace_host
      \\\"$box\\\")\\\"\\n direct_unit=\\\"msw-health-direct-${box}\\\"\\n
      docker_name=\\\"msw-health-docker-${box}\\\"\\n
      direct_url=\\\"http://${host}:24678/msw-health.txt\\\"\\n
      docker_url=\\\"http://${host}:24679/\\\"\\n\\n note \\\"Deep-checking $box\\\"\\n local
      script\\n read -r -d '' script <<'SCRIPT' || true\\nset -Eeuo pipefail\\n[ \\\"$(uname -m)\\\"
      = aarch64 ]\\n[ \\\"$(cat /proc/1/comm)\\\" = systemd ]\\n[ \\\"$(findmnt -n -o FSTYPE
      /workspace)\\\" = ext4 ]\\n[ \\\"$(findmnt -n -o FSTYPE /var/lib/msw-runtime)\\\" = ext4
      ]\\nsystemctl is-active --quiet docker\\nsystemctl is-active --quiet containerd\\ndocker info
      >/dev/null\\ndocker compose version >/dev/null\\ndocker buildx version >/dev/null\\ncurl -fsS
      --max-time 20 https://github.com/robots.txt >/dev/null\\nSCRIPT\\n guest_script \\\"$box\\\"
      \\\"$script\\\" || failed=1\\n\\n \\\"$SSH_BIN\\\" -o BatchMode=yes -o ConnectTimeout=20
      \\\"$(workspace_ssh_host \\\"$box\\\")\\\" true || failed=1\\n\\n guest_exec \\\"$box\\\"
      systemctl stop \\\"$direct_unit.service\\\" >/dev/null 2>&1 || true\\n guest_exec \\\"$box\\\"
      bash -lc \\\"printf '%s\\\\\\\\n' '$box-direct-ok' >/tmp/msw-health.txt && systemd-run --quiet
      --unit='$direct_unit' --collect python3 -m http.server 24678 --bind 0.0.0.0 --directory
      /tmp\\\" || failed=1\\n local attempt=0 body=\\\"\\\"\\n until body=\\\"$(\\\"$CURL_BIN\\\"
      -fsS --max-time 2 \\\"$direct_url\\\" 2>/dev/null)\\\"; do\\n attempt=$((attempt + 1)); ((
      attempt < 30 )) || break; sleep 0.2\\n done\\n [[ \\\"$body\\\" == \\\"$box-direct-ok\\\" ]]
      || { echo \\\"$box: direct published port failed\\\" >&2; failed=1; }\\n guest_exec
      \\\"$box\\\" systemctl stop \\\"$direct_unit.service\\\" >/dev/null 2>&1 || true\\n\\n
      guest_exec \\\"$box\\\" docker rm -f \\\"$docker_name\\\" >/dev/null 2>&1 || true\\n
      guest_exec \\\"$box\\\" docker run -d --name \\\"$docker_name\\\" -p 24679:80 nginx:alpine
      >/dev/null || failed=1\\n attempt=0; body=\\\"\\\"\\n until body=\\\"$(\\\"$CURL_BIN\\\" -fsS
      --max-time 2 \\\"$docker_url\\\" 2>/dev/null)\\\"; do\\n attempt=$((attempt + 1)); (( attempt
      < 60 )) || break; sleep 0.5\\n done\\n [[ \\\"$body\\\" == *\\\"Welcome to nginx\\\"* ]] || {
      echo \\\"$box: Docker published port failed\\\" >&2; failed=1; }\\n guest_exec \\\"$box\\\"
      docker rm -f \\\"$docker_name\\\" >/dev/null 2>&1 || true\\n\\n if keychain_has
      \\\"$READ_KEYCHAIN_SERVICE\\\" \\\"$box\\\"; then\\n guest_exec \\\"$box\\\" sh -c 'case
      \\\"${GH_TOKEN:-}\\\" in \\\\$MSB_GH_TOKEN*|\\\\$GH_TOKEN*) exit 0;; *) exit 1;; esac' || {\\n
      echo \\\"$box: GitHub secret is not represented by a guest placeholder\\\" >&2; failed=1;\\n
      }\\n fi\\n\\n if (( was_running == 0 )); then \\\"$MSB_BIN\\\" stop -q -t 60 \\\"$box\\\"
      >/dev/null 2>&1 || failed=1; fi\\n (( failed == 0 )) || return 1\\n ok \\\"$box
      passed\\\"\\n}\\n\\ncmd_check() {\\n local deep=0 arg failed=0 box\\n for arg in \\\"$@\\\";
      do case \\\"$arg\\\" in --deep) deep=1 ;; *) fatal \\\"unknown check option: $arg\\\" ;; esac;
      done\\n cmd_check_quick\\n (( deep == 1 )) || return 0\\n require_command_path ssh
      \\\"$SSH_BIN\\\"\\n require_command_path curl \\\"$CURL_BIN\\\"\\n for box in
      \\\"${WORKSPACES[@]}\\\"; do check_one_deep \\\"$box\\\" || failed=1; done\\n (( failed == 0
      )) || fatal \\\"deep checks failed\\\"\\n ok \\\"all live VM, Docker, SSH, internet, and
      published-port checks passed\\\"\\n}\\n\\nmanaged_backup_paths() {\\n cat
      <<'PATHS'\\n.microsandbox\\n.config/msw\\n.local/bin/msw\\n.local/bin/msw-ssh-proxy\\n.local/l
      ibexec/msw-git-askpass\\n.local/share/msw\\n.ssh/msw_ed25519\\n.ssh/msw_ed25519.pub\\n.ssh/con
      fig.d/msw.conf\\nPATHS\\n}\\n\\nrunning_workspaces() {\\n local box\\n\\ncmd_docs() {\\n local
      topic=\\\"${1:-cheatsheet}\\\" file pager\\n case \\\"$topic\\\" in\\n cheatsheet|commands)
      file=\\\"$MSW_DOCS_DIR/MSW-CHEATSHEET.md\\\" ;;\\n setup)
      file=\\\"$MSW_DOCS_DIR/SETUP-GUIDE.md\\\" ;;\\n github)
      file=\\\"$MSW_DOCS_DIR/GITHUB-SETUP.md\\\" ;;\\n tests|test-report)
      file=\\\"$MSW_DOCS_DIR/TEST-REPORT.md\\\" ;;\\n *) fatal \\\"docs topic must be cheatsheet,
      setup, github, or tests\\\" ;;\\n esac\\n [[ -f \\\"$file\\\" ]] || fatal \\\"documentation
      missing; rerun setup.sh\\\"\\n pager=\\\"${PAGER:-less}\\\"\\n if [[ -t 1 && \\\"$pager\\\" !=
      cat ]]; then \\\"$pager\\\" \\\"$file\\\"; else cat \\\"$file\\\"; fi\\n}\\n\\nshow_help()
      {\\n cat <<'HELP'\\nMSW — grouped MicroSandbox development workspaces\\n\\nEnter / edit\\n msw
      dev [PATH] Ghostty/SSH shell in dev\\n msw playgrounds [PATH] Shell in playgrounds\\n msw
      personal [PATH] Shell in personal\\n msw zed WORKSPACE [PATH] Open workspace/repository in
      Zed\\n msw exec WORKSPACE COMMAND... Run a command in /workspace\\n\\nRepositories\\n msw
      clone WORKSPACE OWNER/REPO [PATH] Clone, including into nested folders\\n msw repos WORKSPACE
      List repositories\\n msw pull WORKSPACE [PATH|all] Fast-forward-only pull\\n msw push
      WORKSPACE PATH [--yes] Explicit host-only push\\n msw push ... --force-with-lease Exact
      lease-protected force push\\n msw identity \\\"NAME\\\" EMAIL [TARGET] Set commit
      identity\\n\\nGitHub permissions\\n msw github setup WORKSPACE OWNER/REPO [--read-only]\\n
      Store tokens and run the permission test\\n msw github verify WORKSPACE [REPO] Rerun the
      configured permission test\\n msw github status [WORKSPACE|all] Show credential presence\\n
      msw github remove WORKSPACE Remove that workspace's tokens\\n\\nWebsites\\n msw open WORKSPACE
      [PORT] [SCHEME] Start VM and open published URL\\n msw url WORKSPACE [PORT] [SCHEME] Print
      URL\\n msw ports [WORKSPACE|all] List pre-published ports\\n msw tunnel WORKSPACE REMOTE
      [LOCAL] Temporary tunnel for an unlisted port\\n\\nLifecycle / maintenance\\n msw
      start|stop|restart [TARGET] TARGET is a workspace or all\\n msw status VM status and URLs\\n
      msw metrics [TARGET] Live metrics\\n msw logs WORKSPACE [MSB OPTIONS] Sandbox logs\\n msw disk
      [TARGET] Filesystem and Docker usage\\n msw resize WORKSPACE MEMORY [CPUS] Resize within
      configured limits\\n msw clean [TARGET] [--volumes] Prune Docker; volumes require explicit
      opt-in\\n msw upgrade [TARGET] Upgrade guest Ubuntu packages\\n msw update Update
      MicroSandbox\\n msw check [--deep] Configuration or full end-to-end check\\n msw host repair
      Recreate local names, loopbacks, and SSH setup\\n\\nBackup / reference\\n msw backup
      [DIRECTORY] Cold sparse zstd backup; restarts prior VMs\\n msw restore ARCHIVE Transactional
      restore; leaves VMs stopped\\n msw docs [cheatsheet|setup|github|tests]\\n msw version\\n msw
      help\\nHELP\\n}\\n\\nmain() {\\n local command=\\\"${1:-help}\\\"\\n shift || true\\n case
      \\\"$command\\\" in\\n version|--version|-V) printf 'msw %s\\\\n' \\\"$MSW_VERSION\\\"; return
      ;;\\n help|--help|-h) show_help; return ;;\\n docs) (( $# <= 1 )) || fatal \\\"usage: msw docs
      [TOPIC]\\\"; cmd_docs \\\"${1:-cheatsheet}\\\"; return ;;\\n esac\\n require_command_path msb
      \\\"$MSB_BIN\\\"\\n case \\\"$command\\\" in\\n dev|playgrounds|personal)\\n (( $# <= 1 )) ||
      fatal \\\"usage: msw $command [PATH]\\\"\\n cmd_shell \\\"$command\\\" \\\"${1:-}\\\"\\n ;;\\n
      shell)\\n (( $# >= 1 && $# <= 2 )) || fatal \\\"usage: msw shell WORKSPACE [PATH]\\\"\\n
      cmd_shell \\\"$1\\\" \\\"${2:-}\\\"\\n ;;\\n zed)\\n (( $# >= 1 && $# <= 2 )) || fatal
      \\\"usage: msw zed WORKSPACE [PATH]\\\"\\n cmd_zed \\\"$1\\\" \\\"${2:-}\\\"\\n ;;\\n open)\\n
      (( $# >= 1 && $# <= 3 )) || fatal \\\"usage: msw open WORKSPACE [PORT] [http|https]\\\"\\n
      cmd_open \\\"$1\\\" \\\"${2:-3000}\\\" \\\"${3:-http}\\\"\\n ;;\\n url)\\n (( $# >= 1 && $# <=
      3 )) || fatal \\\"usage: msw url WORKSPACE [PORT] [http|https]\\\"\\n cmd_url \\\"$1\\\"
      \\\"${2:-3000}\\\" \\\"${3:-http}\\\"\\n ;;\\n ports) cmd_ports \\\"${1:-all}\\\" ;;\\n
      tunnel)\\n (( $# >= 2 && $# <= 3 )) || fatal \\\"usage: msw tunnel WORKSPACE REMOTE_PORT
      [LOCAL_PORT]\\\"\\n cmd_tunnel \\\"$1\\\" \\\"$2\\\" \\\"${3:-$2}\\\"\\n ;;\\n clone)\\n (( $#
      >= 2 && $# <= 3 )) || fatal \\\"usage: msw clone WORKSPACE OWNER/REPO [PATH]\\\"\\n cmd_clone
      \\\"$1\\\" \\\"$2\\\" \\\"${3:-}\\\"\\n ;;\\n repos) (( $# == 1 )) || fatal \\\"usage: msw
      repos WORKSPACE\\\"; cmd_repos \\\"$1\\\" ;;\\n pull)\\n (( $# >= 1 && $# <= 2 )) || fatal
      \\\"usage: msw pull WORKSPACE [PATH|all]\\\"\\n cmd_pull \\\"$1\\\" \\\"${2:-all}\\\"\\n ;;\\n
      push)\\n (( $# >= 2 )) || fatal \\\"usage: msw push WORKSPACE PATH [--yes]
      [--force-with-lease]\\\"\\n local push_box=\\\"$1\\\" push_path=\\\"$2\\\"; shift
      2\\n#!/usr/bin/env bash\\n# MicroSandbox Workspaces configuration.\\n# The installer copies
      this file to ~/.config/msw/config.sh and preserves local
      edits.\\n\\nMSW_VERSION=\\\"3.1.0\\\"\\n\\n# Shared base image and immutable development
      snapshot.\\nMSW_BASE_IMAGE=\\\"ghcr.io/superradcompany/ubuntu-systemd:24.04\\\"\\nMSW_BASE_BUI
      LDER=\\\"msw-base-builder\\\"\\nMSW_BASE_SNAPSHOT=\\\"msw-base-v1\\\"\\nMSW_ROOT_DISK=\\\"48G\
      \\"\\n\\n# Friendly browser names. Each VM has a distinct loopback IP, so identical ports
      can\\n# be used concurrently by all workspaces while remaining local to this
      Mac.\\nMSW_DEV_IP=\\\"127.0.0.10\\\"\\nMSW_DEV_HOST=\\\"dev.msw.test\\\"\\nMSW_PLAYGROUNDS_IP=
      \\\"127.0.0.11\\\"\\nMSW_PLAYGROUNDS_HOST=\\\"playgrounds.msw.test\\\"\\nMSW_PERSONAL_IP=\\\"1
      27.0.0.12\\\"\\nMSW_PERSONAL_HOST=\\\"personal.msw.test\\\"\\n\\n# Workspace CPU defaults plus
      each workspace's live memory limit and resize
      ceiling.\\nMSW_DEV_CPUS=\\\"8\\\"\\nMSW_DEV_MAX_CPUS=\\\"12\\\"\\nMSW_DEV_MEMORY=\\\"32G\\\"\\
      nMSW_DEV_MAX_MEMORY=\\\"48G\\\"\\n\\nMSW_PLAYGROUNDS_CPUS=\\\"4\\\"\\nMSW_PLAYGROUNDS_MAX_CPUS
      =\\\"12\\\"\\nMSW_PLAYGROUNDS_MEMORY=\\\"32G\\\"\\nMSW_PLAYGROUNDS_MAX_MEMORY=\\\"48G\\\"\\n\\
      nMSW_PERSONAL_CPUS=\\\"6\\\"\\nMSW_PERSONAL_MAX_CPUS=\\\"12\\\"\\nMSW_PERSONAL_MEMORY=\\\"16G\
      \\"\\nMSW_PERSONAL_MAX_MEMORY=\\\"32G\\\"\\n\\n# Independent persistent ext4 volumes. Adjust
      before first installation if
      needed.\\nMSW_DEV_WORKSPACE_SIZE=\\\"120G\\\"\\nMSW_DEV_RUNTIME_SIZE=\\\"100G\\\"\\nMSW_PLAYGR
      OUNDS_WORKSPACE_SIZE=\\\"60G\\\"\\nMSW_PLAYGROUNDS_RUNTIME_SIZE=\\\"60G\\\"\\nMSW_PERSONAL_WOR
      KSPACE_SIZE=\\\"100G\\\"\\nMSW_PERSONAL_RUNTIME_SIZE=\\\"80G\\\"\\n\\n# Published on every
      workspace's own loopback IP.\\n# 24678 and 24679 are reserved for automated end-to-end health
      tests.\\nMSW_PUBLISHED_PORTS=\\\"1234,1337,24678-24679,3000-3010,3100,3333,3306-3308,4000-4005
      ,4173,4200,4321,5001-5005,5173-5180,5432-5435,5555,6006,6379-6382,7001-7005,8000-8010,8080-809
      0,8787,8888,9000-9005,9229-9230,27017-27019\\\"\\n\\n# The guest sees a placeholder named
      GH_TOKEN. The real read token stays on the host\\n# and is substituted only when traffic
      reaches one of these GitHub
      endpoints.\\nMSW_GITHUB_SECRET_HOSTS=\\\"github.com,api.github.com\\\"\\n\\nMSW_BACKUP_DIR=\\\
      "$HOME/Backups/microsandbox\\\"\\nMSW_DOCS_DIR=\\\"$HOME/.local/share/msw/docs\\\"\\n# MSW
      3.1.0 test report\\n\\n## Result\\n\\n**46 automated release scenarios passed.** The suite
      drives the actual packaged `setup.sh` and installed `msw` CLI against a stateful MicroSandbox
      simulator, while using real local Git repositories and bare remotes for clone, fetch, pull,
      bundle, push, force-with-lease, and Git LFS behavior.\\n\\nThe release suite covers strict
      1–65535 tunnel-port validation, GitHub least-privilege boundaries, transactional Keychain
      cleanup, host-write metadata authorization, stale-token rejection in read-only workspaces,
      fail-closed `security(1)` deletion handling, metadata revocation before fallible credential
      cleanup, rollback safety when credential deletion fails, interruption-safe setup transactions,
      and fail-closed workspace quarantine. The exact packaged archive is also extracted into a
      clean directory and subjected to syntax, documentation, installation, GitHub-boundary, and
      deep-check smoke tests before release.\\n\\n## Automated coverage\\n\\n### Syntax and release
      invariants — 2 scenarios\\n\\n- Bash syntax for installer, CLI, bootstrap, SSH proxy, and
      askpass helper.\\n- Python compilation for simulators.\\n- Bash 3.2 compatibility checks.\\n-
      Published-port configuration and duplicate prevention.\\n- Documentation consistency and
      stale-command detection.\\n- Host Git isolation invariants.\\n- Exact force-with-lease
      construction.\\n- LFS SHA-256 verification.\\n- No SSH-agent forwarding or host Docker-socket
      sharing.\\n- Read secret limited to the configured GitHub hosts.\\n- Current `msb self update`
      command path.\\n\\n### Installer and daily operation — 11 scenarios\\n\\n- Fresh installation
      of all three workspaces, six persistent volumes, common snapshot, resources, labels, and fixed
      port maps.\\n- Idempotent installer rerun.\\n- VM-root recreation while preserving repository
      and Docker volumes.\\n- Version migration while preserving both persistent data volumes.\\n-
      Config reset and base-snapshot rebuild.\\n- Published URLs, browser open, Zed URI, Ghostty/SSH
      shell, and temporary tunnel flows.\\n- Tunnel-port rejection for invalid, zero, and
      out-of-range values.\\n- Docker cleanup preserving volumes unless `--volumes` is explicit.\\n-
      Supported MicroSandbox self-update flow.\\n- Start, stop, restart, resize, missing-token
      guard, and SSH proxy behavior.\\n- Nested clone paths, direct in-VM cloning, repository
      listing, identity, fast-forward pull, path containment, and duplicate-destination
      rejection.\\n\\n### GitHub and host-only push — 26 scenarios\\n\\n- Complete GitHub setup
      transaction: read token binding, guest push rejection, host push success, temporary-branch
      cleanup, token secrecy, status, and removal.\\n- Identical read/write token rejection.\\n-
      Failed verification restoring the previous working tokens and metadata.\\n- Detection and
      rollback when the guest token has write permission.\\n- New-branch push transferring only the
      current committed branch—not dirty files, tags, or other branches.\\n- Repeated fast-forward
      pushes and guest remote-tracking refresh.\\n- Non-fast-forward rejection followed by exact
      lease-protected force push.\\n- Concurrent remote update causing force-with-lease
      rejection.\\n- Detached HEAD, non-GitHub origin, missing host token, and user-cancel failure
      paths.\\n- Isolation from hostile host global Git configuration and hooks.\\n- Valid Git LFS
      object transfer and host-only upload.\\n- Invalid LFS pointer rejection.\\n- Missing LFS
      object rejection.\\n- Corrupted LFS transfer rejection by SHA-256.\\n- Symlink/nonregular LFS
      object rejection.\\n- Read-only setup retains guest read access without a host token and
      blocks stale write-token pushes using workspace metadata.\\n- Read-only conversion revokes
      existing host-write metadata before downgrade cleanup; failure leaves subsequent pushes
      blocked.\\n- Keychain deletion rejects delete failures, post-delete lookup failures, and
      still-present items while accepting explicit missing-item results.\\n- Remove revokes
      host-write metadata before credential cleanup; a failed Keychain delete leaves subsequent
      pushes blocked.\\n- Failed setup rollback revokes active metadata before credential cleanup;
      deletion failures leave subsequent pushes blocked.\\n- Failed guest-secret removal stops and
      quarantines the workspace so normal starts, restarts, pushes, and guest commands cannot rebind
      or use the secret.\\n- Proven-stop quarantine handling is fail-closed when ping or inspect is
      unavailable, or stop fails.\\n- Per-workspace GitHub setup/remove locks serialize credential,
      metadata, and quarantine mutations.\\n- Dead-owner recovery migrates legacy lock directories
      and uses kernel-held `lockf` ownership, so stale or empty lock files do not wedge future
      operations.\\n- Standalone verification blocks removal through `SIGKILL`, and an orphaned
      setup verifier retains the lock after its parent dies.\\n- An interrupted verification
      followed by a failed repair never restores tainted credentials or metadata and leaves the
      quarantine marker in place.\\n- Interruption coverage pauses after a completed verification
      clone and confirms signal cleanup removes its checkout.\\n\\n### Backup and restore — 6
      scenarios\\n\\n- Cold backup restoring only the previously running VM set and excluding
      Keychain credentials.\\n- Full backup/restore of workspace files, Docker runtime data, and MSW
      configuration.\\n- Corrupt-checksum rejection before mutation.\\n- Rejection of traversal,
      duplicate, incomplete, unexpected, and absolute-symlink archive content.\\n- Failed
      restored-state health check rolling back to the previous installation.\\n- Interrupted/failing
      compression restarting prior VMs and leaving no partial archive.\\n\\n### Packaged behavior —
      1 scenario\\n\\n- Help, version, and installed documentation without a functioning `msb`
      binary.\\n- Complete simulated `msw check --deep` covering each VM, Docker Engine, Compose
      bind mounts, SSH, public internet, direct process port publication, and Docker-published port
      publication.\\n- Health-test process/container cleanup.\\n\\n## Security properties
      exercised\\n\\n- The real guest read token is absent from simulated VM state; only the
      MicroSandbox placeholder is visible in the guest.\\n- The write token is retrieved only by the
      host askpass helper from macOS Keychain.\\n- The privileged push process uses an empty
      environment, temporary home, no system/global Git config, no custom hooks, no SSH agent, and
      no ambient GitHub token.\\n- Push authorization requires both host-write workspace metadata
      and the host write credential.\\n- Remove revokes host-write metadata before secret and
      Keychain cleanup, so cleanup failures cannot leave pushes authorized.\\n- Failed setup
      rollback restores old metadata only after all credential operations succeed; any rollback
      failure leaves the metadata gate absent.\\n- Failed rollback secret cleanup stops and
      quarantines the workspace; normal start, restart, and exec paths refuse the quarantined
      workspace.\\n- Setup writes and retains a quarantine marker before credential mutation, and
      clears it only after verification or a fully successful rollback.\\n- Git bundles are verified
      and checked against the exact guest commit before push.\\n- Git LFS object IDs, file types,
      and SHA-256 contents are verified on the host.\\n- GitHub setup and restore are transactional
      and roll back on failure.\\n- Keychain deletion accepts only an explicit missing-item result
      or confirmed removal; other failures abort the transaction.\\n- Normal Docker cleanup never
      deletes volumes unless explicitly requested.\\n- Backups exclude macOS Keychain tokens and
      remove partial output on failure.\\n\\n## Environment boundaries\\n\\n### Portable simulator
      coverage\\n\\nThe portable simulator suite cannot instantiate Apple's Virtualization
      framework, alter macOS loopback/LaunchDaemon state, access macOS Keychain, open Ghostty/Zed,
      or contact GitHub with real credentials. It validates the packaged shell/Python behavior,
      state transitions, local Git flows, and security boundaries using simulated MicroSandbox
      state, a fake `security(1)` command, and local remotes.\\n\\n### Real macOS canary\\n\\nA real
      Apple Silicon macOS run against MicroSandbox v0.6.8 independently passed VM startup, systemd,
      Docker/containerd, SSH, GitHub connectivity, and published-port checks. The full host setup
      did not complete workspace recreation: it reached browser/loopback configuration and then
      stopped because `sudo` requires an interactive terminal and password. Rerun `./setup.sh
      --recreate-workspaces` from an interactive terminal.\\n\\n## The only checks you need to
      run\\n\\n### 1. Install\\n\\n```bash\\n./setup.sh\\n```\\n\\nThe installer ends by running
      `msw check --deep`. Continue only when it reports:\\n\\n```text\\nall live VM, Docker, SSH,
      internet, and published-port checks passed\\n```\\n\\n### 2. Configure each GitHub trust
      domain\\n\\n```bash\\nmsw github setup dev OWNER/VERIFICATION-REPO\\nmsw github setup
      playgrounds OWNER/VERIFICATION-REPO\\nmsw github setup personal
      OWNER/VERIFICATION-REPO\\n```\\n\\nEach command automatically proves against GitHub that the
      VM can read, the VM cannot push, the Mac-only path can push, and its temporary branch can be
      deleted.\\n\\nThat is the complete user-side verification set.\\n\\n## Re-running the portable
      test suite\\n\\nOptional, not required for normal
      installation:\\n\\n```bash\\n./tests/run-tests.sh\\n```\\n\\nThe suite uses temporary
