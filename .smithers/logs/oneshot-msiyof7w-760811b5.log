      '%s\\n' \"$box\"\n fi\n done\n}\n\ncmd_backup() {\n local
      destination=\"${1:-$MSW_BACKUP_DIR}\" stamp archive partial checksum info temp running_file
      box rel home_real\n require_command_path gtar \"$GTAR_BIN\"\n require_command_path zstd
      \"$ZSTD_BIN\"\n require_command_path shasum \"$SHASUM_BIN\"\n\n mkdir -p \"$destination\"\n
      destination=\"$(cd \"$destination\" && pwd -P)\"\n home_real=\"$(cd \"$HOME\" && pwd -P)\"\n
      case \"$destination/\" in\n
      \"$home_real/.microsandbox/\"*|\"$home_real/.config/msw/\"*|\"$home_real/.local/share/msw/\"*)
      \n fatal \"backup destination may not be inside managed state\"\n ;;\n esac\n\n stamp=\"$(date
      +%Y%m%d-%H%M%S)\"\n archive=\"$destination/microsandbox-all-$stamp.tar.zst\"\n
      partial=\"$archive.partial\"\n checksum=\"$archive.sha256\"\n info=\"$archive.info.txt\"\n
      temp=\"$(mktemp -d \"${TMPDIR:-/tmp}/msw-backup.XXXXXX\")\"\n running_file=\"$temp/running\"\n
      running_workspaces >\"$running_file\"\n\n (\n cleanup_backup() {\n local rc=$? running_box\n
      rm -f \"$partial\"\n if (( rc != 0 )); then rm -f \"$archive\" \"$checksum\" \"$info\"; fi\n
      while IFS= read -r running_box; do\n [[ -n \"$running_box\" ]] || continue\n if ! \"$MSB_BIN\"
      ping -q \"$running_box\" >/dev/null 2>&1; then\n start_sandbox \"$running_box\" >/dev/null
      2>&1 || warn \"could not restart $running_box after backup\"\n fi\n done <\"$running_file\"\n
      rm -rf \"$temp\"\n return \"$rc\"\n }\n trap cleanup_backup EXIT\n trap 'exit 130' INT\n trap
      'exit 143' TERM HUP\n\n note \"Flushing and stopping managed workspaces\"\n while IFS= read -r
      box; do\n [[ -n \"$box\" ]] || continue\n guest_exec \"$box\" sync >/dev/null\n \"$MSB_BIN\"
      stop -q -t 120 \"$box\"\n done <\"$running_file\"\n sync\n\n local -a paths=()\n while IFS=
      read -r rel; do\n [[ -n \"$rel\" ]] || continue\n if [[ -e \"$HOME/$rel\" || -L \"$HOME/$rel\"
