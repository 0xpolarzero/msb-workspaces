      \\\"$stale\\\" ]] || return 1\\n if ! mv \\\"$lock\\\" \\\"$stale\\\" 2>/dev/null; then return
      1; fi\\n moved_owner=\\\"$(cat \\\"$stale/pid\\\" 2>/dev/null || true)\\\"\\n if [[
      \\\"$moved_owner\\\" =~ ^[0-9]+$ ]] && kill -0 \\\"$moved_owner\\\" 2>/dev/null; then\\n if [[
