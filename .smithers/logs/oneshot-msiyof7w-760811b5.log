      \\\"$lock\\\" || fatal \\\"GitHub operation already in progress for workspace '$box'\\\"\\n
      fi\\n if ! exec 9>>\\\"$lock\\\"; then return 1; fi\\n if ! \\\"$LOCKF_BIN\\\" -s -t 0 9;
      then\\n exec 9>&-\\n fatal \\\"GitHub operation already in progress for workspace
      '$box'\\\"\\n fi\\n if ! printf '%s\\\\n' \\\"$$\\\" >\\\"$lock\\\"; then\\n exec 9>&-\\n
