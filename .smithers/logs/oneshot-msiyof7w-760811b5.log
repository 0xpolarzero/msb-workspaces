      fatal \"backup contains a duplicate archive member: $duplicate\"\n\n for required in \\\n
      .microsandbox \\\n .config/msw \\\n .local/bin/msw \\\n .local/bin/msw-ssh-proxy \\\n
      .local/libexec/msw-git-askpass \\\n .local/share/msw \\\n .ssh/msw_ed25519 \\\n
      .ssh/msw_ed25519.pub \\\n .ssh/config.d/msw.conf\n do\n grep -Fqx -- \"$required\"
      \"$listing\" || grep -Fqx -- \"$required/\" \"$listing\" || \\\n fatal \"backup is incomplete;
      missing $required\"\n done\n}\n\nvalidate_staged_backup() {\n local stage=\"$1\" link target\n
      if find \"$stage\" \\( -type b -o -type c -o -type p -o -type s \\) -print -quit | grep -q .;
      then\n fatal \"backup contains a device, FIFO, or socket\"\n fi\n # Absolute symlinks in
      managed state are unnecessary for this setup and can\n # unexpectedly escape the restored tree
      when followed later.\n while IFS= read -r -d '' link; do\n target=\"$(readlink \"$link\")\"\n
      [[ \"$target\" != /* ]] || fatal \"backup contains an absolute symlink: ${link#$stage/}\"\n
      done < <(find \"$stage\" -type l -print0)\n}\n\nrestore_state_health() {\n \"$MSB_BIN\"
      snapshot reindex >/dev/null\n \"$MSB_BIN\" doctor >/dev/null\n snapshot_exists
      \"$MSW_BASE_SNAPSHOT\" || return 1\n local box\n for box in \"${WORKSPACES[@]}\"; do\n
      sandbox_exists \"$box\" || return 1\n volume_exists \"$(workspace_volume \"$box\" workspace)\"
      || return 1\n volume_exists \"$(workspace_volume \"$box\" runtime)\" || return 1\n
