      \\\"$GITHUB_META_DIR\\\" || return 1\\n umask 077 || return 1\\n printf '%s\\\\n'
      \\\"$reason\\\" >\\\"$file\\\" || return 1\\n if sandbox_inspect_state \\\"$box\\\"; then\\n
      :\\n else\\n inspect_rc=$?\\n if (( inspect_rc == 1 )); then return 0; fi\\n printf 'msw:
