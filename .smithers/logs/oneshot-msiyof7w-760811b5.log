      OWNER/REPO\\\"\\n}\\n\\nsandbox_running() {\\n local box=\\\"$1\\\" status\\n
      status=\\\"$(\\\"$MSB_BIN\\\" status \\\"$box\\\" --format json 2>/dev/null)\\\" || return
      2\\n status=\\\"$(printf '%s' \\\"$status\\\" | tr -d '[:space:]')\\\"\\n case \\\"$status\\\"
      in\\n *'\\\"status\\\":\\\"Running\\\"'*) return 0 ;;\\n *'\\\"status\\\":\\\"Stopped\\\"'*)
      return 1 ;;\\n *) return 2 ;;\\n esac\\n}\\n\\nquarantine_workspace()
      {\\nquarantine_workspace() {\\n local box=\\\"$1\\\" reason=\\\"${2:-GitHub credential cleanup
