      \\\"${MSW_ALLOW_QUARANTINED:-0}\\\" == 1 ]] && return 0\\n file=\\\"$(quarantine_file
      \\\"$box\\\")\\\"\\n [[ ! -e \\\"$file\\\" && ! -L \\\"$file\\\" ]] || fatal \\\"workspace
