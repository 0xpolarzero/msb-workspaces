      return 1\\n fi\\n if ! \\\"$MSB_BIN\\\" stop -q -t 60 \\\"$box\\\" >/dev/null 2>&1; then
      stop_failed=1; fi\\n while (( attempt < 5 )); do\\n if sandbox_running \\\"$box\\\"; then\\n
      :\\n else\\n running_rc=$?\\n if (( running_rc == 1 )); then return 0; fi\\n fi\\n
      attempt=$((attempt + 1))\\n if (( attempt < 5 )); then sleep 1; fi\\n done\\n if ((
      stop_failed )); then\\n printf 'msw: could not stop quarantined workspace %s\\\\n'
