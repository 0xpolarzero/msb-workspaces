      y|.local/libexec/msw-git-askpass|.local/share/msw|.local/share/msw/*|.ssh/msw_ed25519|.ssh/msw
      _ed25519.pub|.ssh/config.d/msw.conf)\n return 0\n ;;\n *) return 1 ;;\n
