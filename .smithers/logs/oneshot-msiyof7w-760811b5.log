      \\\"$1\\\")\\\"\\n [[ -f \\\"$file\\\" ]] || return 1\\n sed -n 's/^access=//p' \\\"$file\\\"
      | head -n 1\\n}\\n\\nmetadata_repo() {\\n local file\\n file=\\\"$(metadata_file
      \\\"$1\\\")\\\"\\n [[ -f \\\"$file\\\" ]] || return 1\\n sed -n 's/^verification_repo=//p'
      \\\"$file\\\" | head -n 1\\n}\\n\\nwrite_metadata() {\\n local box=\\\"$1\\\" repo=\\\"$2\\\"
