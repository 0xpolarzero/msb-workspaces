      exited $status}\\\" >&2\\n return 1\\n fi\\n if error=\\\"$(\\\"$SECURITY_BIN\\\"
      find-generic-password -w -s \\\"$service\\\" -a \\\"$account\\\" 2>&1)\\\"; then\\n printf
