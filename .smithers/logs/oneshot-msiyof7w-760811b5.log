      output=\\\"$(\\\"$MSB_BIN\\\" inspect \\\"$box\\\" 2>&1)\\\"; then return 0; fi\\n [[
      \\\"$output\\\" == *\\\"sandbox not found\\\"* ]] && return 1\\n return
      2\\n}\\nsnapshot_exists() { \\\"$MSB_BIN\\\" snapshot inspect \\\"$1\\\" >/dev/null 2>&1;
      }\\nvolume_exists() { \\\"$MSB_BIN\\\" volume inspect \\\"$1\\\" >/dev/null 2>&1;
      }\\nquarantine_file() { printf '%s/%s.quarantine\\\\n' \\\"$GITHUB_META_DIR\\\" \\\"$1\\\";
      }\\ngithub_lock_file() { printf '%s/%s.lock\\\\n' \\\"$GITHUB_META_DIR\\\" \\\"$1\\\";
      }\\ngithub_lock_reclaim_legacy() {\\n local lock=\\\"$1\\\" owner=\\\"\\\"
      moved_owner=\\\"\\\" stale=\\\"${lock}.legacy.$$.$RANDOM\\\"\\n if [[ -f \\\"$lock/pid\\\" ]];
