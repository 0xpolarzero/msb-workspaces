      \\\"$@\\\"\\n}\\n\\ncmd_exec() {\\n local box=\\\"$1\\\"; shift\\n validate_workspace
      \\\"$box\\\"\\n (( $# > 0 )) || fatal \\\"usage: msw exec WORKSPACE COMMAND [ARG ...]\\\"\\n
      guest_exec_w \\\"$box\\\" /workspace \\\"$@\\\"\\n}\\n\\ncmd_disk() {\\n local
