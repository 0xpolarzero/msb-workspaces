      ping -q \\\"$box\\\" >/dev/null 2>&1; then\\n [[ -n \\\"$output\\\" ]] && printf '%s\\\\n'
      \\\"$output\\\" >&2\\n fatal \\\"workspace '$box' could not start; run 'msw logs $box'\\\"\\n
      fi\\n fi\\n until \\\"$MSB_BIN\\\" ping -q \\\"$box\\\" >/dev/null 2>&1; do\\n
      attempt=$((attempt + 1))\\n (( attempt < 120 )) || fatal \\\"workspace '$box' did not become
      ready\\\"\\n sleep 1\\n done\\n wait_for_guest_systemd \\\"$box\\\"\\n}\\n\\nguest_exec() {\\n
      local box=\\\"$1\\\"; shift\\n ensure_running \\\"$box\\\"\\n \\\"$MSB_BIN\\\" exec --no-tty
      \\\"$box\\\" -- \\\"$@\\\"\\n}\\n\\nguest_exec_w() {\\n local box=\\\"$1\\\"
      workdir=\\\"$2\\\"; shift 2\\n ensure_running \\\"$box\\\"\\n \\\"$MSB_BIN\\\" exec --no-tty
      -w \\\"$workdir\\\" \\\"$box\\\" -- \\\"$@\\\"\\n}\\n\\nguest_script() {\\n local
      box=\\\"$1\\\" script=\\\"$2\\\"; shift 2\\n ensure_running \\\"$box\\\"\\n printf '%s\\\\n'
      \\\"$script\\\" | \\\"$MSB_BIN\\\" exec --no-tty \\\"$box\\\" -- bash -s --
      \\\"$@\\\"\\n}\\n\\nvalidate_relative_path() {\\n local path=\\\"${1:-}\\\" component\\n [[ -n
      \\\"$path\\\" ]] || fatal \\\"path cannot be empty\\\"\\n [[ \\\"$path\\\" != /* ]] || fatal
      \\\"path must be relative to /workspace\\\"\\n [[ \\\"$path\\\" != *$'\\\\n'* && \\\"$path\\\"
      != *$'\\\\r'* && \\\"$path\\\" != *$'\\\\t'* ]] || fatal \\\"path contains a control
