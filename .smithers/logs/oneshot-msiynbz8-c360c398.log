      cpus=\\\"${3:-}\\\"\\n validate_workspace \\\"$box\\\"\\n [[ -n \\\"$memory\\\" ]] || fatal
      \\\"usage: msw resize WORKSPACE MEMORY [CPUS]\\\"\\n if [[ -n \\\"$cpus\\\" ]]; then
