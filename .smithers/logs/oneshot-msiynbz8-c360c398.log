      -eu\\n\\nhost=\\\"${1:?missing SSH host alias}\\\"\\nbox=\\\"${host%.msb}\\\"\\ncase
      \\\"$box\\\" in dev|playgrounds|personal) ;; *) echo \\\"msw: unknown workspace '$box'\\\"
      >&2; exit 64 ;; esac\\n\\nconfig=\\\"${MSW_CONFIG_FILE:-$HOME/.config/msw/config.sh}\\\"\\n[
      -f \\\"$config\\\" ] || { echo \\\"msw: configuration missing; rerun setup.sh\\\" >&2; exit 1;
      }\\n\\nMSB=\\\"${MSW_MSB_BIN:-$HOME/.local/bin/msb}\\\"\\nif [ ! -x \\\"$MSB\\\" ]; then
      MSB=\\\"$(command -v msb 2>/dev/null || true)\\\"; fi\\n[ -n \\\"$MSB\\\" ] && [ -x
      \\\"$MSB\\\" ] || { echo \\\"msw: msb was not found; rerun setup.sh\\\" >&2; exit 127;
      }\\n\\nkeychain_read() {\\n if [ -n \\\"${MSW_TEST_KEYCHAIN_DIR:-}\\\" ]; then\\n
      safe_service=$(printf '%s' msw.github.read | tr -c 'A-Za-z0-9_.-' '_')\\n
      safe_account=$(printf '%s' \\\"$box\\\" | tr -c 'A-Za-z0-9_.-' '_')\\n
      file=\\\"$MSW_TEST_KEYCHAIN_DIR/${safe_service}__${safe_account}\\\"\\n [ -f \\\"$file\\\" ]
      || return 1\\n cat \\\"$file\\\"\\n else\\n /usr/bin/security find-generic-password -w -s
      msw.github.read -a \\\"$box\\\" 2>/dev/null\\n fi\\n}\\n\\nif ! \\\"$MSB\\\" ping -q
      \\\"$box\\\" >/dev/null 2>&1; then\\n token=[REDACTED_SECRET]\"\\\"\\n if
      token=[REDACTED_SECRET]\"$(keychain_read 2>/dev/null)\\\"; then\\n if !
      output=\\\"$(GH_TOKEN=[REDACTED_SECRET]\"$token\\\" \\\"$MSB\\\" start -q \\\"$box\\\"
      2>&1)\\\"; then\\n sleep 1\\n \\\"$MSB\\\" ping -q \\\"$box\\\" >/dev/null 2>&1 || { [ -n
      \\\"$output\\\" ] && echo \\\"$output\\\" >&2; exit 1; }\\n fi\\n unset token\\n else\\n if [
      -f \\\"$HOME/.config/msw/github/$box.conf\\\" ]; then\\n echo \\\"msw: GitHub is configured
      for '$box', but its read token is missing from Keychain\\\" >&2\\n echo \\\"run: msw github
      setup $box OWNER/REPO\\\" >&2\\n exit 1\\n fi\\n if ! output=\\\"$(\\\"$MSB\\\" start -q
      \\\"$box\\\" 2>&1)\\\"; then\\n sleep 1\\n \\\"$MSB\\\" ping -q \\\"$box\\\" >/dev/null 2>&1
      || { [ -n \\\"$output\\\" ] && echo \\\"$output\\\" >&2; exit 1; }\\n fi\\n fi\\n\\n
      attempt=0\\n until \\\"$MSB\\\" ping -q \\\"$box\\\" >/dev/null 2>&1; do\\n attempt=$((attempt
      + 1))\\n if [ \\\"$attempt\\\" -ge 120 ]; then\\n echo \\\"msw: '$box' did not become
      ready\\\" >&2\\n \\\"$MSB\\\" logs \\\"$box\\\" --source system --tail 50 2>/dev/null ||
