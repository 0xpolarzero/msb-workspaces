      --show-toplevel 2>/dev/null)\\\" || { echo \\\"not a Git repository: $relative\\\" >&2; exit
      4; }\\ncase \\\"$repo\\\" in\\n \\\"$root\\\"|\\\"$root\\\"/*) ;;\\n *) echo \\\"Git
      repository escapes /workspace\\\" >&2; exit 5 ;;\\nesac\\nprintf '%s\\\\n'
      \\\"$repo\\\"\\nSCRIPT\\n guest_script \\\"$box\\\" \\\"$script\\\"
      \\\"$relative\\\"\\n}\\n\\nexpand_ports() {\\n local token start end p old_ifs=\\\"$IFS\\\"\\n
