      '%s\\\\n' \\\"$p\\\"; done\\n else\\n printf '%s\\\\n' \\\"$token\\\"\\n fi\\n done\\n
      IFS=\\\"$old_ifs\\\"\\n}\\n\\nport_is_published() {\\n local wanted=\\\"$1\\\" p\\n while IFS=
      read -r p; do [[ \\\"$p\\\" == \\\"$wanted\\\" ]] && return 0; done < <(expand_ports)\\n
      return 1\\n}\\n\\nvalidate_port() {\\n local port=\\\"${1:-}\\\" label=\\\"${2:-port}\\\"
      numeric\\n [[ \\\"$port\\\" =~ ^[0-9]+$ ]] || fatal \\\"$label must be an integer from 1 to
