      \\\"$MSB_BIN\\\" self update\\n fi\\n \\\"$MSB_BIN\\\" doctor\\n}\\n\\ncmd_tunnel() {\\n local
      box=\\\"$1\\\" remote_port=\\\"${2:-}\\\" local_port=\\\"${3:-$remote_port}\\\"\\n
