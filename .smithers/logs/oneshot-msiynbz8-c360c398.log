      printf '/workspace\\\\n'\\n else\\n validate_relative_path \\\"$requested\\\"\\n printf
      '/workspace/%s\\\\n' \\\"$requested\\\"\\n fi\\n}\\n\\nresolve_guest_repo() {\\n local
      box=\\\"$1\\\" relative=\\\"$2\\\"\\n validate_workspace \\\"$box\\\"\\n
