      \\\"$box\\\"\\n\\ncmd_docs() {\\n local topic=\\\"${1:-cheatsheet}\\\" file pager\\n case
      \\\"$topic\\\" in\\n cheatsheet|commands) file=\\\"$MSW_DOCS_DIR/MSW-CHEATSHEET.md\\\" ;;\\n
