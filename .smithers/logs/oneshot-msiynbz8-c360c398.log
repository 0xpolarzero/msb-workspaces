      scheme=\\\"${3:-http}\\\"\\n validate_workspace \\\"$box\\\"\\n validate_port \\\"$port\\\"
      port\\n [[ \\\"$scheme\\\" == http || \\\"$scheme\\\" == https ]] || fatal \\\"scheme must be
