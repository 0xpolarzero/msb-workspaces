      \"Configuring SSH for Ghostty and Zed\"\n mkdir -p \"$HOME/.ssh/config.d\"
      \"$HOME/.microsandbox/ssh\"\n chmod 700 \"$HOME/.ssh\" \"$HOME/.ssh/config.d\"\n if [[ ! -f
      \"$HOME/.ssh/msw_ed25519\" ]]; then\n ssh-keygen -t ed25519 -f \"$HOME/.ssh/msw_ed25519\" -N
      '' -C microsandbox-workspaces\n fi\n chmod 600 \"$HOME/.ssh/msw_ed25519\"\n chmod 644
      \"$HOME/.ssh/msw_ed25519.pub\"\n local public_key authorized\n public_key=\"$(cat
      \"$HOME/.ssh/msw_ed25519.pub\")\"\n authorized=\"$HOME/.microsandbox/ssh/authorized_keys\"\n
      if [[ ! -f \"$authorized\" ]] || ! grep -qxF \"$public_key\" \"$authorized\"; then\n
      \"$MSB_BIN\" ssh authorize --file \"$HOME/.ssh/msw_ed25519.pub\"\n fi\n cat
      >\"$HOME/.ssh/config.d/msw.conf\" <<SSH\nHost dev.msb playgrounds.msb personal.msb\n User
