      $HOME/.local/bin/msw-ssh-proxy %h\n ServerAliveInterval 30\n ServerAliveCountMax 3\n
      StrictHostKeyChecking accept-new\n SetEnv TERM=xterm-256color\nSSH\n chmod 600
      \"$HOME/.ssh/config.d/msw.conf\"\n touch \"$HOME/.ssh/config\"; chmod 600
