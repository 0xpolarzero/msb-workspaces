      pipefail\\nrelative=\\\"$1\\\"\\nroot=\\\"${MSW_GUEST_WORKSPACE_ROOT:-/workspace}\\\"\\ncandid
      ate=\\\"$root/$relative\\\"\\nresolved=\\\"$(realpath -- \\\"$candidate\\\")\\\" || { echo
