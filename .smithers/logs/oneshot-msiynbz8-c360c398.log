      \\\"$box\\\"\\n fi\\n done < <(for_targets \\\"$target\\\")\\n}\\n\\ncmd_status() {\\n
      \\\"$MSB_BIN\\\" ps -a --label msw.managed=true\\n echo\\n cmd_ports
