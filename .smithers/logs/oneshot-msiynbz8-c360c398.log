      \\\"$(workspace_host \\\"$box\\\")\\\" \\\"$port\\\"\\n}\\n\\ncmd_open() {\\n local
      box=\\\"$1\\\" port=\\\"${2:-3000}\\\" scheme=\\\"${3:-http}\\\" url\\n ensure_running
      \\\"$box\\\"\\n url=\\\"$(cmd_url \\\"$box\\\" \\\"$port\\\" \\\"$scheme\\\")\\\"\\n note
      \\\"Opening $url\\\"\\n \\\"$OPEN_BIN\\\" \\\"$url\\\"\\n}\\n\\ncmd_ports() {\\n local
      target=\\\"${1:-all}\\\" box\\n printf 'Published TCP ports\\\\n %s\\\\n\\\\n'
      \\\"$MSW_PUBLISHED_PORTS\\\"\\n for box in $(for_targets \\\"$target\\\"); do\\n printf '%-12s
      %s\\\\n' \\\"$box\\\" \\\"http://$(workspace_host \\\"$box\\\"):<port>\\\"\\n done\\n cat
      <<'MSG'\\n\\nExamples\\n http://dev.msw.test:3000\\n http://playgrounds.msw.test:5173\\n
      http://personal.msw.test:8080\\n\\nThe service inside the VM must listen on
      0.0.0.0.\\nMSG\\n}\\n\\ncmd_start() {\\n local target=\\\"${1:-all}\\\" box\\n while IFS= read
      -r box; do ensure_running \\\"$box\\\"; echo \\\"$box: running\\\"; done < <(for_targets
      \\\"$target\\\")\\n}\\n\\ncmd_stop() {\\n local target=\\\"${1:-all}\\\" box\\n while IFS=
      read -r box; do\\n if sandbox_exists \\\"$box\\\" && \\\"$MSB_BIN\\\" ping -q \\\"$box\\\"
      >/dev/null 2>&1; then\\n note \\\"Stopping $box\\\"\\n \\\"$MSB_BIN\\\" stop -q -t 60
      \\\"$box\\\"\\n else\\n echo \\\"$box: already stopped\\\"\\n fi\\n done < <(for_targets
      \\\"$target\\\")\\n}\\n\\ncmd_restart() {\\n local target=\\\"${1:-all}\\\" box
      token=[REDACTED_SECRET]\"\\\"\\n while IFS= read -r box; do\\n sandbox_exists \\\"$box\\\" ||
      fatal \\\"workspace '$box' does not exist\\\"\\n assert_not_quarantined \\\"$box\\\"\\n note
