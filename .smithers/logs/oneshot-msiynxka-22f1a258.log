      \"MSW_FAKE_VERIFY_PAUSE_FILE\": str(pause_file),\n \"MSW_FAKE_VERIFY_PAUSE_ONCE\": \"1\",\n
      }\n )\n proc = subprocess.Popen(\n [str(self.env.msw_bin), \"github\", \"setup\", \"dev\",
      \"acme/demo\"],\n env=env,\n text=True,\n stdout=subprocess.DEVNULL,\n
      stderr=subprocess.DEVNULL,\n start_new_session=True,\n )\n try:\n for _ in range(100):\n if
