      \\\"link\\\", \\\"--yes\\\", check=False), \\\"escapes /workspace\\\")\\n\\n\\nclass
      GitHubAndPushTests(MSWTestCase):\\n def prepare(self, *, box: str = \\\"dev\\\", nested: str =
      \\\"clients/acme/demo\\\") -> tuple[Path, Path]:\\n bare = self.env.init_remote()\\n
      self.env.configure_tokens(box, \\\"acme/demo\\\")\\n self.env.msw(\\\"clone\\\", box,
      \\\"acme/demo\\\", nested)\\n repo = self.env.guest_repo(box, nested)\\n self.env.git(repo,
      \\\"config\\\", \\\"user.name\\\", \\\"Agent\\\")\\n self.env.git(repo, \\\"config\\\",
      \\\"user.email\\\", \\\"agent@example.invalid\\\")\\n return bare, repo\\n\\n def
      test_github_setup_end_to_end_secret_hidden_and_remove(self) -> None:\\n bare =
