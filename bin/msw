  msw app url|clone|pull|identity|disk|resize|clean|upgrade|update
  msw app check|backup-preview|backup|restore|push-plan|plan|apply|bootstrap|help
HELP
}

# Machine-readable integration boundary for MSW Monitor. Observation commands
# never call ensure_running; only explicit, confirmed mutation commands may start.
app_json_escape() {
  local value="${1-}" escaped="" char code index
  LC_ALL=C
  for ((index = 0; index < ${#value}; index++)); do
    char="${value:index:1}"
    case "$char" in
      '"') escaped="${escaped}\\\"" ;;
      "\\") escaped="${escaped}\\\\\\" ;;
      $'\n') escaped="${escaped}\\n" ;;
      $'\r') escaped="${escaped}\\r" ;;
      $'\t') escaped="${escaped}\\t" ;;
      *)
        printf -v code '%d' "'$char"
        if (( code < 32 )); then
          printf -v char '\\u%04x' "$code"
        fi
        escaped="${escaped}${char}"
        ;;
    esac
  done
  printf '%s' "$escaped"
}

app_json_string() {
  printf '"'
  app_json_escape "${1-}"
  printf '"'
}

app_json_optional() {
  if [[ -n "${1-}" ]]; then
    app_json_string "$1"
  else
    printf 'null'
  fi
}

app_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

app_request_id() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr -d '\n'
  else
    printf '%s-%s-%s' "$(date +%s)" "$$" "$RANDOM"
  fi
}

app_emit_success() {
  local command="$1" result warnings observed_at
  result="${2-}"
  [[ -n "$result" ]] || result='{}'
  warnings="${3-}"
  [[ -n "$warnings" ]] || warnings='[]'
  observed_at="${4-}"
  [[ -n "$observed_at" ]] || observed_at="$(app_now)"
  MSW_APP_RESPONSE_EMITTED=1
  printf '{"schemaVersion":1,"requestId":%s,"ok":true,"command":%s,"observedAt":%s,"result":%s,"warnings":%s}\n' \
    "$(app_json_string "${MSW_APP_REQUEST_ID:-$(app_request_id)}")" \
    "$(app_json_string "$command")" \
    "$(app_json_string "$observed_at")" \
    "$result" "$warnings"
}

app_emit_error() {
  local command="$1" code="$2" message="$3" recovery="$4" workspace="${5:-}" retryable="${6:-false}" exit_code="${7:-1}"
  MSW_APP_RESPONSE_EMITTED=1
  printf '{"schemaVersion":1,"requestId":%s,"ok":false,"command":%s,"error":{"code":%s,"message":%s,"recovery":%s,"workspace":%s,"retryable":%s},"warnings":[]}\n' \
    "$(app_json_string "${MSW_APP_REQUEST_ID:-$(app_request_id)}")" \
    "$(app_json_string "$command")" \
    "$(app_json_string "$code")" \
    "$(app_json_string "$message")" \
    "$(app_json_string "$recovery")" \
    "$(app_json_optional "$workspace")" \
    "$retryable"
  return "$exit_code"
}

app_unexpected_error() {
  local status="$?"
  if [[ "${BASH_SUBSHELL:-0}" != "$MSW_APP_ROOT_SUBSHELL" ]]; then
    return "$status"
  fi
  trap - ERR
  if [[ "$MSW_APP_RESPONSE_EMITTED" != 1 ]]; then
    app_emit_error "$MSW_APP_COMMAND" "MSW_INTERNAL_ERROR" \
      "MSW could not complete the machine-readable operation." \
      "Retry after checking the MSW configuration and runtime diagnostics." "" true 1 || true
  fi
  exit "$status"
}

app_usage_error() {
  local command="$1"
  app_emit_error "$command" "MSW_INVALID_REQUEST" \
    "The requested MSW Monitor command has invalid arguments." \
    "See 'msw app help' for the typed command contract." "" false 64
}

app_require_config() {
  local command="$1"
  (( MSW_CONFIG_AVAILABLE == 1 )) || app_emit_error "$command" "MSW_CONFIG_MISSING" \
    "MSW configuration is not installed." "Run Setup in MSW Monitor." "" false 78
}

app_require_runtime() {
  local command="$1"
  [[ -n "${MSB_BIN:-}" && -x "${MSB_BIN:-}" ]] || app_emit_error "$command" "MSW_RUNTIME_UNAVAILABLE" \
    "The MicroSandbox runtime is unavailable." "Repair the MSW toolchain in MSW Monitor." "" true 69
}

app_workspace_purpose() {
  case "$1" in
    dev) printf 'Primary software development workspace' ;;
    playgrounds) printf 'Experiments and disposable prototypes' ;;
    personal) printf 'Personal projects and services' ;;
    *) printf 'Configured MSW workspace' ;;
  esac
}

app_workspace_resource() {
  local box="$1" field="$2" value json_field
  case "$field" in
    CPUS) json_field=cpu ;;
    MAX_CPUS) json_field=cpuCeiling ;;
    MEMORY) json_field=memoryGiB ;;
    MAX_MEMORY) json_field=memoryCeilingGiB ;;
    WORKSPACE_SIZE) json_field=workspaceStorageGiB ;;
    RUNTIME_SIZE) json_field=runtimeStorageGiB ;;
    *) json_field="" ;;
  esac
  [[ -n "$json_field" ]] || return 1
  value="$(workspace_configuration_value "$box" "$json_field")" || return
  case "$field" in MEMORY|MAX_MEMORY|WORKSPACE_SIZE|RUNTIME_SIZE) printf '%sG' "$value" ;; *) printf '%s' "$value" ;; esac
}

app_status_for_workspace() {
  local box="$1" raw status
  [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] || return 69
  if ! raw="$(workspace_msb "$box" status "$box" --format json 2>/dev/null)"; then
    return 69
  fi
  status="$("$JQ_BIN" -r --arg workspace "$box" '
    if type == "array" then
      ([.[] | select((.name // .id // "") == $workspace) | (.status // .lifecycle // empty)] | first) // empty
    elif type == "object" then
      if ((.name // .id // $workspace) == $workspace) then
        (.status // .lifecycle // empty)
      else empty end
    else empty
    end
  ' <<<"$raw" 2>/dev/null)" || return 78
  [[ -n "$status" && "$status" != null ]] || return 78
  case "$status" in
    Running|running) printf 'Running' ;;
    Starting|starting) printf 'Starting' ;;
    Stopping|stopping) printf 'Stopping' ;;
    Restarting|restarting) printf 'Restarting' ;;
    Stopped|stopped) printf 'Stopped' ;;
    Exited|exited) printf 'Exited' ;;
    *) printf 'Unknown' ;;
  esac
}

app_workspace_quarantined() {
  local box="$1" file role
  file="$(quarantine_file "$box")"
  [[ -e "$file" || -L "$file" ]] && return 0
  for role in guest host; do
    if app_metadata_profile_present "$box" "$role" &&
      [[ "$(app_metadata_value "$box" "$role" quarantined 2>/dev/null || true)" == true ]]; then
      return 0
    fi
  done
  return 1
}

app_timestamp_epoch() {
  local value="${1-}"
  [[ -n "$value" ]] || return 1
  date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$value" +%s 2>/dev/null ||
    date -u -d "$value" +%s 2>/dev/null
}

app_profile_expiry_state() {
  local box="$1" role="$2" access now soon access_epoch
  access="$(app_metadata_value "$box" "$role" accessExpiresAt 2>/dev/null || true)"
  [[ -n "$access" ]] || return 1
  access_epoch="$(app_timestamp_epoch "$access")" || return 1
  now="$(date +%s)"
  soon=$((now + 3600))
  if (( access_epoch <= now )); then
    printf 'authorization-required'
  elif (( access_epoch <= soon )); then
    printf 'expiring'
  else
    printf 'valid'
  fi
}

app_workspace_credential_state() {
  local box="$1" access needs_restart host_needs_restart guest_expiry host_expiry recovery_state host_recovery_state
  if [[ "$MSW_GITHUB_MODE" == local ]]; then
    # §8: host push is allowed for every ticked repo in both modes, so the
    # local credential state is Ready exactly when the host credential exists.
    if app_workspace_quarantined "$box"; then
      printf 'Quarantined'
    elif ! policy_validate; then
      printf 'Unconfigured'
    elif host_credential_available; then
      printf 'Ready'
    else
      printf 'Needs authorization'
    fi
    return
  fi
  if app_workspace_quarantined "$box"; then
    printf 'Quarantined'
  elif app_metadata_profile_present "$box" guest; then
    recovery_state="$(app_metadata_value "$box" guest recoveryState 2>/dev/null || true)"
    if [[ -n "$recovery_state" && "$recovery_state" != ready ]]; then
      case "$recovery_state" in
        serviceUnavailable) printf 'Service unavailable' ;;
        revoked|expired|installationRemoved|migrationRequired|quarantined) printf 'Needs authorization' ;;
        *) printf 'Needs authorization' ;;
      esac
      return
    fi
    access="$(metadata_access "$box" 2>/dev/null || true)"
    needs_restart="$(app_metadata_value "$box" guest needsRestart 2>/dev/null || true)"
    guest_expiry="$(app_profile_expiry_state "$box" guest 2>/dev/null || true)"
    if ! app_credential_available "$box" guest || [[ -z "$guest_expiry" ]]; then
      printf 'Needs authorization'
      return
    fi
    if [[ "$access" == host-write ]]; then
      host_needs_restart="$(app_metadata_value "$box" host needsRestart 2>/dev/null || true)"
      host_recovery_state="$(app_metadata_value "$box" host recoveryState 2>/dev/null || true)"
      if [[ -n "$host_recovery_state" && "$host_recovery_state" != ready ]]; then
        case "$host_recovery_state" in
          serviceUnavailable) printf 'Service unavailable' ;;
          *) printf 'Needs authorization' ;;
        esac
        return
      fi
      host_expiry="$(app_profile_expiry_state "$box" host 2>/dev/null || true)"
      if ! app_metadata_profile_present "$box" host ||
        ! app_credential_available "$box" host || [[ -z "$host_expiry" ]]; then
        printf 'Needs authorization'
        return
      fi
      if [[ "$guest_expiry" == authorization-required || "$host_expiry" == authorization-required ]]; then
        printf 'Needs authorization'
      elif [[ "$guest_expiry" == expiring || "$host_expiry" == expiring ]]; then
        printf 'Expiring'
      elif [[ "$needs_restart" == true || "$host_needs_restart" == true ]]; then
        printf 'Needs restart'
      else
        printf 'Ready'
      fi
    elif [[ "$access" == read-only ]]; then
      if [[ "$guest_expiry" == authorization-required ]]; then
        printf 'Needs authorization'
      elif [[ "$guest_expiry" == expiring ]]; then
        printf 'Expiring'
      elif [[ "$needs_restart" == true ]]; then
        printf 'Needs restart'
      else
        printf 'Read-only'
      fi
    else
      printf 'Needs authorization'
    fi
  elif [[ ! -f "$(metadata_file "$box")" ]]; then
    printf 'Unconfigured'
  else
    access="$(metadata_access "$box" 2>/dev/null || true)"
    if [[ "$access" == host-write ]]; then
      if keychain_has "$READ_KEYCHAIN_SERVICE" "$box" && keychain_has "$WRITE_KEYCHAIN_SERVICE" "$box"; then
        printf 'Ready'
      else
        printf 'Needs authorization'
      fi
    elif [[ "$access" == read-only ]]; then
      if keychain_has "$READ_KEYCHAIN_SERVICE" "$box"; then
        printf 'Read-only'
      else
        printf 'Needs authorization'
      fi
    else
      printf 'Needs authorization'
    fi
  fi
}

app_workspace_json() {
  local box="$1" lifecycle="${2:-Unknown}" freshness="${3:-unavailable}" status_observed_at="${4:-}" quarantine="clear"
  local metrics_observed_at="" github_observed_at="" activity_observed_at=""
  local credential purpose host ip cpus max_cpus memory max_memory root_disk verification_repo access
  local account_login installation_id access_expires refresh_expires needs_restart host_needs_restart quarantine_reason role
  local skipped_ports_json port_warning
  if app_workspace_quarantined "$box"; then
    quarantine="quarantined"
    if [[ -f "$(quarantine_file "$box")" && ! -L "$(quarantine_file "$box")" ]]; then
      quarantine_reason="$(sed -n '1p' "$(quarantine_file "$box")" 2>/dev/null || true)"
      quarantine_reason="$(app_redact "$quarantine_reason")"
    fi
    if [[ -z "$quarantine_reason" ]]; then
      for role in guest host; do
        if app_metadata_profile_present "$box" "$role" &&
          [[ "$(app_metadata_value "$box" "$role" quarantined 2>/dev/null || true)" == true ]]; then
          quarantine_reason="Credential repair is required for the $role authorization."
          break
        fi
      done
    fi
  fi
  purpose="$(app_workspace_purpose "$box")"
  host="$(workspace_host "$box")"
  ip="$(workspace_ip "$box")"
  cpus="$(app_workspace_resource "$box" CPUS)"
  max_cpus="$(app_workspace_resource "$box" MAX_CPUS)"
  memory="$(app_workspace_resource "$box" MEMORY)"
  max_memory="$(app_workspace_resource "$box" MAX_MEMORY)"
  root_disk="${MSW_ROOT_DISK:-}"
  credential="$(app_workspace_credential_state "$box")"
  if app_metadata_profile_present "$box" guest; then
    github_observed_at="$(app_metadata_value "$box" guest updatedAt 2>/dev/null || true)"
    verification_repo="$(app_metadata_value "$box" guest verificationRepository 2>/dev/null || true)"
    access="$(metadata_access "$box" 2>/dev/null || true)"
    account_login="$(app_metadata_value "$box" guest accountLogin 2>/dev/null || true)"
    installation_id="$(app_metadata_value "$box" guest installationID 2>/dev/null || true)"
    access_expires="$(app_metadata_value "$box" guest accessExpiresAt 2>/dev/null || true)"
    refresh_expires="$(app_metadata_value "$box" guest refreshExpiresAt 2>/dev/null || true)"
    needs_restart="$(app_metadata_value "$box" guest needsRestart 2>/dev/null || true)"
    if app_metadata_profile_present "$box" host; then
      local host_access_expires host_refresh_expires
      host_access_expires="$(app_metadata_value "$box" host accessExpiresAt 2>/dev/null || true)"
      host_refresh_expires="$(app_metadata_value "$box" host refreshExpiresAt 2>/dev/null || true)"
      [[ -n "$host_access_expires" && ( -z "$access_expires" || "$host_access_expires" < "$access_expires" ) ]] && access_expires="$host_access_expires"
      [[ -n "$host_refresh_expires" && ( -z "$refresh_expires" || "$host_refresh_expires" < "$refresh_expires" ) ]] && refresh_expires="$host_refresh_expires"
    fi
    host_needs_restart="$(app_metadata_value "$box" host needsRestart 2>/dev/null || true)"
    [[ "$host_needs_restart" == true ]] && needs_restart=true
  else
    verification_repo="$(metadata_repo "$box" 2>/dev/null || true)"
    access="$(metadata_access "$box" 2>/dev/null || true)"
    account_login=""
    installation_id=""
    access_expires=""
    refresh_expires=""
    needs_restart=false
  fi
  [[ -n "$needs_restart" ]] || needs_restart=false
  skipped_ports_json="$(workspace_state_skipped_json "$box")"
  port_warning="$(workspace_port_warning "$box")"
  printf '{"id":%s,"purpose":%s,"lifecycle":%s,"freshness":%s,"statusObservedAt":%s,"metricsObservedAt":%s,"githubObservedAt":%s,"activityObservedAt":%s,"quarantine":{"state":%s,"reason":%s},"credential":{"state":%s,"accessMode":%s,"verificationRepository":%s,"accountLogin":%s,"installationId":%s,"accessExpiresAt":%s,"refreshExpiresAt":%s,"needsRestart":%s},"resources":{"cpus":%s,"maxCpus":%s,"memory":%s,"maxMemory":%s,"rootDisk":%s},"network":{"host":%s,"ip":%s},"skippedPorts":%s,"portWarning":%s,"actionCapabilities":{"canStart":%s,"canStop":%s,"canRestart":%s,"canOpenTerminal":%s,"canPush":%s}}' \
    "$(app_json_string "$box")" \
    "$(app_json_string "$purpose")" \
    "$(app_json_string "$lifecycle")" \
    "$(app_json_string "$freshness")" \
    "$(app_json_optional "$status_observed_at")" \
    "$(app_json_optional "$metrics_observed_at")" \
    "$(app_json_optional "$github_observed_at")" \
    "$(app_json_optional "$activity_observed_at")" \
    "$(app_json_string "$quarantine")" \
    "$(app_json_optional "$quarantine_reason")" \
    "$(app_json_string "$credential")" \
    "$(app_json_string "${access:-unconfigured}")" \
    "$(app_json_optional "$verification_repo")" \
    "$(app_json_optional "$account_login")" \
    "$(app_json_optional "$installation_id")" \
    "$(app_json_optional "$access_expires")" \
    "$(app_json_optional "$refresh_expires")" \
    "$needs_restart" \
    "$(app_json_string "$cpus")" \
    "$(app_json_string "$max_cpus")" \
    "$(app_json_string "$memory")" \
    "$(app_json_string "$max_memory")" \
    "$(app_json_string "$root_disk")" \
    "$(app_json_string "$host")" \
    "$(app_json_string "$ip")" \
    "$skipped_ports_json" \
    "$(app_json_string "$port_warning")" \
    "$([[ "$quarantine" == clear && ( "$lifecycle" == Stopped || "$lifecycle" == Exited ) ]] && printf true || printf false)" \
    "$([[ "$lifecycle" == Running ]] && printf true || printf false)" \
    "$([[ "$quarantine" == clear && "$lifecycle" == Running ]] && printf true || printf false)" \
    "$([[ "$quarantine" == clear && "$lifecycle" == Running ]] && printf true || printf false)" \
    "$([[ "$quarantine" == clear && "$credential" == Ready && "$lifecycle" == Running ]] && printf true || printf false)"
}
app_valid_control_free() {
  local value="${1-}"
  [[ ! "$value" =~ [[:cntrl:]] ]]
}

app_valid_relative_path() {
  local path="${1-}" component
  [[ -n "$path" && ${#path} -le 1024 && "$path" != /* ]] || return 1
  app_valid_control_free "$path" || return 1
  [[ "$path" == "." ]] && return 0
  IFS='/' read -r -a _app_parts <<<"$path"
  for component in "${_app_parts[@]}"; do
    [[ -n "$component" && "$component" != "." && "$component" != ".." ]] || return 1
  done
}

app_valid_directory_query() {
  local query="${1-}"
  [[ -n "$query" && ${#query} -le 128 ]] || return 1
  app_valid_control_free "$query"
}

app_guest_directory_query() {
  local box="$1" mode="$2" path="$3" query="$4" limit="$5" script
  script='import json, os, sys
root_arg, mode, relative, query, raw_limit = sys.argv[1:]
root = os.path.realpath(root_arg)
limit = int(raw_limit)
prefetch_depth = 4

def resolve_folder(value):
    candidate = root if value == "." else os.path.join(root, *value.split("/"))
    resolved = os.path.realpath(candidate)
    if resolved != root and not resolved.startswith(root + os.sep):
        raise ValueError("outside-root")
    if not os.path.isdir(resolved):
        raise FileNotFoundError(value)
    return resolved

def relative_path(value):
    path = os.path.relpath(value, root)
    return "." if path == "." else path

def directory_candidates(folder):
    candidates = []
    with os.scandir(folder) as iterator:
        for item in iterator:
            if item.is_symlink():
                continue
            try:
                if item.is_dir(follow_symlinks=False):
                    candidates.append((item.name, item.path))
            except OSError:
                continue
    candidates.sort(key=lambda item: (item[0].casefold(), item[0]))
    return candidates

folder = resolve_folder(relative)
entries = []
truncated = False
emitted = 0

def build_entry(name, full_path, depth, count_self=True):
    global emitted, truncated
    if count_self:
        emitted += 1
    candidates = directory_candidates(full_path)
    has_children = bool(candidates)
    children = []
    children_truncated = False
    if depth < prefetch_depth:
        for child_name, child_path in candidates:
            if emitted >= limit:
                children_truncated = True
                truncated = True
                break
            children.append(build_entry(child_name, child_path, depth + 1))
    elif has_children:
        children_truncated = True
        truncated = True
    return {
        "name": name,
        "path": relative_path(full_path),
        "kind": "directory",
        "hasChildren": has_children,
        "children": children,
        "childrenTruncated": children_truncated,
    }

if mode == "list":
    candidates = directory_candidates(folder)
    selected_candidates = candidates[:limit]
    emitted = len(selected_candidates)
    truncated = len(candidates) > len(selected_candidates)
    for name, full_path in selected_candidates:
        entries.append(build_entry(name, full_path, 1, count_self=False))
else:
    needle = query.casefold()
    visited = 0
    for current, directories, _ in os.walk(folder, topdown=True, followlinks=False):
        directories[:] = sorted(
            [name for name in directories if not os.path.islink(os.path.join(current, name))],
            key=lambda name: (name.casefold(), name),
        )
        depth = relative_path(current).count("/") + (0 if current == root else 1)
        if depth >= 12:
            directories[:] = []
        for name in directories:
            visited += 1
            candidate = os.path.join(current, name)
            path = relative_path(candidate)
            if needle in name.casefold() or needle in path.casefold():
                if len(entries) >= limit:
                    truncated = True
                    directories[:] = []
                    break
                entries.append({
                    "name": name,
                    "path": path,
                    "kind": "directory",
                    "hasChildren": bool(directory_candidates(candidate)),
                    "children": [],
                    "childrenTruncated": False,
                })
            if visited >= 5000:
                truncated = True
                directories[:] = []
                break
        if truncated and (len(entries) >= limit or visited >= 5000):
            break

print(json.dumps({
    "path": relative_path(folder),
    "query": query if mode == "search" else None,
    "entries": entries,
    "truncated": truncated,
}, ensure_ascii=True, separators=(",", ":")))'
  workspace_msb "$box" exec --no-tty "$box" -- \
    python3 -c "$script" /workspace "$mode" "$path" "$query" "$limit"
}

app_directory_result_is_valid() {
  local json="$1" limit="$2" expected_path="$3" expected_query="$4" recursive="$5"
  "$JQ_BIN" -e \
    --argjson limit "$limit" \
    --arg expectedPath "$expected_path" \
    --arg expectedQuery "$expected_query" \
    --argjson recursive "$recursive" '
    def safe_relative:
      type == "string" and length > 0 and length <= 1024 and
      (test("[[:cntrl:]]") | not) and
      ((. == ".") or
        ((startswith("/") | not) and
         (split("/") | all(. != "" and . != "." and . != ".."))));
    def components:
      if . == "." then [] else split("/") end;
    def within_scope($scope; $is_recursive):
      (. | components) as $entryParts |
      ($scope | components) as $scopeParts |
      ($entryParts | length) > ($scopeParts | length) and
      $entryParts[0:($scopeParts | length)] == $scopeParts and
      ($is_recursive or (($entryParts | length) == (($scopeParts | length) + 1)));
    def valid_entry($parent; $is_recursive):
      . as $entry |
      type == "object" and
      keys == ["children", "childrenTruncated", "hasChildren", "kind", "name", "path"] and
      (.name | type == "string" and length > 0 and length <= 255 and (test("[[:cntrl:]]") | not)) and
      (.path | safe_relative and . != ".") and
      (.path as $path | .name == ($path | split("/") | last)) and
      (.path | within_scope($parent; $is_recursive)) and
      .kind == "directory" and
      (.hasChildren | type == "boolean") and
      (.childrenTruncated | type == "boolean") and
      (.children | type == "array") and
      (((.children | length) == 0) or .hasChildren) and
      ((.childrenTruncated | not) or .hasChildren) and
      (if $is_recursive then
         (.children | length) == 0 and (.childrenTruncated | not)
       else
         ([.children[] | valid_entry($entry.path; false)] | all)
       end);
    type == "object" and keys == ["entries", "path", "query", "truncated"] and
    .path == $expectedPath and (.path | safe_relative) and
    (if $recursive then
       .query == $expectedQuery and
       (.query | type == "string" and length > 0 and length <= 128 and (test("[[:cntrl:]]") | not))
     else
       .query == null
     end) and
    (.truncated | type == "boolean") and
    (.entries | type == "array") and
    (([.entries[] | recurse(.children[]?)] | length) <= $limit) and
    ([.entries[] | valid_entry($expectedPath; $recursive)] | all)
  ' >/dev/null <<<"$json"
}

app_cmd_directory_query() {
  local command="$1" mode="$2"; shift 2
  local box="" path="." query="" limit="100" status="" result=""
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error "$command"; box="$2"; shift 2 ;;
      --path) [[ $# -ge 2 ]] || app_usage_error "$command"; path="$2"; shift 2 ;;
      --query) [[ $# -ge 2 ]] || app_usage_error "$command"; query="$2"; shift 2 ;;
      --limit) [[ $# -ge 2 ]] || app_usage_error "$command"; limit="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error "$command"; shift 2 ;;
      *) app_usage_error "$command" ;;
    esac
  done
  is_workspace "$box" || app_usage_error "$command"
  app_valid_relative_path "$path" || app_usage_error "$command"
  [[ "$limit" =~ ^[0-9]+$ ]] && (( 10#$limit >= 1 && 10#$limit <= 200 )) || app_usage_error "$command"
  if [[ "$mode" == search ]]; then
    app_valid_directory_query "$query" || app_usage_error "$command"
  elif [[ -n "$query" ]]; then
    app_usage_error "$command"
  fi
  app_require_config "$command"
  app_require_runtime "$command"
  if ! status="$(app_status_for_workspace "$box" 2>/dev/null)"; then
    app_emit_error "$command" "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed." "Refresh after repairing the MSW runtime." "$box" true 69
  fi
  if [[ "$status" != Running ]]; then
    app_emit_error "$command" "MSW_WORKSPACE_STOPPED" "Workspace folders are unavailable while the workspace is stopped." "Start the workspace, then retry folder browsing." "$box" false 69
  fi
  if ! result="$(app_guest_directory_query "$box" "$mode" "$path" "$query" "$limit" 2>/dev/null)"; then
    app_emit_error "$command" "MSW_DIRECTORY_UNAVAILABLE" "The requested folder is unavailable." "Choose a folder under /workspace and retry." "$box" true 69
  fi
  result="$(app_redact "$result")"
  result="$("$JQ_BIN" -c '
    def safe_entries:
      map(
        select(
          (.name | contains("[REDACTED]") | not) and
          (.path | contains("[REDACTED]") | not)
        ) |
        .children |= safe_entries
      );
    .entries |= safe_entries
  ' <<<"$result")"
  if [[ "$("$JQ_BIN" -r '.path, (.query // "")' <<<"$result")" == *"[REDACTED]"* ]]; then
    app_emit_error "$command" "MSW_DIRECTORY_UNAVAILABLE" "The requested folder or search cannot be displayed safely." "Choose a different folder or search term." "$box" false 69
  fi
  app_directory_result_is_valid \
    "$result" "$limit" "$path" "$query" "$([[ "$mode" == search ]] && printf true || printf false)" || \
    app_emit_error "$command" "MSW_SCHEMA_MISMATCH" "The workspace returned an invalid directory response." "Update or repair the MSW runtime adapter." "$box" false 78
  result="$("$JQ_BIN" -c --arg workspace "$box" '. + {workspace:$workspace}' <<<"$result")"
  app_emit_success "$command" "$result"
}

app_cmd_editor_target() {
  local box="" path="." status="" result="" canonical_path=""
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error editor-target; box="$2"; shift 2 ;;
      --path) [[ $# -ge 2 ]] || app_usage_error editor-target; path="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error editor-target; shift 2 ;;
      *) app_usage_error editor-target ;;
    esac
  done
  is_workspace "$box" || app_usage_error editor-target
  app_valid_relative_path "$path" || app_usage_error editor-target
  app_require_config editor-target
  app_require_runtime editor-target
  if ! status="$(app_status_for_workspace "$box" 2>/dev/null)"; then
    app_emit_error editor-target "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed." "Refresh after repairing the MSW runtime." "$box" true 69
  fi
  if [[ "$status" != Running ]]; then
    app_emit_error editor-target "MSW_WORKSPACE_STOPPED" "The source-code editor cannot open a stopped workspace." "Start the workspace, then retry." "$box" false 69
  fi
  if ! result="$(app_guest_directory_query "$box" list "$path" "" 1 2>/dev/null)"; then
    app_emit_error editor-target "MSW_DIRECTORY_UNAVAILABLE" "The requested folder is unavailable." "Choose an existing folder under /workspace and retry." "$box" false 69
  fi
  result="$(app_redact "$result")"
  if [[ "$("$JQ_BIN" -r '.path' <<<"$result")" == *"[REDACTED]"* ]]; then
    app_emit_error editor-target "MSW_DIRECTORY_UNAVAILABLE" "The requested folder cannot be displayed safely." "Choose a different folder." "$box" false 69
  fi
  app_directory_result_is_valid "$result" 1 "$path" "" false || \
    app_emit_error editor-target "MSW_SCHEMA_MISMATCH" "The workspace returned an invalid directory response." "Update or repair the MSW runtime adapter." "$box" false 78
  canonical_path="$("$JQ_BIN" -r '.path' <<<"$result")"
  [[ "$canonical_path" == "." ]] && canonical_path=""
  app_emit_success editor-target \
    "{\"workspace\":$(app_json_string "$box"),\"path\":$(app_json_string "${canonical_path:-.}"),\"host\":$(app_json_string "$(workspace_ssh_host "$box")")}"
}

app_valid_repository() {
  local repository="${1-}"
  [[ "$repository" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

app_read_confirmation() {
  local fd="${1-}" expected="${2-}" supplied=""
  [[ "$fd" =~ ^[0-9]+$ ]] || return 1
  IFS= read -r supplied <&"$fd" || return 1
  [[ "$supplied" == "$expected" ]]
}

app_target_json() {
  local target="${1:-all}" box items=""
  while IFS= read -r box; do
    [[ -n "$items" ]] && items+=","
    items+="$(app_json_string "$box")"
  done < <(for_targets "$target")
  printf '[%s]' "$items"
}

app_cmd_url() {
  local box="" port="3000" scheme="http" url
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error url "missing value for --workspace"; box="$2"; shift 2 ;;
      --port) [[ $# -ge 2 ]] || app_usage_error url "missing value for --port"; port="$2"; shift 2 ;;
      --scheme) [[ $# -ge 2 ]] || app_usage_error url "missing value for --scheme"; scheme="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error url "url requires --format json"; shift 2 ;;
      *) app_usage_error url "unknown url option '$1'" ;;
    esac
  done
  is_workspace "$box" || app_usage_error url "workspace must be one of the configured workspaces"
  app_require_config url
  [[ "$port" =~ ^[0-9]+$ ]] || app_usage_error url "port must be an integer from 1 to 65535"
  (( 10#$port >= 1 && 10#$port <= 65535 )) || app_usage_error url "port must be an integer from 1 to 65535"
  [[ "$scheme" == http || "$scheme" == https ]] || app_usage_error url "scheme must be http or https"
  port_is_published "$port" || app_emit_error url "MSW_PORT_NOT_PUBLISHED" "The requested port is not published for this installation." "Use a configured port or create an explicit tunnel." "$box" false 64
  url="$(printf '%s://%s:%s' "$scheme" "$(workspace_host "$box")" "$port")"
  app_emit_success url "{\"workspace\":$(app_json_string "$box"),\"url\":$(app_json_string "$url"),\"started\":false}"
}

app_cmd_clone() {
  local box="" repository="" destination="" output
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error clone "missing value for --workspace"; box="$2"; shift 2 ;;
      --repository) [[ $# -ge 2 ]] || app_usage_error clone "missing value for --repository"; repository="$2"; shift 2 ;;
      --destination) [[ $# -ge 2 ]] || app_usage_error clone "missing value for --destination"; destination="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error clone "clone requires --format json"; shift 2 ;;
      *) app_usage_error clone "unknown clone option '$1'" ;;
    esac
  done
  is_workspace "$box" || app_usage_error clone "workspace must be one of the configured workspaces"
  app_valid_repository "$repository" || app_usage_error clone "repository must be OWNER/REPOSITORY"
  if [[ -n "$destination" ]]; then
    app_valid_relative_path "$destination" || app_usage_error clone "destination must be relative to /workspace"
  else
    destination="${repository#*/}"
  fi
  app_valid_relative_path "$destination" || app_usage_error clone "destination must be relative to /workspace"
  app_require_config clone
  app_require_runtime clone
  if ! output="$(cmd_clone "$box" "$repository" "$destination" 2>/dev/null)"; then
    app_emit_error clone "MSW_CLONE_FAILED" "The repository could not be cloned into the workspace." "In local mode public repositories clone anonymously; in Connect mode the repository must be authorized for this workspace." "$box" true 1
  fi
  app_emit_success clone "{\"workspace\":$(app_json_string "$box"),\"operation\":\"clone\",\"target\":$(app_json_string "$destination"),\"changed\":true,\"outcome\":\"repository cloned\"}"
}

app_cmd_pull() {
  local box="" path="all" output
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error pull "missing value for --workspace"; box="$2"; shift 2 ;;
      --path) [[ $# -ge 2 ]] || app_usage_error pull "missing value for --path"; path="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error pull "pull requires --format json"; shift 2 ;;
      *) app_usage_error pull "unknown pull option '$1'" ;;
    esac
  done
  is_workspace "$box" || app_usage_error pull "workspace must be one of the configured workspaces"
  [[ "$path" == all ]] || app_valid_relative_path "$path" || app_usage_error pull "path must be relative to /workspace"
  app_require_config pull
  app_require_runtime pull
  if ! output="$(cmd_pull "$box" "$path" 2>/dev/null)"; then
    app_emit_error pull "MSW_PULL_FAILED" "The repository could not be fast-forwarded." "Review repository state and retry the individual path." "$box" true 1
  fi
  app_emit_success pull "{\"workspace\":$(app_json_string "$box"),\"operation\":\"pull\",\"target\":$(app_json_string "$path"),\"changed\":true,\"outcome\":\"fast-forward pull completed\"}"
}

app_cmd_identity() {
  local name="" email="" target="all" output box
  while (( $# > 0 )); do
    case "$1" in
      --name) [[ $# -ge 2 ]] || app_usage_error identity "missing value for --name"; name="$2"; shift 2 ;;
      --email) [[ $# -ge 2 ]] || app_usage_error identity "missing value for --email"; email="$2"; shift 2 ;;
      --workspace) [[ $# -ge 2 ]] || app_usage_error identity "missing value for --workspace"; target="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error identity "identity requires --format json"; shift 2 ;;
      *) app_usage_error identity "unknown identity option '$1'" ;;
    esac
  done
  [[ -n "$name" && -n "$email" && ${#name} -le 256 && ${#email} -le 320 ]] || app_usage_error identity "name and email are required"
  app_valid_control_free "$name" && app_valid_control_free "$email" || app_usage_error identity "identity fields contain a control character"
  [[ "$target" == all ]] || is_workspace "$target" || app_usage_error identity "workspace must be one of the configured workspaces"
  app_require_config identity
  app_require_runtime identity
  if ! output="$(cmd_identity "$name" "$email" "$target" 2>/dev/null)"; then
    app_emit_error identity "MSW_IDENTITY_FAILED" "Git identity could not be applied." "Review the workspace runtime and retry." "" true 1
  fi
  app_emit_success identity "{\"target\":$(app_json_string "$target"),\"name\":$(app_json_string "$name"),\"email\":$(app_json_string "$email"),\"workspaces\":$(app_target_json "$target")}"
}

app_cmd_disk() {
  local target="all" output
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error disk "missing value for --workspace"; target="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error disk "disk requires --format json"; shift 2 ;;
      *) app_usage_error disk "unknown disk option '$1'" ;;
    esac
  done
  [[ "$target" == all ]] || is_workspace "$target" || app_usage_error disk "workspace must be one of the configured workspaces"
  app_require_config disk
  app_require_runtime disk
  if ! output="$(cmd_disk "$target" 2>/dev/null)"; then
    app_emit_error disk "MSW_DISK_UNAVAILABLE" "Disk usage could not be collected." "Retry after repairing the workspace runtime." "" true 69
  fi
  app_emit_success disk "{\"workspace\":$(app_json_string "$target"),\"operation\":\"disk\",\"target\":null,\"changed\":false,\"outcome\":\"disk usage collected; stopped workspaces may have been started for this read\"}"
}

app_cmd_resize() {
  local box="" memory="" cpus="" output
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error resize "missing value for --workspace"; box="$2"; shift 2 ;;
      --memory) [[ $# -ge 2 ]] || app_usage_error resize "missing value for --memory"; memory="$2"; shift 2 ;;
      --cpus) [[ $# -ge 2 ]] || app_usage_error resize "missing value for --cpus"; cpus="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error resize "resize requires --format json"; shift 2 ;;
      *) app_usage_error resize "unknown resize option '$1'" ;;
    esac
  done
  is_workspace "$box" || app_usage_error resize "workspace must be one of the configured workspaces"
  [[ "$memory" =~ ^[0-9]+([KMGTP]i?B?)$ ]] || app_usage_error resize "memory must use an explicit size such as 8GiB"
  [[ -z "$cpus" || "$cpus" =~ ^[0-9]+([.][0-9]+)?$ ]] || app_usage_error resize "cpus must be numeric"
  app_require_config resize
  app_require_runtime resize
  if ! output="$(cmd_resize "$box" "$memory" "$cpus" 2>/dev/null)"; then
    app_emit_error resize "MSW_RESIZE_FAILED" "Workspace resources could not be changed." "Review configured ceilings and retry." "$box" true 1
  fi
  app_emit_success resize "{\"workspace\":$(app_json_string "$box"),\"memory\":$(app_json_string "$memory"),\"cpus\":$(app_json_optional "$cpus"),\"effective\":true,\"outcome\":\"resource change applied\"}"
}

app_cmd_clean() {
  local target="all" volumes=0 fd="" expected="" output
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error clean "missing value for --workspace"; target="$2"; shift 2 ;;
      --volumes) volumes=1; shift ;;
      --confirmation-fd) [[ $# -ge 2 ]] || app_usage_error clean "missing value for --confirmation-fd"; fd="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error clean "clean requires --format json"; shift 2 ;;
      *) app_usage_error clean "unknown clean option '$1'" ;;
    esac
  done
  [[ "$target" == all ]] || is_workspace "$target" || app_usage_error clean "workspace must be one of the configured workspaces"
  expected="$([[ "$volumes" == 1 ]] && printf 'DELETE VOLUMES %s' "$target" || printf 'CLEAN %s' "$target")"
  app_read_confirmation "$fd" "$expected" || app_emit_error clean "MSW_CONFIRMATION_MISMATCH" "The cleanup confirmation did not match the reviewed action." "Review the cleanup effect and confirm the exact phrase." "$target" false 77
  app_require_config clean
  app_require_runtime clean
  if (( volumes == 1 )); then
    if ! output="$(cmd_clean "$target" --volumes 2>/dev/null)"; then
      app_emit_error clean "MSW_CLEAN_FAILED" "Workspace cleanup failed." "Retry after checking the workspace runtime." "$target" true 1
    fi
  elif ! output="$(cmd_clean "$target" 2>/dev/null)"; then
    app_emit_error clean "MSW_CLEAN_FAILED" "Workspace cleanup failed." "Retry after checking the workspace runtime." "$target" true 1
  fi
  app_emit_success clean "{\"target\":$(app_json_string "$target"),\"operation\":\"clean\",\"volumesRemoved\":$([[ "$volumes" == 1 ]] && printf true || printf false),\"outcome\":\"cleanup completed\"}"
}

app_cmd_upgrade() {
  local target="all" fd="" output
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error upgrade "missing value for --workspace"; target="$2"; shift 2 ;;
      --confirmation-fd) [[ $# -ge 2 ]] || app_usage_error upgrade "missing value for --confirmation-fd"; fd="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error upgrade "upgrade requires --format json"; shift 2 ;;
      *) app_usage_error upgrade "unknown upgrade option '$1'" ;;
    esac
  done
  [[ "$target" == all ]] || is_workspace "$target" || app_usage_error upgrade "workspace must be one of the configured workspaces"
  app_read_confirmation "$fd" "UPGRADE $target" || app_emit_error upgrade "MSW_CONFIRMATION_MISMATCH" "The upgrade confirmation did not match the reviewed action." "Review the upgrade effect and confirm the exact phrase." "$target" false 77
  app_require_config upgrade
  app_require_runtime upgrade
  if ! output="$(cmd_upgrade "$target" 2>/dev/null)"; then
    app_emit_error upgrade "MSW_UPGRADE_FAILED" "Guest package upgrade failed." "Retry after checking the workspace runtime." "$target" true 1
  fi
  app_emit_success upgrade "{\"target\":$(app_json_string "$target"),\"operation\":\"upgrade\",\"volumesRemoved\":false,\"outcome\":\"guest package upgrade completed\"}"
}

app_cmd_update() {
  local fd="" output
  while (( $# > 0 )); do
    case "$1" in
      --confirmation-fd) [[ $# -ge 2 ]] || app_usage_error update "missing value for --confirmation-fd"; fd="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error update "update requires --format json"; shift 2 ;;
      *) app_usage_error update "unknown update option '$1'" ;;
    esac
  done
  app_read_confirmation "$fd" "UPDATE" || app_emit_error update "MSW_CONFIRMATION_MISMATCH" "The runtime update confirmation did not match." "Review the update effect and confirm UPDATE." "" false 77
  app_require_runtime update
  if ! output="$(cmd_update 2>/dev/null)"; then
    app_emit_error update "MSW_UPDATE_FAILED" "The MicroSandbox runtime update failed." "Retry from Settings after checking the toolchain." "" true 1
  fi
  app_emit_success update "{\"target\":\"host\",\"operation\":\"update\",\"volumesRemoved\":false,\"outcome\":\"host runtime update and doctor completed\"}"
}

app_cmd_check() {
  local deep=0 fd="" output
  while (( $# > 0 )); do
    case "$1" in
      --deep) deep=1; shift ;;
      --confirmation-fd) [[ $# -ge 2 ]] || app_usage_error check "missing value for --confirmation-fd"; fd="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error check "check requires --format json"; shift 2 ;;
      *) app_usage_error check "unknown check option '$1'" ;;
    esac
  done
  if (( deep == 1 )); then
    app_read_confirmation "$fd" "DEEP CHECK" || app_emit_error check "MSW_CONFIRMATION_MISMATCH" "The deep-check confirmation did not match." "Review that deep verification starts workspaces and test containers, then confirm DEEP CHECK." "" false 77
  elif [[ -n "$fd" ]]; then
    app_usage_error check "--confirmation-fd is valid only with --deep"
  fi
  app_require_config check
  app_require_runtime check
  if ! output="$(cmd_check $([[ "$deep" == 1 ]] && printf '%s' --deep) 2>/dev/null)"; then
    app_emit_error check "MSW_CHECK_FAILED" "One or more MSW checks failed." "Open diagnostics for subsystem recovery details." "" true 1
  fi
  app_emit_success check "{\"deep\":$([[ "$deep" == 1 ]] && printf true || printf false),\"passed\":true,\"checks\":[{\"id\":\"msw-check\",\"title\":\"MSW check\",\"status\":\"pass\",\"detail\":\"MSW check completed successfully.\",\"recovery\":null}],\"outcome\":\"all requested checks passed\"}"
}

app_cmd_backup() {
  local directory="" output archive archive_bytes checksum box running_json="" restarted_json="" warnings="[]" warning=""
  while (( $# > 0 )); do
    case "$1" in
      --directory) [[ $# -ge 2 ]] || app_usage_error backup "missing value for --directory"; directory="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error backup "backup requires --format json"; shift 2 ;;
      *) app_usage_error backup "unknown backup option '$1'" ;;
    esac
  done
  [[ -n "$directory" && "$directory" != -* ]] || app_usage_error backup "backup directory is required"
  app_valid_control_free "$directory" || app_usage_error backup "backup directory contains a control character"
  app_require_config backup
  app_require_runtime backup
  while IFS= read -r box; do
    [[ -n "$box" ]] || continue
    [[ -n "$running_json" ]] && running_json+=","
    running_json+="$(app_json_string "$box")"
  done < <(running_workspaces)
  if ! output="$("$MSW_SCRIPT_ROOT/msw" backup "$directory" 2>/dev/null)"; then
    app_emit_error backup "MSW_BACKUP_FAILED" "The backup could not be created." "Review the destination and workspace health, then retry." "" true 1
    return 1
  fi
  directory="$(cd "$directory" && pwd -P)"
  archive="$(printf '%s\n' "$output" | /usr/bin/sed -n '/\.tar\.zst$/p' | tail -n 1)"
  checksum="$(printf '%s\n' "$output" | /usr/bin/sed -n '/\.tar\.zst\.sha256$/p' | tail -n 1)"
  if [[ -z "$archive" || "$archive" != "$directory"/* || "$archive" != *.tar.zst || ! -f "$archive" || -L "$archive" ]]; then
    app_emit_error backup "MSW_BACKUP_FAILED" "MSW returned an invalid backup archive path." "Retry the backup after checking diagnostics." "" false 78
    return 78
  fi
  archive_bytes="$(/usr/bin/wc -c <"$archive" | /usr/bin/awk '{ print $1 }')"
  if [[ ! "$archive_bytes" =~ ^[0-9]+$ || "$archive_bytes" -le 0 ]]; then
    app_emit_error backup "MSW_BACKUP_FAILED" "MSW could not validate the completed backup archive size." "Retry the backup after checking diagnostics." "" false 78
    return 78
  fi
  [[ -n "$checksum" && "$checksum" == "$archive.sha256" && -f "$checksum" && ! -L "$checksum" ]] || checksum=""
  for box in "${WORKSPACES[@]}"; do
    [[ ",$running_json," == *",\"$box\","* ]] || continue
    if workspace_msb "$box" ping -q "$box" >/dev/null 2>&1; then
      [[ -n "$restarted_json" ]] && restarted_json+=","
      restarted_json+="$(app_json_string "$box")"
    else
      warning="MSW could not confirm that $box returned to its pre-backup running state"
      if [[ "$warnings" == "[]" ]]; then warnings="[$(app_json_string "$warning")]"; else warnings="${warnings%]},$(app_json_string "$warning")]"; fi
    fi
  done
  app_emit_success backup "{\"archive\":$(app_json_string "$archive"),\"archiveBytes\":$archive_bytes,\"checksum\":$(app_json_optional "$checksum"),\"stoppedWorkspaces\":[$running_json],\"restartedWorkspaces\":[$restarted_json]}" "$warnings"
}

app_cmd_backup_preview() {
  local directory="" estimated_source_bytes box running_json="" home_real
  while (( $# > 0 )); do
    case "$1" in
      --directory) [[ $# -ge 2 ]] || app_usage_error backup-preview "missing value for --directory"; directory="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error backup-preview "backup-preview requires --format json"; shift 2 ;;
      *) app_usage_error backup-preview "unknown backup-preview option '$1'" ;;
    esac
  done
  [[ -n "$directory" && "$directory" != -* ]] || app_usage_error backup-preview "backup directory is required"
  app_valid_control_free "$directory" || app_usage_error backup-preview "backup directory contains a control character"
  [[ -d "$directory" ]] || app_usage_error backup-preview "backup directory must exist"
  app_require_config backup-preview
  app_require_runtime backup-preview
  directory="$(cd "$directory" && pwd -P)"
  home_real="$(cd "$HOME" && pwd -P)"
  case "$directory/" in
    "$home_real/.microsandbox/"*|"$home_real/.config/msw/"*|"$home_real/.local/share/msw/"*)
      app_usage_error backup-preview "backup destination may not be inside managed state"
      ;;
  esac
  if ! estimated_source_bytes="$(backup_estimated_source_bytes)" ||
    [[ ! "$estimated_source_bytes" =~ ^[0-9]+$ || "$estimated_source_bytes" -le 0 ]]; then
    app_emit_error backup-preview "MSW_BACKUP_PREVIEW_FAILED" "The managed source data estimate could not be measured." "Run diagnostics and retry." "" true 69
    return 69
  fi
  while IFS= read -r box; do
    [[ -n "$box" ]] || continue
    [[ -n "$running_json" ]] && running_json+=","
    running_json+="$(app_json_string "$box")"
  done < <(running_workspaces)
  app_emit_success backup-preview "{\"destination\":$(app_json_string "$directory"),\"requiredBytes\":$estimated_source_bytes,\"runningWorkspaces\":[$running_json]}"
}

app_cmd_restore() {
  local archive="" fd="" output
  while (( $# > 0 )); do
    case "$1" in
      --archive) [[ $# -ge 2 ]] || app_usage_error restore "missing value for --archive"; archive="$2"; shift 2 ;;
      --confirmation-fd) [[ $# -ge 2 ]] || app_usage_error restore "missing value for --confirmation-fd"; fd="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error restore "restore requires --format json"; shift 2 ;;
      *) app_usage_error restore "unknown restore option '$1'" ;;
    esac
  done
  [[ -f "$archive" && ! -L "$archive" && "$archive" == *.zst ]] || app_usage_error restore "restore requires an existing regular .zst archive"
  app_read_confirmation "$fd" RESTORE || app_emit_error restore "MSW_CONFIRMATION_MISMATCH" "The restore confirmation did not match." "Review the archive and confirm RESTORE." "" false 77
  app_require_config restore
  app_require_runtime restore
  if ! output="$(printf 'RESTORE\n' | cmd_restore "$archive" 2>/dev/null)"; then
    app_emit_error restore "MSW_RESTORE_FAILED" "The workspace restore failed and MSW attempted its rollback." "Run diagnostics and inspect the retained rollback state." "" true 1
  fi
  app_emit_success restore "{\"workspace\":\"all\",\"operation\":\"restore\",\"target\":$(app_json_string "$archive"),\"changed\":true,\"outcome\":\"restore completed; workspaces remain stopped\"}"
}


app_cmd_handshake() {
  local config_available=false runtime_available=false jq_available=false
  (( MSW_CONFIG_AVAILABLE == 1 )) && config_available=true
  [[ -n "${MSB_BIN:-}" && -x "${MSB_BIN:-}" ]] && runtime_available=true
  [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] && jq_available=true
  app_emit_success handshake "{\"protocolVersion\":1,\"mswVersion\":$(app_json_string "${MSW_VERSION:-unknown}"),\"platform\":{\"os\":$(app_json_string "$(uname -s)"),\"architecture\":$(app_json_string "$(uname -m)")},\"configurationAvailable\":$config_available,\"runtimeAvailable\":$runtime_available,\"capabilities\":{\"jsonState\":true,\"jsonMetrics\":true,\"jsonLogs\":true,\"plans\":true,\"bootstrapEvents\":true,\"backupPreview\":true,\"jq\":$jq_available,\"workspaceCount\":${#WORKSPACES[@]}},\"exitCodes\":{\"success\":0,\"operationFailed\":1,\"usage\":64,\"dependencyUnavailable\":69,\"lockConflict\":73,\"authorizationDenied\":77,\"configurationRequired\":78,\"cancelled\":130}}"
}

app_cmd_state() {
  local target="all" box state_json="" warnings="[]" warning lifecycle observed_at
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error state "missing value for --workspace"; target="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error state "state requires --format json"; shift 2 ;;
      *) app_usage_error state "unknown state option '$1'" ;;
    esac
  done
  app_require_config state
  app_require_runtime state
  if [[ "$target" == all ]]; then
    for box in "${WORKSPACES[@]}"; do
      [[ -n "$state_json" ]] && state_json+=","
      if lifecycle="$(app_status_for_workspace "$box" 2>/dev/null)"; then
        observed_at="$(app_now)"
        state_json+="$(app_workspace_json "$box" "$lifecycle" fresh "$observed_at")"
      else
        state_json+="$(app_workspace_json "$box" Unknown unavailable "")"
        warning="state observation for $box is unavailable; the previous lifecycle must remain stale"
        if [[ "$warnings" == "[]" ]]; then warnings="[$(app_json_string "$warning")]"; else warnings="${warnings%]},$(app_json_string "$warning")]"; fi
      fi
    done
  else
    is_workspace "$target" || app_usage_error state "workspace must be one of the configured workspaces"
    if lifecycle="$(app_status_for_workspace "$target" 2>/dev/null)"; then
      observed_at="$(app_now)"
      state_json="$(app_workspace_json "$target" "$lifecycle" fresh "$observed_at")"
    else
      state_json="$(app_workspace_json "$target" Unknown unavailable "")"
      warning="state observation for $target is unavailable; the previous lifecycle must remain stale"
      warnings="[$(app_json_string "$warning")]"
    fi
  fi
  app_emit_success state "{\"schemaVersion\":1,\"mswVersion\":$(app_json_string "${MSW_VERSION:-unknown}"),\"workspaces\":[$state_json]}" "$warnings"
}

app_cmd_metrics() {
  local box="" once=0 follow=0 raw status line
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error metrics "missing value for --workspace"; box="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error metrics "metrics requires --format json"; shift 2 ;;
      --once) once=1; shift ;;
      --follow) follow=1; shift ;;
      *) app_usage_error metrics "unknown metrics option '$1'" ;;
    esac
  done
  [[ -n "$box" ]] || app_usage_error metrics "--workspace is required"
  is_workspace "$box" || app_usage_error metrics "workspace must be one of the configured workspaces"
  (( once + follow == 1 )) || app_usage_error metrics "metrics requires exactly one of --once or --follow"
  app_require_config metrics
  app_require_runtime metrics
  if ! status="$(app_status_for_workspace "$box" 2>/dev/null)"; then
    app_emit_error metrics "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed." "Refresh after repairing the MSW runtime." "$box" true 69
  fi
  if [[ "$status" != Running ]]; then
    app_emit_success metrics "{\"workspace\":$(app_json_string "$box"),\"available\":false,\"lifecycle\":$(app_json_string "$status"),\"freshness\":\"fresh\",\"reason\":\"workspace is not running\"}"
    return
  fi
  if (( follow == 1 )); then
    MSW_APP_RESPONSE_EMITTED=1
    printf '{"schemaVersion":1,"type":"stream-start","protocolVersion":1,"stream":"metrics","requestId":%s,"workspace":%s,"observedAt":%s,"safeForDisplay":true}\n' \
      "$(app_json_string "$MSW_APP_REQUEST_ID")" \
      "$(app_json_string "$box")" \
      "$(app_json_string "$(app_now)")"
    if ! workspace_msb "$box" metrics "$box" --format json --follow 2>/dev/null | while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      if (( ${#line} > 262144 )); then line="${line:0:262144}"; fi
      if [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] && "$JQ_BIN" -e 'type == "object" or type == "array"' <<<"$line" >/dev/null 2>&1; then
        MSW_APP_RESPONSE_EMITTED=1
        printf '{"schemaVersion":1,"type":"metrics","requestId":%s,"workspace":%s,"observedAt":%s,"available":true,"snapshot":%s,"safeForDisplay":true}\n' \
          "$(app_json_string "$MSW_APP_REQUEST_ID")" \
          "$(app_json_string "$box")" \
          "$(app_json_string "$(app_now)")" \
          "$line"
      else
        MSW_APP_RESPONSE_EMITTED=1
        printf '{"schemaVersion":1,"type":"metrics","requestId":%s,"workspace":%s,"observedAt":%s,"available":false,"reason":"The runtime returned a malformed metrics snapshot.","safeForDisplay":true}\n' \
          "$(app_json_string "$MSW_APP_REQUEST_ID")" \
          "$(app_json_string "$box")" \
          "$(app_json_string "$(app_now)")"
      fi
    done; then
      printf '{"schemaVersion":1,"type":"failed","requestId":%s,"workspace":%s,"observedAt":%s,"code":"MSW_METRICS_UNAVAILABLE","message":"The runtime metrics stream ended with an error.","safeForDisplay":true}\n' \
        "$(app_json_string "$MSW_APP_REQUEST_ID")" \
        "$(app_json_string "$box")" \
        "$(app_json_string "$(app_now)")"
      return 69
    fi
    printf '{"schemaVersion":1,"type":"stream-end","requestId":%s,"workspace":%s,"observedAt":%s,"safeForDisplay":true}\n' \
      "$(app_json_string "$MSW_APP_REQUEST_ID")" \
      "$(app_json_string "$box")" \
      "$(app_json_string "$(app_now)")"
    return
  fi
  if ! raw="$(workspace_msb "$box" metrics "$box" --format json --once 2>/dev/null)"; then
    app_emit_error metrics "MSW_METRICS_UNAVAILABLE" "The runtime did not provide a one-shot JSON metrics snapshot." "Keep Metrics visible after the runtime is updated." "$box" true 69
  fi
  [[ -n "${JQ_BIN:-}" ]] && "$JQ_BIN" -e 'type == "object" or type == "array"' <<<"$raw" >/dev/null 2>&1 || \
    app_emit_error metrics "MSW_SCHEMA_MISMATCH" "The runtime returned an unsupported metrics schema." "Update the MSW toolchain and retry." "$box" false 78
  app_emit_success metrics "{\"workspace\":$(app_json_string "$box"),\"available\":true,\"lifecycle\":\"Running\",\"freshness\":\"fresh\",\"snapshot\":$raw}"
}

app_listening_ports_for_workspace() {
  local box="$1"; shift
  local script
  read -r -d '' script <<'SCRIPT' || true
# MSW app listening-port probe
set -Eeuo pipefail
command -v ss >/dev/null 2>&1 || exit 69
listeners="$(ss -H -ltn 2>/dev/null)" || exit 69
for port in "$@"; do
  case "$port" in ""|*[!0-9]*) exit 64 ;; esac
  found=0
  while read -r state recv_q send_q local_address peer_address rest; do
    case "$local_address" in *":$port") found=1; break ;; esac
  done <<<"$listeners"
  (( found == 0 )) || printf '%s\n' "$port"
done
SCRIPT
  printf '%s\n' "$script" |
    workspace_msb "$box" exec --no-tty "$box" -- bash -s -- "$@"
}

app_cmd_ports() {
  local target="all" box port status host listening listening_state listening_json
  local workspaces_json="" ports_json="" active
  local -a configured_ports=()
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error ports "missing value for --workspace"; target="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error ports "ports requires --format json"; shift 2 ;;
      *) app_usage_error ports "unknown ports option '$1'" ;;
    esac
  done
  if [[ "$target" != all ]]; then
    is_workspace "$target" || app_usage_error ports "workspace must be one of the configured workspaces"
  fi
  app_require_config ports
  while IFS= read -r port; do
    [[ -n "$port" ]] && configured_ports+=("$port")
  done < <(expand_ports)

  while IFS= read -r box; do
    status="$(app_status_for_workspace "$box" 2>/dev/null || printf 'Unknown')"
    host="$(workspace_host "$box")"
    listening=""; listening_state=unknown
    if [[ "$status" == Running ]]; then
      if listening="$(app_listening_ports_for_workspace "$box" "${configured_ports[@]}" 2>/dev/null)"; then
        listening_state=known
      fi
    elif [[ "$status" == Stopped || "$status" == Exited ]]; then
      listening_state=known
    fi

    ports_json=""
    for port in "${configured_ports[@]}"; do
      listening_json=null
      if [[ "$listening_state" == known ]]; then
        listening_json=false
        while IFS= read -r active; do
          if [[ "$active" == "$port" ]]; then listening_json=true; break; fi
        done <<<"$listening"
      fi
      [[ -n "$ports_json" ]] && ports_json+=","
      ports_json+="{\"port\":$(app_json_string "$port"),\"configured\":true,\"listening\":$listening_json}"
    done

    [[ -n "$workspaces_json" ]] && workspaces_json+=","
    workspaces_json+="{\"workspace\":$(app_json_string "$box"),\"lifecycle\":$(app_json_string "$status"),\"host\":$(app_json_string "$host"),\"listeningState\":$(app_json_string "$listening_state"),\"ports\":[$ports_json]}"
  done < <(for_targets "$target")
  app_emit_success ports "{\"workspace\":$(app_json_string "$target"),\"workspaces\":[$workspaces_json],\"freshness\":\"fresh\"}"
}

app_cmd_github_state() {
  local target="all" box items="" repo access provider configured quarantine account_login installation_id access_expires refresh_expires needs_restart
  local host_access_expires host_refresh_expires host_needs_restart cap cap_state host_cred_state
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error github-state "missing value for --workspace"; target="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error github-state "github-state requires --format json"; shift 2 ;;
      *) app_usage_error github-state "unknown github-state option '$1'" ;;
    esac
  done
  if [[ "$target" != all ]]; then
    is_workspace "$target" || app_usage_error github-state "workspace must be one of the configured workspaces"
  fi
  for box in "${WORKSPACES[@]}"; do
    [[ "$target" == all || "$target" == "$box" ]] || continue
    if [[ "$MSW_GITHUB_MODE" == local ]]; then
      # §1/§8: local mode never reads Connect grants; report policy state.
      provider="local-policy"
      configured=false
      if policy_validate; then
        cap="$(policy_workspace_capability "$box" 2>/dev/null || true)"
        [[ -n "$cap" ]] && configured=true
      fi
      repo="$(policy_first_ticked_repo "$box" 2>/dev/null || true)"
      access="unconfigured"
      if policy_validate; then
        if "$JQ_BIN" -e --arg w "$box" '.workspaces[$w].repos // [] | any(.mode == "read-write")' "$(policy_file)" >/dev/null 2>&1; then
          access="read-write"
        elif "$JQ_BIN" -e --arg w "$box" '.workspaces[$w].repos // [] | length > 0' "$(policy_file)" >/dev/null 2>&1; then
          access="read-only"
        fi
      fi
      cap_state="$(policy_capability_state "$box")"
      host_cred_state="$(host_credential_state | tr -d '\n')"
      quarantine=false
      app_workspace_quarantined "$box" && quarantine=true
      [[ -n "$items" ]] && items+=","
      items+="{\"workspace\":$(app_json_string "$box"),\"provider\":$(app_json_string "$provider"),\"configured\":$configured,\"accessMode\":$(app_json_string "$access"),\"verificationRepository\":$(app_json_optional "$repo"),\"capability\":$(app_json_string "$cap_state"),\"repos\":$(policy_repo_json "$box"),\"hostCredential\":$(app_json_string "$host_cred_state"),\"quarantined\":$quarantine}"
      continue
    fi
    configured=false
    repo=""
    access=""
    provider="none"
    account_login=""
    needs_restart=false
    if app_metadata_profile_present "$box" guest; then
      configured=true
      provider="$(app_metadata_value "$box" guest provider 2>/dev/null || true)"
      if [[ "$provider" != github-app-installation ]]; then
        provider="legacy-broad-token"
        access="unconfigured"
      else
        repo="$(app_metadata_value "$box" guest verificationRepository 2>/dev/null || true)"
        access="$(metadata_access "$box" 2>/dev/null || true)"
      fi
      account_login="$(app_metadata_value "$box" guest accountLogin 2>/dev/null || true)"
      installation_id="$(app_metadata_value "$box" guest installationID 2>/dev/null || true)"
      access_expires="$(app_metadata_value "$box" guest accessExpiresAt 2>/dev/null || true)"
      refresh_expires="$(app_metadata_value "$box" guest refreshExpiresAt 2>/dev/null || true)"
      needs_restart="$(app_metadata_value "$box" guest needsRestart 2>/dev/null || true)"
      if app_metadata_profile_present "$box" host; then
        host_access_expires="$(app_metadata_value "$box" host accessExpiresAt 2>/dev/null || true)"
        host_refresh_expires="$(app_metadata_value "$box" host refreshExpiresAt 2>/dev/null || true)"
        host_needs_restart="$(app_metadata_value "$box" host needsRestart 2>/dev/null || true)"
        [[ -n "$host_access_expires" && ( -z "$access_expires" || "$host_access_expires" < "$access_expires" ) ]] && access_expires="$host_access_expires"
        [[ -n "$host_refresh_expires" && ( -z "$refresh_expires" || "$host_refresh_expires" < "$refresh_expires" ) ]] && refresh_expires="$host_refresh_expires"
        [[ "$host_needs_restart" == true ]] && needs_restart=true
      fi
    elif [[ -f "$(metadata_file "$box")" ]]; then
      configured=true
      provider="legacy-pat"
      repo="$(metadata_repo "$box" 2>/dev/null || true)"
      access="$(metadata_access "$box" 2>/dev/null || true)"
    fi
    [[ "$needs_restart" == true ]] || needs_restart=false
    quarantine=false
    app_workspace_quarantined "$box" && quarantine=true
    [[ -n "$items" ]] && items+=","
    items+="{\"workspace\":$(app_json_string "$box"),\"provider\":$(app_json_string "$provider"),\"configured\":$configured,\"accessMode\":$(app_json_string "${access:-unconfigured}"),\"verificationRepository\":$(app_json_optional "$repo"),\"accountLogin\":$(app_json_optional "$account_login"),\"installationId\":$(app_json_optional "$installation_id"),\"accessExpiresAt\":$(app_json_optional "$access_expires"),\"refreshExpiresAt\":$(app_json_optional "$refresh_expires"),\"needsRestart\":$needs_restart,\"quarantined\":$quarantine}"
  done
  app_emit_success github-state "{\"workspaces\":[$items]}"
}

app_cmd_github_policy_get() {
  local target="all" box items="" entry
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error github-policy-get "missing value for --workspace"; target="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error github-policy-get "github-policy-get requires --format json"; shift 2 ;;
      *) app_usage_error github-policy-get "unknown github-policy-get option '$1'" ;;
    esac
  done
  if [[ "$target" != all ]]; then
    is_workspace "$target" || app_usage_error github-policy-get "workspace must be one of the configured workspaces"
  fi
  if ! policy_validate; then
    app_emit_error github-policy-get "MSW_POLICY_MISSING" "The GitHub policy file is missing or malformed." "Run 'msw github proxy-configure' or 'msw github migrate' to initialize it." "" false 78
  fi
  for box in "${WORKSPACES[@]}"; do
    [[ "$target" == all || "$target" == "$box" ]] || continue
    entry="{\"workspace\":$(app_json_string "$box"),\"capability\":$(app_json_optional "$(policy_workspace_capability "$box" 2>/dev/null || true)"),\"repos\":$(policy_repo_json "$box")}"
    [[ -n "$items" ]] && items+=","
    items+="$entry"
  done
  app_emit_success github-policy-get "{\"workspaces\":[$items]}"
}

# §8/§2: journaled atomic policy mutation, serialized on the per-workspace
# GitHub lock. Ordinary edits never regenerate the workspace capability.
app_cmd_github_policy_set() {
  local box="" repo="" mode="" action="set" canonical_repo="" cap repo_json mode_json
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error github-policy-set "missing value for --workspace"; box="$2"; shift 2 ;;
      --repository) [[ $# -ge 2 ]] || app_usage_error github-policy-set "missing value for --repository"; repo="$2"; shift 2 ;;
      --mode) [[ $# -ge 2 ]] || app_usage_error github-policy-set "missing value for --mode"; mode="$2"; shift 2 ;;
      --remove) action=remove; shift ;;
      --clear) action=clear; shift ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error github-policy-set "github-policy-set requires --format json"; shift 2 ;;
      *) app_usage_error github-policy-set "unknown github-policy-set option '$1'" ;;
    esac
  done
  is_workspace "$box" || app_usage_error github-policy-set "workspace must be one of the configured workspaces"
  case "$action" in
    set)
      app_valid_repository "$repo" || app_usage_error github-policy-set "repository must be OWNER/REPOSITORY"
      [[ "$mode" == read-only || "$mode" == read-write ]] || app_usage_error github-policy-set "mode must be read-only or read-write"
      ;;
    remove)
      app_valid_repository "$repo" || app_usage_error github-policy-set "repository must be OWNER/REPOSITORY"
      ;;
    clear) ;;
  esac
  if [[ "$MSW_GITHUB_MODE" != local ]]; then
    app_emit_error github-policy-set "MSW_GITHUB_MODE_MISMATCH" "GitHub policy edits are local-mode operations." "Switch MSW_GITHUB_MODE=local or use the Connect flow for connect-mode access." "$box" false 69
  fi
  [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] || app_emit_error github-policy-set "MSW_JSON_TOOL_UNAVAILABLE" "The policy editor requires jq." "Repair the MSW toolchain and retry the policy edit." "$box" true 69
  if ! github_lock_acquire "$box"; then
    app_emit_error github-policy-set "MSW_OPERATION_CONFLICT" "Another GitHub operation is already running for this workspace." "Wait for it to finish, then retry the policy edit." "$box" true 73
  fi
  if ! proxy_policy_ensure_workspace "$box" >/dev/null 2>&1; then
    app_emit_error github-policy-set "MSW_POLICY_WRITE_FAILED" "The GitHub policy file could not be initialized." "Repair the policy file and retry." "$box" true 69
  fi
  canonical_repo="$(canonicalize_github_repo "$repo")"
  policy_journal "$box" "$action" "started"
  case "$action" in
    set)
      if ! policy_atomic_write --arg w "$box" --arg r "$canonical_repo" --arg m "$mode" \
        '(.workspaces[$w].repos // []) as $repos | ($repos | map(select(.canonical != $r))) as $rest | .workspaces[$w].repos = ($rest + [{canonical: $r, mode: $m}])'; then
        policy_journal "$box" "$action" "failed"
        app_emit_error github-policy-set "MSW_POLICY_WRITE_FAILED" "The GitHub policy could not be updated." "Retry the policy edit." "$box" true 69
      fi
      ;;
    remove)
      if ! policy_atomic_write --arg w "$box" --arg r "$canonical_repo" \
        '.workspaces[$w].repos = ((.workspaces[$w].repos // []) | map(select(.canonical != $r)))'; then
        policy_journal "$box" "$action" "failed"
        app_emit_error github-policy-set "MSW_POLICY_WRITE_FAILED" "The GitHub policy could not be updated." "Retry the policy edit." "$box" true 69
      fi
      ;;
    clear)
      if ! policy_atomic_write --arg w "$box" '.workspaces[$w].repos = []'; then
        policy_journal "$box" "$action" "failed"
        app_emit_error github-policy-set "MSW_POLICY_WRITE_FAILED" "The GitHub policy could not be updated." "Retry the policy edit." "$box" true 69
      fi
      ;;
  esac
  policy_journal "$box" "$action" "committed"
  github_lock_release
  cap="$(policy_workspace_capability "$box" 2>/dev/null || true)"
  if [[ "$action" == clear ]]; then repo_json="null"; else repo_json="$(app_json_string "$canonical_repo")"; fi
  if [[ "$action" == set ]]; then mode_json="$(app_json_string "$mode")"; else mode_json="null"; fi
  app_emit_success github-policy-set \
    "{\"workspace\":$(app_json_string "$box"),\"action\":$(app_json_string "$action"),\"repository\":$repo_json,\"mode\":$mode_json,\"capability\":$(app_json_optional "$cap"),\"repos\":$(policy_repo_json "$box")}"
}

# ---------------------------------------------------------------------------
# §8/blocker 3: atomic full-policy apply. Reads the FULL desired policy JSON
# from stdin (never argv), validates it strictly, acquires every affected
# workspace's GitHub lock, provisions/verifies the transport (relay + guest
# config + shuttle) with the final capabilities BEFORE one atomic policy
# commit, and restores the pre-apply policy on any unproven step (typed
# error). Idempotent: re-applying the same desired state succeeds. The
# per-repo github-policy-set command remains the CLI fallback.
#
# Request (stdin, schema v1, full desired state):
#   {"schemaVersion":1,"workspaces":{"dev":{"repos":[{"canonical":"owner/name",
#    "mode":"read-only"|"read-write"}]}, ...}}
# Capabilities are optional in the request: a valid existing capability is
# preserved (transport continuity); otherwise one is minted. A workspace key
# missing from the request is cleared (deny).
# ---------------------------------------------------------------------------
MSW_APPLY_LOCKED=()
MSW_APPLY_LIFECYCLES=""
MSW_APPLY_RESTORE_FAILED_WORKSPACE=""

app_apply_remember_lifecycle() {
  local box="$1" lifecycle="$2"
  MSW_APPLY_LIFECYCLES="${MSW_APPLY_LIFECYCLES}${box}:${lifecycle} "
}

app_apply_restore_lifecycles() {
  local item box lifecycle observed failed=0
  MSW_APPLY_RESTORE_FAILED_WORKSPACE=""
  for item in $MSW_APPLY_LIFECYCLES; do
    box="${item%%:*}"
    lifecycle="${item#*:}"
    case "$lifecycle" in
      Running)
        observed="$(app_status_for_workspace "$box" 2>/dev/null || printf Unknown)"
        if [[ "$observed" != Running ]]; then
          ensure_running "$box" >/dev/null 2>&1 || {
            failed=1
            MSW_APPLY_RESTORE_FAILED_WORKSPACE="$box"
          }
        fi
        ;;
      Stopped|Exited)
        observed="$(app_status_for_workspace "$box" 2>/dev/null || printf Unknown)"
        if [[ "$observed" == Running || "$observed" == Starting || "$observed" == Restarting ]]; then
          workspace_msb "$box" stop -q -t 60 "$box" >/dev/null 2>&1 || {
            failed=1
            MSW_APPLY_RESTORE_FAILED_WORKSPACE="$box"
          }
        fi
        observed="$(app_status_for_workspace "$box" 2>/dev/null || printf Unknown)"
        [[ "$observed" == Stopped || "$observed" == Exited ]] || {
          failed=1
          MSW_APPLY_RESTORE_FAILED_WORKSPACE="$box"
        }
        ;;
      *) failed=1; MSW_APPLY_RESTORE_FAILED_WORKSPACE="$box" ;;
    esac
  done
  MSW_APPLY_LIFECYCLES=""
  (( failed == 0 ))
}

app_apply_cancel_trap() {
  local status="$1"
  trap - EXIT INT TERM HUP
  app_apply_restore_lifecycles >/dev/null 2>&1 || true
  app_apply_release_all
  policy_journal all apply cancelled >/dev/null 2>&1 || true
  exit "$status"
}

app_apply_release_all() {
  local lock_entry fd
  # bash 3.2 + set -u: a declared-but-empty array is still "set", so the
  # ${arr[@]+...} guard does NOT protect the expansion; check the length
  # (the EXIT trap always calls this, including on error paths).
  if (( ${#MSW_APPLY_LOCKED[@]} > 0 )); then
    for lock_entry in "${MSW_APPLY_LOCKED[@]}"; do
      fd="${lock_entry##*:}"
      eval "exec ${fd}>&-" 2>/dev/null || true
    done
  fi
  MSW_APPLY_LOCKED=()
  if [[ -n "$MSW_APPLY_SNAPSHOT" ]]; then
    rm -f "$MSW_APPLY_SNAPSHOT" 2>/dev/null || true
    MSW_APPLY_SNAPSHOT=""
  fi
}

# Acquire every configured workspace's GitHub lock in configuration order
# (the same stable order in every process, so no deadlock), because the apply
# replaces the FULL workspaces object — omitted workspaces are cleared, so a
# concurrent per-repo edit of any workspace must serialize against the apply.
# Uses a distinct descriptor starting at 10 for each configured workspace
# (fd 9 is the single-workspace lock used elsewhere).
app_apply_lock_all() {
  local request="$1" box fd=10 lock
  MSW_APPLY_LOCKED=()
  [[ -n "${LOCKF_BIN:-}" && -x "${LOCKF_BIN:-}" ]] || return 1
  mkdir -p "$GITHUB_META_DIR" || return 1
  chmod 700 "$GITHUB_META_DIR" || return 1
  for box in "${WORKSPACES[@]}"; do
    lock="$(github_lock_file "$box")"
    if [[ -d "$lock" ]]; then
      if ! github_lock_reclaim_legacy "$lock"; then
        app_apply_release_all
        return 1
      fi
    fi
    if ! eval "exec ${fd}>>\"$lock\""; then app_apply_release_all; return 1; fi
    if ! "$LOCKF_BIN" -s -t 30 "$fd"; then
      eval "exec ${fd}>&-"
      app_apply_release_all
      return 1
    fi
    printf '%s\n' "$$" >"$lock"
    MSW_APPLY_LOCKED+=("${box}:${fd}")
    fd=$((fd + 1))
  done
  return 0
}

# Snapshot the policy file byte-exactly (cp, preserving the trailing newline)
# AFTER the locks are held, so no concurrent writer can interleave. The
# snapshot is removed when the apply finishes (success or failure).
MSW_APPLY_SNAPSHOT=""
app_apply_snapshot() {
  local file="$1"
  file="$(policy_file)"
  MSW_APPLY_SNAPSHOT="$file.snapshot.$$"
  mkdir -p "$(dirname "$file")" || { MSW_APPLY_SNAPSHOT=""; return 1; }
  rm -f "$MSW_APPLY_SNAPSHOT" 2>/dev/null || true
  if [[ -f "$file" && ! -L "$file" ]]; then
    cp -p "$file" "$MSW_APPLY_SNAPSHOT" 2>/dev/null || { MSW_APPLY_SNAPSHOT=""; return 1; }
    printf '1'
  else
    : >"$MSW_APPLY_SNAPSHOT"
    printf '0'
  fi
}

# Restore the pre-apply policy from the byte-exact snapshot (locks still
# held); a failed restore means the typed error must name the policy path for
# manual repair.
app_apply_rollback_policy() {
  local file="$1" old_exists="$2" tmp
  file="$(policy_file)"
  if [[ -n "$MSW_APPLY_SNAPSHOT" && -f "$MSW_APPLY_SNAPSHOT" ]]; then
    if (( old_exists )); then
      tmp="$file.tmp.$$"
      umask 077
      if cp "$MSW_APPLY_SNAPSHOT" "$tmp" 2>/dev/null &&
        chmod 600 "$tmp" 2>/dev/null &&
        fsync_path "$tmp" file 2>/dev/null &&
        mv "$tmp" "$file" 2>/dev/null; then
        return 0
      fi
      rm -f "$tmp" 2>/dev/null || true
      return 1
    fi
    rm -f "$file" 2>/dev/null || true
    [[ ! -e "$file" && ! -L "$file" ]]
  fi
}

# Bounded end-to-end transport readiness (re-review item 3): before the
# policy commit, prove the guest can route to the MSW proxy through the
# relay/shuttle. proxy_guest_configure already proved the exact insteadOf /
# extraHeader git configuration. The deliberate probe is a bare info/refs
# request (no service= param): smart-HTTP's missing-service deny is HTTP 403
# with the "msw-proxy:" body, so a 403 + marker proves only that the
# malformed request traversed relay -> shuttle -> proxy. It is independent
# of policy or credential grants and does not verify the capability itself.
# ensures/repairs the host proxy LaunchAgent first. Test seams:
# MSW_FAKE_TRANSPORT_PROBE=403|fail models ONLY the expected deny (the fake
# msb stubs the relay); MSW_TRANSPORT_PROBE_PORT overrides the probe port.
app_apply_verify_transport() {
  local box="$1" capability="$2" code="" body="" probe_repo="" probe_url="" port body_and_code
  if [[ "${MSW_TEST_MODE:-0}" != 1 ]]; then
    if ! github_proxy_launchd_loaded; then
      github_proxy_render_plist || return 1
      /bin/launchctl bootout "gui/$(id -u)/$(github_proxy_launchd_label)" >/dev/null 2>&1 || true
      /bin/launchctl bootstrap "gui/$(id -u)" "$(github_proxy_plist_file)" || return 1
    fi
  fi
  if [[ -n "${MSW_FAKE_TRANSPORT_PROBE:-}" ]]; then
    # only the expected deny (403) counts as ready; any other modeled code
    # (200/404/500/503) must fail the probe
    [[ "$MSW_FAKE_TRANSPORT_PROBE" == 403 ]]
    return
  fi
  probe_repo="$(policy_first_ticked_repo "$box" 2>/dev/null || true)"
  [[ -n "$probe_repo" ]] || probe_repo="acme/demo"
  port="${MSW_TRANSPORT_PROBE_PORT:-${MSW_GITHUB_PROXY_PORT:-18446}}"
  # No service= param: the bare info/refs intentionally omits the required
  # service argument, so the proxy's missing-service deny (HTTP 403 +
  # "msw-proxy:") is expected when the malformed request reached it.
  probe_url="http://127.0.0.1:${port}/github.com/${probe_repo}.git/info/refs"
  body_and_code="$(guest_exec_ready "$box" curl -sS -w '\n%{http_code}' --max-time 10 \
    -H "X-MSW-Capability: $capability" "$probe_url" 2>/dev/null || true)"
  code="${body_and_code##*$'\n'}"
  body="${body_and_code%$'\n'*}"
  [[ "$code" == 403 && "$body" == *"msw-proxy:"* ]]
}

# Provision + verify the transport for one workspace with its FINAL
# capability. Runs inside a command substitution so any fatal() (quarantine /
# start failure) converts to a typed error instead of aborting the envelope.
app_apply_provision_transport() {
  local box="$1" capability="$2" lock_entry lock_fd
  # The parent holds every configured workspace lock. The shuttle spawned here
  # must NOT inherit them: an inherited fd would pin the flock for the
  # shuttle's lifetime and deadlock the next apply.
  for lock_entry in "${MSW_APPLY_LOCKED[@]}"; do
    lock_fd="${lock_entry##*:}"
    eval "exec ${lock_fd}>&-" 2>/dev/null || true
  done
  if app_workspace_quarantined "$box"; then
    printf 'msw: workspace %s is quarantined\n' "$box" >&2
    return 1
  fi
  if [[ "${MSW_FAKE_APPLY_PROVISION_FAIL:-}" == "$box" ]]; then
    printf 'msw: transport provisioning failure injected for %s\n' "$box" >&2
    return 1
  fi
  if ! sandbox_exists "$box"; then
    printf 'msw: workspace %s does not exist\n' "$box" >&2
    return 1
  fi
  ensure_running "$box" || { printf 'MSW_APPLY_STAGE=starting\n' >&2; return 1; }
  # Test-only cancellation seam: production has no pause. The parent command
  # already recorded the prior lifecycle and holds the apply locks here.
  if [[ -n "${MSW_FAKE_APPLY_PROVISION_PAUSE_FILE:-}" ]]; then
    [[ -n "${MSW_FAKE_APPLY_PROVISION_PAUSE_REACHED:-}" ]] &&
      : >"$MSW_FAKE_APPLY_PROVISION_PAUSE_REACHED"
    while [[ -e "$MSW_FAKE_APPLY_PROVISION_PAUSE_FILE" ]]; do sleep 0.1; done
  fi
  proxy_install_relay "$box" || { printf 'MSW_APPLY_STAGE=relay\n' >&2; return 1; }
  proxy_guest_configure "$box" "$capability" || { printf 'MSW_APPLY_STAGE=configuring\n' >&2; return 1; }
  proxy_shuttle_start "$box" || { printf 'MSW_APPLY_STAGE=shuttle\n' >&2; return 1; }
  # readiness: a bounded end-to-end relay/proxy routing probe (the
  # missing-service 403 confirms routing; proxy_guest_configure already
  # proved the git rewrite/extraHeader, so the probe does not verify the
  # capability)
  if ! app_apply_verify_transport "$box" "$capability"; then
    # A live pid is not sufficient health evidence. Restart once when the
    # bounded end-to-end routing probe fails, then require it to pass
    # before policy activation.
    proxy_shuttle_start "$box" 1 || { printf 'MSW_APPLY_STAGE=shuttle\n' >&2; return 1; }
    app_apply_verify_transport "$box" "$capability" || { printf 'MSW_APPLY_STAGE=verifying\n' >&2; return 1; }
  fi
  return 0
}

app_cmd_github_policy_apply() {
  local request="" old_exists=0 failed=0 box cap caps_json="" sep="" items="" \
        final_policy="" file tmp output="" format="" lifecycle="" changed="" \
        changed_boxes="" provision_boxes="" failure_code="" failure_message="" \
        failure_recovery=""
  while (( $# > 0 )); do
    case "$1" in
      --format) [[ "${2:-}" == json ]] || app_usage_error github-policy-apply "github-policy-apply requires --format json"; shift 2 ;;
      *) app_usage_error github-policy-apply "unknown github-policy-apply option '$1'" ;;
    esac
  done
  if [[ "$MSW_GITHUB_MODE" != local ]]; then
    app_emit_error github-policy-apply "MSW_GITHUB_MODE_MISMATCH" \
      "GitHub policy apply is a local-mode operation." \
      "Switch MSW_GITHUB_MODE=local or use the Connect flow for connect-mode access." "" false 69
    return
  fi
  app_require_config github-policy-apply
  app_require_runtime github-policy-apply
  [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] || {
    app_emit_error github-policy-apply "MSW_JSON_TOOL_UNAVAILABLE" "The policy editor requires jq." "Repair the MSW toolchain and retry the policy apply." "" true 69
    return
  }
  if ! command -v openssl >/dev/null 2>&1; then
    app_emit_error github-policy-apply "MSW_JSON_TOOL_UNAVAILABLE" "openssl is required to mint workspace capabilities." "Repair the MSW toolchain and retry the policy apply." "" true 69
    return
  fi
  [[ -f "$SHUTTLE_BIN" && -f "$RELAY_BIN" ]] || {
    app_emit_error github-policy-apply "MSW_TRANSPORT_UNAVAILABLE" "The GitHub transport scripts are missing." "Rerun setup.sh to install the relay and shuttle." "" true 69
    return
  }
  if [[ -t 0 ]]; then
    app_emit_error github-policy-apply "MSW_INVALID_REQUEST" \
      "github-policy-apply reads the full desired policy JSON from stdin." \
      "Pipe the schema-v1 policy JSON to the command's stdin." "" false 64
    return
  fi
  request="$(cat 2>/dev/null || true)"
  # Strict request validation (capabilities optional; the CLI preserves or
  # mints them). A workspace key missing from the request is cleared.
  local configured
  configured="$(printf '%s\n' "${WORKSPACES[@]}" | "$JQ_BIN" -Rsc 'split("\n")[:-1]')"
  if ! printf '%s\n' "$request" | "$JQ_BIN" -e --argjson configured "$configured" '
      .schemaVersion == 1 and
      (.workspaces | type == "object") and
      ((([.workspaces | keys[]] - $configured) | length) == 0) and
      ([.workspaces[] |
        ((.capability // "") == "" or (.capability | type == "string" and test("^[0-9a-f]{48}$"))) and
        (.repos | type == "array") and
        ([.repos[] |
          (.canonical | type == "string") and
          (.canonical | test("^[a-z0-9][a-z0-9_.-]*/[a-z0-9][a-z0-9_.-]*$")) and
          ((.canonical | endswith(".git")) | not) and
          (.mode == "read-only" or .mode == "read-write")
        ] | all) and
        ([.repos[].canonical] | unique | length) == ([.repos[].canonical] | length)
      ] | all)
    ' >/dev/null 2>&1; then
    app_emit_error github-policy-apply "MSW_INVALID_REQUEST" \
      "The desired policy JSON on stdin failed strict validation." \
      "Send schema-v1 workspaces with canonical owner/name repos, valid modes, and no duplicates." "" false 64
    return
  fi

  policy_journal all apply started

  # Lock every configured workspace first (the apply replaces the full workspaces
  # object, so no concurrent per-repo edit may interleave), then snapshot the
  # policy byte-exactly (cp, preserving the trailing newline) under the locks.
  if ! app_apply_lock_all "$request"; then
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_OPERATION_CONFLICT" \
      "Another GitHub operation is already running for a workspace." \
      "Wait for it to finish, then retry the policy apply." "" true 73
    return
  fi
  trap 'app_apply_release_all' EXIT
  trap 'app_apply_cancel_trap 130' INT
  trap 'app_apply_cancel_trap 143' TERM
  trap 'app_apply_cancel_trap 129' HUP
  file="$(policy_file)"
  old_exists="$(app_apply_snapshot "$file")" || {
    app_apply_release_all
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_POLICY_WRITE_FAILED" "The current GitHub policy could not be snapshotted for the apply." "Repair the policy file and retry." "" true 69
    return
  }

  # Final capabilities: a valid existing capability is preserved; else mint.
  caps_json="{"
  sep=""
  for box in "${WORKSPACES[@]}"; do
    "$JQ_BIN" -e --arg w "$box" '.workspaces | has($w)' <<<"$request" >/dev/null 2>&1 || continue
    cap="$(policy_workspace_capability "$box" 2>/dev/null || true)"
    if [[ ! "$cap" =~ ^[0-9a-f]{48}$ ]]; then
      cap="$(openssl rand -hex 24)" || {
        app_apply_release_all
        policy_journal all apply failed
        app_emit_error github-policy-apply "MSW_POLICY_WRITE_FAILED" "A workspace capability could not be generated." "Retry the policy apply." "$box" true 69
        return
      }
    fi
    caps_json+="${sep}$(app_json_string "$box"):$(app_json_string "$cap")"
    sep=","
  done
  caps_json+="}"

  # Compute the semantic delta under the same locks as the final commit.
  # Capability-only differences are intentionally ignored: the effective
  # capability remains stable and repository intent is the access contract.
  for box in "${WORKSPACES[@]}"; do
    changed=true
    if policy_validate && "$JQ_BIN" -e --arg w "$box" --argjson req "$request" '
      ((.workspaces[$w].repos // []) | sort_by(.canonical, .mode)) ==
      (($req.workspaces[$w].repos // []) | sort_by(.canonical, .mode))
    ' "$(policy_file)" >/dev/null 2>&1; then
      changed=false
    fi
    if [[ "$changed" == true ]]; then
      changed_boxes="${changed_boxes}${box} "
      if "$JQ_BIN" -e --arg w "$box" '.workspaces[$w].repos | length > 0' <<<"$request" >/dev/null 2>&1; then
        provision_boxes="${provision_boxes}${box} "
      fi
    fi
  done

  # Exact semantic no-op: do not start a VM, copy a relay, rewrite Git config,
  # restart a shuttle, or rewrite the effective policy.
  if [[ -z "$changed_boxes" ]]; then
    policy_journal all apply completed
    app_apply_release_all
    trap - EXIT INT TERM HUP
    items=""
    for box in "${WORKSPACES[@]}"; do
      cap="$(policy_workspace_capability "$box" 2>/dev/null || true)"
      [[ -n "$items" ]] && items+=","
      items+="{\"workspace\":$(app_json_string "$box"),\"capability\":$(app_json_optional "$cap"),\"repos\":$(policy_repo_json "$box")}"
    done
    app_emit_success github-policy-apply \
      "{\"applied\":true,\"provisioned\":true,\"committed\":true,\"workspaces\":[$items]}"
    return
  fi

  # Provision + verify only semantically changed, non-empty workspaces BEFORE the
  # single atomic policy commit. A provisioning/readiness failure changes NO
  # policy — so the pre-apply snapshot is NEVER restored (nothing to restore);
  # the typed error is returned with the policy file untouched.
  for box in $provision_boxes; do
    lifecycle="$(app_status_for_workspace "$box" 2>/dev/null || printf Unknown)"
    if [[ "$lifecycle" == Unknown || "$lifecycle" == Starting || "$lifecycle" == Stopping || "$lifecycle" == Restarting ]]; then
      app_apply_restore_lifecycles >/dev/null 2>&1 || true
      app_apply_release_all
      policy_journal all apply failed
      app_emit_error github-policy-apply "MSW_STATE_UNAVAILABLE" \
        "Workspace $box has no stable lifecycle to snapshot before GitHub reconciliation." \
        "Wait for the workspace lifecycle to settle, then retry." "$box" true 69
      return
    fi
    app_apply_remember_lifecycle "$box" "$lifecycle"
    cap="$(printf '%s' "$caps_json" | "$JQ_BIN" -r --arg w "$box" '.[$w]')"
    if ! output="$(app_apply_provision_transport "$box" "$cap" 2>&1)"; then
      if ! app_apply_restore_lifecycles >/dev/null 2>&1; then
        app_apply_release_all
        policy_journal all apply failed
        app_emit_error github-policy-apply "MSW_LIFECYCLE_RESTORE_FAILED" \
          "GitHub transport failed and workspace $MSW_APPLY_RESTORE_FAILED_WORKSPACE could not return to its prior lifecycle; the policy was NOT changed." \
          "Repair the affected workspace lifecycle, then retry reconciliation." "$MSW_APPLY_RESTORE_FAILED_WORKSPACE" true 77
        return
      fi
      app_apply_release_all
      policy_journal all apply failed
      case "$output" in
        *MSW_APPLY_STAGE=starting*)
          failure_code="MSW_WORKSPACE_START_FAILED"
          failure_message="Workspace $box could not be started for GitHub reconciliation; the policy was NOT changed."
          failure_recovery="Check the workspace runtime and retry when its lifecycle is stable."
          ;;
        *MSW_APPLY_STAGE=relay*)
          failure_code="MSW_RELAY_INSTALL_FAILED"
          failure_message="The GitHub relay could not be installed in workspace $box; the policy was NOT changed."
          failure_recovery="Repair workspace file access, then retry GitHub reconciliation."
          ;;
        *MSW_APPLY_STAGE=configuring*)
          failure_code="MSW_GIT_CONFIG_FAILED"
          failure_message="Git transport configuration could not be verified in workspace $box; the policy was NOT changed."
          failure_recovery="Check Git configuration access in the workspace, then retry."
          ;;
        *MSW_APPLY_STAGE=shuttle*)
          failure_code="MSW_SHUTTLE_START_FAILED"
          failure_message="The GitHub shuttle could not be started for workspace $box; the policy was NOT changed."
          failure_recovery="Check the local shuttle runtime and retry GitHub reconciliation."
          ;;
        *MSW_APPLY_STAGE=verifying*)
          failure_code="MSW_TRANSPORT_VERIFY_FAILED"
          failure_message="GitHub transport readiness could not be verified for workspace $box; the policy was NOT changed."
          failure_recovery="Check the local proxy and workspace network, then retry."
          ;;
        *)
          failure_code="MSW_TRANSPORT_PROVISION_FAILED"
          failure_message="GitHub proxy transport could not be provisioned for workspace $box; the policy was NOT changed."
          failure_recovery="Check the workspace runtime and retry the policy apply."
          ;;
      esac
      app_emit_error github-policy-apply "$failure_code" \
        "$failure_message" "$failure_recovery" "$box" true 77
      return
    fi
  done

  # Provisioning may have started stopped/exited workspaces. Restore the
  # exact running-vs-not-running lifecycle before activating access.
  if ! app_apply_restore_lifecycles; then
    app_apply_release_all
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_LIFECYCLE_RESTORE_FAILED" \
      "GitHub transport was configured, but a workspace lifecycle could not be restored." \
      "Repair the affected workspace lifecycle, then retry reconciliation." "$MSW_APPLY_RESTORE_FAILED_WORKSPACE" true 77
    return
  fi
  # Test seam: park here (locks still held) so a test can prove concurrent
  # per-repo edits are serialized against the apply
  # (MSW_FAKE_APPLY_PAUSE_REACHED marks the park).
  if [[ -n "${MSW_FAKE_APPLY_PAUSE_FILE:-}" ]]; then
    if [[ -n "${MSW_FAKE_APPLY_PAUSE_REACHED:-}" ]]; then
      : >"$MSW_FAKE_APPLY_PAUSE_REACHED"
    fi
    while [[ -e "$MSW_FAKE_APPLY_PAUSE_FILE" ]]; do sleep 0.1; done
  fi

  # ONE atomic policy commit (tmp + fsync + rename, 0600). -n: the full
  # request/caps come from --argjson; stdin was already consumed by `cat`.
  final_policy="$("$JQ_BIN" -nc --argjson req "$request" --argjson caps "$caps_json" '
    {schemaVersion: 1,
     workspaces: (($req.workspaces // {}) | with_entries(
       .value = {capability: ($caps[.key] // ""), repos: (.value.repos // [])}
     ))}
  ')" || {
    app_apply_rollback_policy "$file" "$old_exists" >/dev/null 2>&1 || true
    app_apply_release_all
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_POLICY_WRITE_FAILED" "The final desired policy could not be composed." "Retry the policy apply." "" true 69
    return
  }
  if ! policy_json_valid "$final_policy"; then
    app_apply_rollback_policy "$file" "$old_exists" >/dev/null 2>&1 || true
    app_apply_release_all
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_INVALID_REQUEST" "The composed final policy failed strict validation." "Retry the policy apply with a valid request." "" false 64
    return
  fi
  tmp="$file.tmp.$$"
  if ! mkdir -p "$(dirname "$file")"; then
    app_apply_rollback_policy "$file" "$old_exists" >/dev/null 2>&1 || true
    app_apply_release_all
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_POLICY_WRITE_FAILED" "The GitHub policy directory could not be created." "Repair the policy directory permissions and retry." "" true 69
    return
  fi
  chmod 700 "$(dirname "$file")" 2>/dev/null || true
  umask 077
  if ! printf '%s\n' "$final_policy" >"$tmp" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null || true
    app_apply_rollback_policy "$file" "$old_exists" >/dev/null 2>&1 || true
    app_apply_release_all
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_POLICY_WRITE_FAILED" "The GitHub policy could not be written." "Repair the policy directory permissions and retry." "" true 69
    return
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  if ! fsync_path "$tmp" file; then
    rm -f "$tmp" 2>/dev/null || true
    app_apply_rollback_policy "$file" "$old_exists" >/dev/null 2>&1 || true
    app_apply_release_all
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_POLICY_WRITE_FAILED" "The GitHub policy could not be made durable." "Retry the policy apply." "" true 69
    return
  fi
  if ! mv "$tmp" "$file" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null || true
    app_apply_rollback_policy "$file" "$old_exists" >/dev/null 2>&1 || true
    app_apply_release_all
    policy_journal all apply failed
    app_emit_error github-policy-apply "MSW_POLICY_WRITE_FAILED" "The GitHub policy could not be committed atomically." "Retry the policy apply." "" true 69
    return
  fi
  fsync_path "$(dirname "$file")" dir || true
  policy_journal all apply committed
  app_apply_release_all
  trap - EXIT INT TERM HUP

  items=""
  for box in "${WORKSPACES[@]}"; do
    "$JQ_BIN" -e --arg w "$box" '.workspaces | has($w)' <<<"$request" >/dev/null 2>&1 || continue
    cap="$(printf '%s' "$caps_json" | "$JQ_BIN" -r --arg w "$box" '.[$w]')"
    [[ -n "$items" ]] && items+=","
    items+="{\"workspace\":$(app_json_string "$box"),\"capability\":$(app_json_string "$cap"),\"repos\":$(policy_repo_json "$box")}"
  done
  app_emit_success github-policy-apply \
    "{\"applied\":true,\"provisioned\":true,\"committed\":true,\"workspaces\":[$items]}"
}

app_cmd_github_bind() {
  local box="" repo="" mode="read-only" before="Unknown" after="Unknown" verify_output="" legacy_file=""
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error github-bind "missing value for --workspace"; box="$2"; shift 2 ;;
      --repository) [[ $# -ge 2 ]] || app_usage_error github-bind "missing value for --repository"; repo="$2"; shift 2 ;;
      --mode) [[ $# -ge 2 ]] || app_usage_error github-bind "missing value for --mode"; mode="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error github-bind "github-bind requires --format json"; shift 2 ;;
      *) app_usage_error github-bind "unknown github-bind option '$1'" ;;
    esac
  done
  is_workspace "$box" || app_usage_error github-bind "workspace must be one of the configured workspaces"
  app_valid_repository "$repo" || app_usage_error github-bind "repository must be OWNER/REPOSITORY"
  [[ "$mode" == host-write || "$mode" == read-only ]] ||
    app_usage_error github-bind "mode must be host-write or read-only"
  # Path C §1: local mode refuses the Connect bind flow with a typed
  # mode-mismatch error; access is configured through the policy file.
  if [[ "$MSW_GITHUB_MODE" == local ]]; then
    app_emit_error github-bind "MSW_GITHUB_MODE_MISMATCH" \
      "GitHub bind is not available in local mode." \
      "Local mode uses the repo-aware GitHub proxy; configure access with 'msw github proxy-configure'." "$box" false 69
  fi
  app_require_config github-bind
  app_require_runtime github-bind
  require_repository_access "$box" "$repo" guest
  if [[ "$mode" == host-write ]]; then
    require_repository_access "$box" "$repo" host
  fi
  app_metadata_profile_present "$box" guest ||
    app_emit_error github-bind "MSW_GITHUB_CREDENTIAL_MISSING" "Guest GitHub authorization is not committed." "Authorize guest access in MSW Monitor first." "$box" false 77
  app_credential_available "$box" guest ||
    app_emit_error github-bind "MSW_GITHUB_CREDENTIAL_MISSING" "The guest GitHub credential is unavailable." "Authorize guest access again in MSW Monitor." "$box" false 77
  if [[ "$mode" == host-write ]]; then
    app_metadata_profile_present "$box" host ||
      app_emit_error github-bind "MSW_GITHUB_CREDENTIAL_MISSING" "Host GitHub authorization is not committed." "Authorize host write access in MSW Monitor first." "$box" false 77
    app_credential_available "$box" host ||
      app_emit_error github-bind "MSW_GITHUB_CREDENTIAL_MISSING" "The host GitHub credential is unavailable." "Authorize host write access again in MSW Monitor." "$box" false 77
  fi
  before="$(app_status_for_workspace "$box" 2>/dev/null || printf 'Unknown')"
  [[ "$before" != Unknown ]] || app_emit_error github-bind "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed before credential binding." "Repair state observation and authorize again." "$box" true 69
  if ! github_lock_acquire "$box"; then
    app_emit_error github-bind "MSW_OPERATION_CONFLICT" "Another GitHub operation is already running for this workspace." "Wait for it to finish, then authorize again." "$box" true 73
  fi
  if ! quarantine_workspace "$box" "GitHub App credential binding pending verification" >/dev/null 2>&1; then
    app_emit_error github-bind "MSW_GITHUB_QUARANTINE_FAILED" "MSW could not prove the workspace safe before binding credentials." "Repair the quarantined workspace before authorizing again." "$box" false 77
  fi
  if ! verify_output="$(MSW_ALLOW_QUARANTINED=1 MSW_GITHUB_VERIFY_INHERITED=1 "${MSW_SELF_BIN:-$0}" __github-verify-transaction "$box" "$repo" "$mode" 2>&1)"; then
    quarantine_workspace "$box" "GitHub App credential verification failed" >/dev/null 2>&1 || true
    app_emit_error github-bind "MSW_GITHUB_BIND_FAILED" "GitHub permissions could not be verified and the workspace remains quarantined." "Review the repository and GitHub App permissions, then authorize again." "$box" true 77
  fi
  after="$(app_status_for_workspace "$box" 2>/dev/null || printf 'Unknown')"
  if [[ "$before" == Stopped || "$before" == Exited ]] && [[ "$after" == Running ]]; then
    if ! workspace_msb "$box" stop -q -t 60 "$box" >/dev/null 2>&1; then
      quarantine_workspace "$box" "GitHub verification lifecycle restoration failed" >/dev/null 2>&1 || true
      app_emit_error github-bind "MSW_GITHUB_BIND_RECONCILE_FAILED" "GitHub verification completed but the workspace could not be returned to its prior stopped state." "Repair the quarantined workspace before continuing." "$box" true 69
    fi
    after="$(app_status_for_workspace "$box" 2>/dev/null || printf 'Unknown')"
  fi
  if [[ "$before" == Running && "$after" != Running ]] ||
    { [[ "$before" == Stopped || "$before" == Exited ]] && [[ "$after" != Stopped ]]; }; then
    quarantine_workspace "$box" "GitHub verification outcome could not be reconciled" >/dev/null 2>&1 || true
    app_emit_error github-bind "MSW_GITHUB_BIND_RECONCILE_FAILED" "GitHub verification exited without restoring the previously observed lifecycle." "Repair the quarantined workspace before continuing." "$box" true 69
  fi
  legacy_file="$(metadata_file "$box")"
  if [[ -e "$legacy_file" || -L "$legacy_file" ]]; then
    if [[ -L "$legacy_file" ]] || ! rm -f "$legacy_file" || [[ -e "$legacy_file" || -L "$legacy_file" ]]; then
      quarantine_workspace "$box" "Legacy GitHub metadata cleanup failed" >/dev/null 2>&1 || true
      app_emit_error github-bind "MSW_GITHUB_LEGACY_CLEANUP_FAILED" "GitHub verification succeeded but legacy capability metadata could not be removed." "Repair the quarantined credential configuration before continuing." "$box" false 77
    fi
  fi
  if ! clear_quarantine "$box"; then
    quarantine_workspace "$box" "GitHub verification quarantine cleanup failed" >/dev/null 2>&1 || true
    app_emit_error github-bind "MSW_GITHUB_QUARANTINE_FAILED" "GitHub verification succeeded but quarantine cleanup could not be proven." "Repair the quarantined workspace before continuing." "$box" false 77
  fi
  github_lock_release
  app_emit_success github-bind "{\"workspace\":$(app_json_string "$box"),\"accessMode\":$(app_json_string "$mode"),\"verificationRepository\":$(app_json_string "$repo"),\"verified\":true,\"lifecycleRestored\":true}"
}

app_cmd_github_quarantine() {
  local box=""
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error github-quarantine "missing value for --workspace"; box="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error github-quarantine "github-quarantine requires --format json"; shift 2 ;;
      *) app_usage_error github-quarantine "unknown github-quarantine option '$1'" ;;
    esac
  done
  is_workspace "$box" || app_usage_error github-quarantine "workspace must be one of the configured workspaces"
  app_require_config github-quarantine
  app_require_runtime github-quarantine
  if ! github_lock_acquire "$box"; then
    app_emit_error github-quarantine "MSW_OPERATION_CONFLICT" "Another GitHub operation is already running for this workspace." "Wait for it to finish, then retry fail-closed quarantine." "$box" true 73
  fi
  quarantine_workspace "$box" "Native credential transaction requires repair" >/dev/null 2>&1 ||
    app_emit_error github-quarantine "MSW_GITHUB_QUARANTINE_FAILED" "The workspace was marked quarantined, but a stopped lifecycle could not be proven." "Inspect the workspace runtime before any further credential operation." "$box" false 77
  github_lock_release
  app_emit_success github-quarantine "{\"workspace\":$(app_json_string "$box"),\"quarantined\":true,\"lifecycle\":\"Stopped\"}"
}
app_cmd_github_unbind() {
  local box="" legacy_file="" cleanup_failed=0
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error github-unbind "missing value for --workspace"; box="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error github-unbind "github-unbind requires --format json"; shift 2 ;;
      *) app_usage_error github-unbind "unknown github-unbind option '$1'" ;;
    esac
  done
  is_workspace "$box" || app_usage_error github-unbind "workspace must be one of the configured workspaces"
  # Path C §1: local mode refuses the Connect unbind flow with a typed
  # mode-mismatch error; local mode never binds GitHub secrets.
  if [[ "$MSW_GITHUB_MODE" == local ]]; then
    app_emit_error github-unbind "MSW_GITHUB_MODE_MISMATCH" \
      "GitHub unbind is not available in local mode." \
      "Local mode never binds GitHub secrets; remove access through the policy file." "$box" false 69
  fi
  app_require_config github-unbind
  app_require_runtime github-unbind
  if ! github_lock_acquire "$box"; then
    app_emit_error github-unbind "MSW_OPERATION_CONFLICT" "Another GitHub operation is already running for this workspace." "Wait for it to finish, then retry workspace credential removal." "$box" true 73
  fi
  if ! remove_github_secret "$box"; then
    quarantine_workspace "$box" "GitHub App credential unbinding failed" >/dev/null 2>&1 || true
    github_lock_release
    app_emit_error github-unbind "MSW_GITHUB_UNBIND_FAILED" "The VM GitHub secret could not be removed and the workspace remains quarantined." "Repair the workspace, then retry removing GitHub access." "$box" true 77
  fi
  # A workspace still looks GitHub-configured to bootstrap's reconnect check
  # while its legacy capability file or legacy Keychain records survive, so
  # disabling GitHub access removes all of them. Every step is fail-closed: an
  # unproven deletion quarantines the workspace and reports a typed error so a
  # retry can prove cleanup. Symlinks are rejected exactly like github-bind.
  legacy_file="$(metadata_file "$box")"
  if [[ -e "$legacy_file" || -L "$legacy_file" ]]; then
    if [[ -L "$legacy_file" ]] || ! rm -f "$legacy_file" || [[ -e "$legacy_file" || -L "$legacy_file" ]]; then
      cleanup_failed=1
    fi
  fi
  if ! keychain_delete "$READ_KEYCHAIN_SERVICE" "$box"; then cleanup_failed=1; fi
  if ! keychain_delete "$WRITE_KEYCHAIN_SERVICE" "$box"; then cleanup_failed=1; fi
  if (( cleanup_failed )); then
    quarantine_workspace "$box" "Legacy GitHub configuration cleanup failed" >/dev/null 2>&1 || true
    github_lock_release
    app_emit_error github-unbind "MSW_GITHUB_LEGACY_CLEANUP_FAILED" "GitHub access was unbound but legacy capability metadata or Keychain credentials could not be removed." "Repair the legacy GitHub configuration, then retry removing GitHub access." "$box" true 77
  fi
  # A prior failed unbind quarantined the workspace; a successful retry must
  # clear that marker or bootstrap deep verification still fails.
  if ! clear_quarantine "$box"; then
    github_lock_release
    app_emit_error github-unbind "MSW_GITHUB_QUARANTINE_FAILED" "GitHub access was removed but the workspace quarantine could not be cleared." "Repair the quarantined workspace, then retry removing GitHub access." "$box" true 77
  fi
  github_lock_release
  app_emit_success github-unbind "{\"workspace\":$(app_json_string "$box"),\"unbound\":true}"
}

app_guest_repository_scan() {

  local box="$1" include_status="$2" credential_state="$3" quarantine_state="$4" requested_path="${5-}" script
  read -r -d '' script <<'SCRIPT' || true
set -Eeuo pipefail
include_status="$1"
credential_state="$2"
quarantine_state="$3"
requested_path="${4-}"
root="${MSW_GUEST_WORKSPACE_ROOT:-/workspace}"

json_escape() {
  local value="${1-}" escaped="" char code index
  LC_ALL=C
  for ((index = 0; index < ${#value}; index++)); do
    char="${value:index:1}"
    case "$char" in
      '"') escaped="${escaped}\\\"" ;;
      "\\") escaped="${escaped}\\\\\\" ;;
      $'\n') escaped="${escaped}\\n" ;;
      $'\r') escaped="${escaped}\\r" ;;
      $'\t') escaped="${escaped}\\t" ;;
      *)
        printf -v code '%d' "'$char"
        if (( code < 32 )); then
          printf -v char '\\u%04x' "$code"
        fi
        escaped="${escaped}${char}"
        ;;
    esac
  done
  printf '"%s"' "$escaped"
}

json_or_null() {
  if [[ -n "${1-}" ]]; then json_escape "$1"; else printf 'null'; fi
}

canonical_remote() {
  local remote="${1-}" raw owner repo
  case "$remote" in
    https://github.com/*) raw="${remote#https://github.com/}" ;;
    git@github.com:*) raw="${remote#git@github.com:}" ;;
    ssh://git@github.com/*) raw="${remote#ssh://git@github.com/}" ;;
    *) return 0 ;;
  esac
  raw="${raw%.git}"
  [[ "$raw" != */*/* && "$raw" != *[\?\#]* ]] || return 0
  owner="${raw%%/*}"
  repo="${raw#*/}"
  [[ -n "$owner" && -n "$repo" ]] || return 0
  [[ "$owner" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || return 0
  printf 'https://github.com/%s/%s.git' "$owner" "$repo"
}

printf '['
first=1
while IFS= read -r -d '' marker; do
  if [[ "$marker" == */.git ]]; then
    candidate="${marker%/.git}"
  else
    candidate="${marker%/*}"
  fi
  repo="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo" ]] || continue
  repo="$(realpath -- "$repo" 2>/dev/null || true)"
  [[ -n "$repo" ]] || continue
  case "$repo" in "$root"|"$root"/*) ;; *) continue ;; esac
  relative="${repo#"$root"/}"
  [[ "$relative" != "$repo" ]] || relative="."
  [[ -n "$relative" ]] || relative="."
  if [[ -n "$requested_path" && "$relative" != "$requested_path" ]]; then continue; fi

  remote_raw="$(git -C "$repo" config --get remote.origin.url 2>/dev/null || true)"
  remote="$(canonical_remote "$remote_raw" || true)"
  has_origin=false
  # Never send guest credentials to an origin that failed strict GitHub
  # HTTPS/SSH normalization (notably plaintext HTTP or credentialed URLs).
  [[ -n "$remote" ]] && has_origin=true
  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  local_commit="$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || true)"
  remote_commit=""
  destination_observed=false
  if [[ "$has_origin" == true && -n "$branch" ]]; then
    if ls_remote_output="$(git -C "$repo" ls-remote --heads origin "refs/heads/$branch" 2>/dev/null)"; then
      destination_observed=true
      remote_commit="$(awk 'NR == 1 { print $1 }' <<<"$ls_remote_output")"
      [[ -z "$remote_commit" || "$remote_commit" =~ ^[0-9a-fA-F]{40,64}$ ]] || destination_observed=false
      [[ "$destination_observed" == true ]] || remote_commit=""
    fi
  fi

  worktree_state=unavailable
  destination_state=unavailable
  pushability=unavailable
  staged=0
  modified=0
  deleted=0
  untracked=0
  ahead=0
  behind=0
  if [[ "$include_status" == 1 ]]; then
    worktree_state=clean
    status_file="$(mktemp)"
    if git -C "$repo" status --porcelain=v1 -z >"$status_file" 2>/dev/null; then
      while IFS= read -r -d '' entry; do
        code="${entry:0:2}"
        if [[ "$code" == "??" ]]; then
          untracked=$((untracked + 1))
        else
          [[ "${code:0:1}" != " " ]] && staged=$((staged + 1))
          if [[ "$code" == *D* ]]; then
            deleted=$((deleted + 1))
          elif [[ "${code:1:1}" != " " ]]; then
            modified=$((modified + 1))
          fi
          if [[ "${code:0:1}" == R || "${code:0:1}" == C ]]; then
            IFS= read -r -d '' ignored_rename_path || true
          fi
        fi
      done <"$status_file"
      if (( staged + modified + deleted + untracked > 0 )); then worktree_state=localChanges; fi
      [[ -n "$branch" ]] || worktree_state=detached
    else
      worktree_state=unavailable
    fi
    rm -f "$status_file"

    remote_ref=""
    # Compare with the SHA currently advertised by the destination instead of
    # a potentially stale local remote-tracking ref. This fetch updates only
    # FETCH_HEAD/object storage and never touches worktree content.
    if [[ -n "$remote_commit" ]] &&
      git -C "$repo" fetch --quiet --no-tags origin "refs/heads/$branch" >/dev/null 2>&1 &&
      git -C "$repo" cat-file -e "$remote_commit^{commit}" >/dev/null 2>&1; then
      remote_ref="$remote_commit"
    fi
    if [[ "$has_origin" != true || "$destination_observed" != true ]]; then
      destination_state=unavailable
    elif [[ -z "$remote_commit" ]]; then
      destination_state=absent
    elif [[ -z "$local_commit" || -z "$remote_ref" ]]; then
      destination_state=unavailable
    elif [[ "$local_commit" == "$remote_commit" ]]; then
      destination_state=upToDate
    elif git -C "$repo" merge-base --is-ancestor "$remote_ref" "$local_commit" >/dev/null 2>&1; then
      destination_state=ahead
    elif git -C "$repo" merge-base --is-ancestor "$local_commit" "$remote_ref" >/dev/null 2>&1; then
      destination_state=behind
    else
      destination_state=diverged
    fi
    if [[ -n "$local_commit" && -n "$remote_ref" ]]; then
      counts="$(git -C "$repo" rev-list --left-right --count "$remote_ref...$local_commit" 2>/dev/null || true)"
      if [[ "$counts" =~ ^[0-9]+[[:space:]][0-9]+$ ]]; then
        read -r behind ahead <<<"$counts"
      fi
    fi
    if [[ "$quarantine_state" == clear && "$credential_state" == Ready && "$worktree_state" != detached && "$worktree_state" != unavailable && "$destination_state" != unavailable && "$destination_state" != behind && "$destination_state" != diverged ]]; then
      if [[ "$destination_state" == absent ]]; then pushability=publish; else pushability=pushable; fi
    else
      pushability=blocked
    fi
  fi

  if (( first == 0 )); then printf ','; fi
  first=0
  printf '{"path":%s,"canonicalRemote":%s,"branch":%s,"upstreamRef":%s,"worktreeState":%s,"destinationState":%s,"stagedCount":%s,"modifiedCount":%s,"deletedCount":%s,"untrackedCount":%s,"aheadCount":%s,"behindCount":%s,"localCommit":%s,"remoteCommit":%s,"pushability":%s,"needsStart":false,"freshness":"fresh","checkedAt":%s}' \
    "$(json_escape "$relative")" \
    "$(json_or_null "$remote")" \
    "$(json_or_null "$branch")" \
    "$(json_or_null "$upstream")" \
    "$(json_escape "$worktree_state")" \
    "$(json_escape "$destination_state")" \
    "$staged" "$modified" "$deleted" "$untracked" "$ahead" "$behind" \
    "$(json_or_null "$local_commit")" \
    "$(json_or_null "$remote_commit")" \
    "$(json_escape "$pushability")" \
    "$(json_escape "$(date -u +%Y-%m-%dT%H:%M:%SZ)")"
done < <(find "$root" -mindepth 1 \( -type d -o -type f \) -name .git -prune -print0 2>/dev/null)
printf ']\n'
SCRIPT
  printf '%s\n' "$script" | workspace_msb "$box" exec --no-tty "$box" -- bash -s -- "$include_status" "$credential_state" "$quarantine_state" "${requested_path-}"
}

app_cmd_repositories() {
  local box="" if_running=0 include_status=0 status repositories_json credential_state quarantine_state
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error repositories "missing value for --workspace"; box="$2"; shift 2 ;;
      --if-running) if_running=1; shift ;;
      --include-worktree-status) include_status=1; shift ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error repositories "repositories requires --format json"; shift 2 ;;
      *) app_usage_error repositories "unknown repositories option '$1'" ;;
    esac
  done
  [[ -n "$box" ]] || app_usage_error repositories "--workspace is required"
  is_workspace "$box" || app_usage_error repositories "workspace must be one of the configured workspaces"
  app_require_config repositories
  app_require_runtime repositories
  if ! status="$(app_status_for_workspace "$box" 2>/dev/null)"; then
    app_emit_error repositories "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed." "Refresh after repairing the MSW runtime." "$box" true 69
  fi
  if [[ "$status" != Running ]]; then
    app_emit_success repositories "{\"workspace\":$(app_json_string "$box"),\"repositories\":[],\"needsStart\":true,\"freshness\":\"fresh\",\"worktreeStatusIncluded\":false,\"notice\":\"Repository scanning is unavailable while this workspace is stopped.\"}"
    return
  fi
  credential_state="$(app_workspace_credential_state "$box")"
  quarantine_state="$(app_workspace_quarantined "$box" && printf quarantined || printf clear)"
  if ! repositories_json="$(app_guest_repository_scan "$box" "$include_status" "$credential_state" "$quarantine_state" 2>/dev/null)"; then
    app_emit_error repositories "MSW_REPOSITORIES_UNAVAILABLE" "The running workspace did not provide a repository snapshot." "Retry after repairing the workspace runtime." "$box" true 69
  fi
  [[ "$repositories_json" == \[*\] ]] || app_emit_error repositories "MSW_SCHEMA_MISMATCH" "The runtime returned an invalid repository snapshot." "Update or repair the MSW repository adapter." "$box" false 78
  app_emit_success repositories "{\"workspace\":$(app_json_string "$box"),\"repositories\":$repositories_json,\"needsStart\":false,\"freshness\":\"fresh\",\"worktreeStatusIncluded\":$([[ "$include_status" == 1 ]] && printf true || printf false),\"notice\":null}"
}


app_redact() {
  local value="${1-}"
  printf '%s\n' "$value" | /usr/bin/sed -E \
    -e 's/^H+(\{|\[)/\1/' \
    -e 's#([Bb][Ee][Aa][Rr][Ee][Rr][[:space:]]+)[A-Za-z0-9._~+/-]+=*#\1[REDACTED]#g' \
    -e 's#([Bb][Aa][Ss][Ii][Cc][[:space:]]+)[A-Za-z0-9+/=]+#\1[REDACTED]#g' \
    -e 's#(gh[osuphr]_)[A-Za-z0-9_-]+#\1[REDACTED]#g' \
    -e 's#(github_pat_)[A-Za-z0-9_-]+#\1[REDACTED]#g' \
    -e 's#((MSW_GITHUB_READ_TOKEN(_[A-Za-z0-9_]+)?|MSW_GITHUB_WRITE_TOKEN(_[A-Za-z0-9_]+)?|MSW_HOST_TOKEN(_[A-Za-z0-9_]+)?|MSW_HOST_OAUTH_TOKEN(_[A-Za-z0-9_]+)?|GH_TOKEN|GITHUB_TOKEN|ACCESS_TOKEN|REFRESH_TOKEN)=)[^[:space:]]+#\1[REDACTED]#g' \
    -e 's#(X-MSW-Capability:[[:space:]]*)[^[:space:]]+#\1[REDACTED]#g' \
    -e 's#(https?://)[^[:space:]@/:]+:[^[:space:]@]+@#\1[REDACTED]@#g'
}

app_log_line_is_internal_snapshot() {
  local value="${1-}"
  [[ -z "$value" || "$value" =~ ^H+$ ]] && return 0
  case "$value" in
    "["|"]"|"{"|"}"|"[]"|"{}") return 0 ;;
  esac
  local monitored_port
  for monitored_port in "${internal_log_ports[@]}"; do
    [[ "$value" == "$monitored_port" ]] && return 0
  done
  [[ "$value" == *'"path":'* && "$value" == *'"query":'* &&
    "$value" == *'"entries":'* && "$value" == *'"truncated":'* ]] && return 0
  [[ "$value" == *'"worktreeState":'* && "$value" == *'"destinationState":'* &&
    "$value" == *'"pushability":'* && "$value" == *'"localCommit":'* ]] && return 0
  return 1
}

app_cmd_logs() {
  local box="" status raw line safe reason_json="null" configured_port
  local -a internal_log_ports=()
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error logs "missing value for --workspace"; box="$2"; shift 2 ;;
      --format) [[ "${2:-}" == jsonl ]] || app_usage_error logs "logs requires --format jsonl"; shift 2 ;;
      *) app_usage_error logs "unknown logs option '$1'" ;;
    esac
  done
  [[ -n "$box" ]] || app_usage_error logs "--workspace is required"
  is_workspace "$box" || app_usage_error logs "workspace must be one of the configured workspaces"
  app_require_config logs
  app_require_runtime logs
  while IFS= read -r configured_port; do
    [[ -n "$configured_port" ]] && internal_log_ports+=("$configured_port")
  done < <(expand_ports)
  if ! status="$(app_status_for_workspace "$box" 2>/dev/null)"; then
    app_emit_error logs "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed." "Refresh after repairing the MSW runtime." "$box" true 69
  fi
  if [[ "$status" == Running ]]; then
    if ! raw="$(workspace_msb "$box" logs "$box" --format jsonl --tail 200 2>/dev/null)"; then
      if ! raw="$(workspace_msb "$box" logs "$box" --tail 200 2>/dev/null)"; then
        app_emit_error logs "MSW_LOGS_UNAVAILABLE" "The runtime did not provide bounded logs." "Retry after repairing the workspace runtime." "$box" true 69
      fi
    fi
  else
    reason_json="$(app_json_string "Showing system logs for a workspace that is $status.")"
    if ! raw="$(workspace_msb "$box" logs "$box" --source system --format jsonl --tail 200 2>/dev/null)"; then
      if ! raw="$(workspace_msb "$box" logs "$box" --source system --tail 200 2>/dev/null)"; then
        app_emit_error logs "MSW_LOGS_UNAVAILABLE" "The runtime did not provide stopped-workspace system logs." "Inspect the named volume and sandbox runtime." "$box" true 69
      fi
    fi
  fi
  MSW_APP_RESPONSE_EMITTED=1
  printf '{"schemaVersion":1,"type":"stream-start","protocolVersion":1,"stream":"logs","requestId":%s,"workspace":%s,"observedAt":%s,"available":true,"lifecycle":%s,"freshness":"fresh","reason":%s,"safeForDisplay":true}\n' \
    "$(app_json_string "$MSW_APP_REQUEST_ID")" "$(app_json_string "$box")" \
    "$(app_json_string "$(app_now)")" "$(app_json_string "$status")" "$reason_json"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if (( ${#line} > 262144 )); then line="${line:0:262144}"; fi
    safe="$(app_redact "$line")"
    [[ -n "$safe" ]] || continue
    app_log_line_is_internal_snapshot "$safe" && continue
    MSW_APP_RESPONSE_EMITTED=1
    printf '{"schemaVersion":1,"type":"log","requestId":%s,"workspace":%s,"observedAt":%s,"message":%s,"safeForDisplay":true}\n' \
      "$(app_json_string "$MSW_APP_REQUEST_ID")" "$(app_json_string "$box")" \
      "$(app_json_string "$(app_now)")" "$(app_json_string "$safe")"
  done <<<"$raw"
  printf '{"schemaVersion":1,"type":"stream-end","requestId":%s,"workspace":%s,"observedAt":%s,"safeForDisplay":true}\n' \
    "$(app_json_string "$MSW_APP_REQUEST_ID")" "$(app_json_string "$box")" "$(app_json_string "$(app_now)")"
}
app_plan_file() { printf '%s/app-plans/%s.plan\n' "$GITHUB_META_DIR" "$1"; }

app_cmd_plan() {
  local action="${1:-}" box="" plan_id now plan_path plan_dir action_upper expected
  shift || true
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error plan "missing value for --workspace"; box="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error plan "plan requires --format json"; shift 2 ;;
      *) app_usage_error plan "unknown plan option '$1'" ;;
    esac
  done
  [[ "$action" == start || "$action" == stop || "$action" == restart ]] || app_usage_error plan "only start, stop, and restart plans are available"
  [[ -n "$box" ]] || app_usage_error plan "--workspace is required"
  is_workspace "$box" || app_usage_error plan "workspace must be one of the configured workspaces"
  app_require_config plan
  app_require_runtime plan
  if ! expected="$(app_status_for_workspace "$box" 2>/dev/null)"; then
    app_emit_error plan "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed." "Refresh after repairing the MSW runtime." "$box" true 69
  fi
  if app_workspace_quarantined "$box"; then
    app_emit_error plan "MSW_WORKSPACE_QUARANTINED" "The workspace is quarantined." "Repair the workspace before planning a lifecycle change." "$box" false 77
  fi
  case "$action:$expected" in
    start:Stopped|start:Exited|stop:Running|restart:Running) ;;
    *) app_emit_error plan "MSW_PLAN_STATE_CHANGED" "The workspace is not in a state that permits this lifecycle action." "Refresh the workspace and review the action again." "$box" true 73 ;;
  esac
  plan_id="$(app_request_id)"
  now="$(date +%s)"
  plan_path="$(app_plan_file "$plan_id")"
  plan_dir="$(dirname "$plan_path")"
  mkdir -p "$plan_dir"
  chmod 700 "$plan_dir"
  umask 077
  printf 'action=%s\nworkspace=%s\nexpected=%s\ncreated=%s\nexpires=%s\n' "$action" "$box" "$expected" "$now" "$((now + 300))" >"$plan_path"
  action_upper="$(printf '%s' "$action" | tr '[:lower:]' '[:upper:]')"
  app_emit_success plan "{\"planId\":$(app_json_string "$plan_id"),\"action\":$(app_json_string "$action"),\"workspace\":$(app_json_string "$box"),\"expiresAt\":$(app_json_string "$(date -u -r "$((now + 300))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$((now + 300))" +%Y-%m-%dT%H:%M:%SZ)"),\"confirmationPhrase\":$(app_json_string "$action_upper $box"),\"effects\":\"The workspace lifecycle will change and must be reconciled with a fresh state observation.\"}"
}
app_cmd_push_plan() {
  local box="" path="" status="" snapshot_json="" repo_json="" credential_state="" quarantine_state=""
  local branch="" local_sha="" remote_sha="" canonical="" canonical_repo="" pushability="" worktree_state="" destination_state=""
  local ahead=0 behind=0 plan_id="" now="" plan_path="" phrase="" effects=""
  local -a repositories=()
  while (( $# > 0 )); do
    case "$1" in
      --workspace) [[ $# -ge 2 ]] || app_usage_error push-plan "missing value for --workspace"; box="$2"; shift 2 ;;
      --repositories)
        shift
        while (( $# > 0 )) && [[ "$1" != --format ]]; do
          repositories+=("$1")
          shift
        done
        ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error push-plan "push-plan requires --format json"; shift 2 ;;
      *) app_usage_error push-plan "unknown push-plan option '$1'" ;;
    esac
  done
  [[ -n "$box" ]] || app_usage_error push-plan "--workspace is required"
  is_workspace "$box" || app_usage_error push-plan "workspace must be one of the configured workspaces"
  ((${#repositories[@]} == 1)) || app_usage_error push-plan "exactly one repository path is required per push plan"
  path="${repositories[0]}"
  app_valid_relative_path "$path" || app_usage_error push-plan "repository path must be relative to /workspace"
  app_require_config push-plan
  app_require_runtime push-plan
  if ! status="$(app_status_for_workspace "$box" 2>/dev/null)"; then
    app_emit_error push-plan "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed." "Refresh after repairing the workspace runtime." "$box" true 69
  fi
  [[ "$status" == Running ]] || app_emit_error push-plan "MSW_WORKSPACE_NOT_RUNNING" "The workspace is not running." "Start the workspace, refresh state, and review the repository again." "$box" true 69
  credential_state="$(app_workspace_credential_state "$box")"
  quarantine_state="$(app_workspace_quarantined "$box" && printf quarantined || printf clear)"
  [[ "$quarantine_state" == clear ]] || app_emit_error push-plan "MSW_WORKSPACE_QUARANTINED" "The workspace is quarantined." "Repair the workspace credentials before reviewing a push." "$box" false 77
  [[ "$credential_state" == Ready ]] || app_emit_error push-plan "MSW_PUSH_NOT_AUTHORIZED" "Host write authorization is not ready for this workspace." "Authorize host write access before reviewing a push." "$box" false 77
  [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] || app_emit_error push-plan "MSW_JSON_TOOL_UNAVAILABLE" "The repository adapter requires jq to validate its snapshot." "Repair the MSW toolchain and retry the repository review." "$box" true 69
  if ! snapshot_json="$(app_guest_repository_scan "$box" 1 "$credential_state" "$quarantine_state" "$path" 2>/dev/null)"; then
    app_emit_error push-plan "MSW_REPOSITORIES_UNAVAILABLE" "The running workspace did not provide a repository snapshot." "Retry after repairing the workspace runtime." "$box" true 69
  fi
  repo_json="$("$JQ_BIN" -c --arg path "$path" 'map(select(.path == $path)) | if length == 1 then .[0] else empty end' <<<"$snapshot_json" 2>/dev/null || true)"
  [[ -n "$repo_json" ]] || app_emit_error push-plan "MSW_REPOSITORY_NOT_FOUND" "The requested repository was not found under /workspace." "Refresh repositories and choose a listed workspace-relative path." "$box" false 78
  branch="$("$JQ_BIN" -r '.branch // empty' <<<"$repo_json")"
  local_sha="$("$JQ_BIN" -r '.localCommit // empty' <<<"$repo_json")"
  remote_sha="$("$JQ_BIN" -r '.remoteCommit // empty' <<<"$repo_json")"
  canonical="$("$JQ_BIN" -r '.canonicalRemote // empty' <<<"$repo_json")"
  pushability="$("$JQ_BIN" -r '.pushability // empty' <<<"$repo_json")"
  worktree_state="$("$JQ_BIN" -r '.worktreeState // empty' <<<"$repo_json")"
  destination_state="$("$JQ_BIN" -r '.destinationState // empty' <<<"$repo_json")"
  ahead="$("$JQ_BIN" -r '.aheadCount // 0' <<<"$repo_json")"
  behind="$("$JQ_BIN" -r '.behindCount // 0' <<<"$repo_json")"
  [[ "$pushability" == pushable || "$pushability" == publish ]] || app_emit_error push-plan "MSW_PUSH_BLOCKED" "MSW policy does not allow pushing this repository state." "Resolve detached, diverged, unavailable, or unauthorized state before reviewing a push." "$box" false 77
  [[ "$pushability" == publish || "$ahead" =~ ^[1-9][0-9]*$ ]] || app_emit_error push-plan "MSW_NOTHING_TO_PUSH" "The reviewed repository has no committed changes to transfer." "Refresh the repository after committing the branch you want to push." "$box" false 77
  # §8 local gate: host push injects the host credential, so the canonical
  # repo must carry a credential grant (host push is allowed for every granted
  # repo in BOTH modes).
  if [[ "$MSW_GITHUB_MODE" == local && "$canonical" == https://github.com/* ]]; then
    canonical_repo="${canonical#https://github.com/}"
    canonical_repo="${canonical_repo%.git}"
    canonical_repo="$(printf '%s' "$canonical_repo" | tr '[:upper:]' '[:lower:]')"
    if [[ "$canonical_repo" == */* && "$canonical_repo" != */*/* ]]; then
      if [[ -z "$(policy_repo_mode "$box" "$canonical_repo" 2>/dev/null || true)" ]]; then
        app_emit_error push-plan "MSW_PUSH_NOT_AUTHORIZED" "The repository has no credential grant on this workspace." "Add one with: msw app github-policy-set --workspace $box --repository $canonical_repo --mode read-write" "$box" false 77
      fi
    fi
  fi
  plan_id="$(app_request_id)"
  now="$(date +%s)"
  plan_path="$(app_plan_file "$plan_id")"
  mkdir -p "$(dirname "$plan_path")"
  chmod 700 "$(dirname "$plan_path")"
  umask 077
  {
    printf 'action=push\n'
    printf 'workspace=%s\n' "$box"
    printf 'path=%s\n' "$path"
    printf 'branch=%s\n' "$branch"
    printf 'local=%s\n' "$local_sha"
    printf 'remote=%s\n' "$remote_sha"
    printf 'canonical=%s\n' "$canonical"
    printf 'destination=%s\n' "$destination_state"
    printf 'worktree=%s\n' "$worktree_state"
    printf 'ahead=%s\n' "$ahead"
    printf 'behind=%s\n' "$behind"
    printf 'created=%s\n' "$now"
    printf 'expires=%s\n' "$((now + 300))"
  } >"$plan_path"
  chmod 600 "$plan_path"
  phrase="PUSH"
  effects="Only committed HEAD for $path will be transferred through the host; uncommitted changes remain in the workspace."
  app_emit_success push-plan "{\"planId\":$(app_json_string "$plan_id"),\"workspace\":$(app_json_string "$box"),\"repositoryPath\":$(app_json_string "$path"),\"branch\":$(app_json_string "$branch"),\"localCommit\":$(app_json_string "$local_sha"),\"remoteCommit\":$(app_json_string "$remote_sha"),\"aheadCount\":$ahead,\"behindCount\":$behind,\"forceWithLease\":false,\"expiresAt\":$(app_json_string "$(date -u -r "$((now + 300))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$((now + 300))" +%Y-%m-%dT%H:%M:%SZ)"),\"confirmationPhrase\":$(app_json_string "$phrase"),\"effects\":$(app_json_string "$effects")}"
}

app_cmd_apply() {
  local plan_id="${1:-}" fd="" plan_path="" claimed_path="" action="" box="" path="" created=0 expires=0 now="" supplied="" phrase=""
  local expected="" planned="" current_state="" observed="" current_json="" current_local="" current_remote="" current_branch="" current_canonical="" current_pushability="" current_ahead=0
  local reconciled_json="" reconciled_remote="" reconciled_destination="" operation_error="" operation_detail="" runtime_detail=""
  local credential_state="" quarantine_state="" push_error="" action_upper=""
  shift || true
  while (( $# > 0 )); do
    case "$1" in
      --confirmation-fd) [[ $# -ge 2 ]] || app_usage_error apply "missing value for --confirmation-fd"; fd="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error apply "apply requires --format json"; shift 2 ;;
      *) app_usage_error apply "unknown apply option '$1'" ;;
    esac
  done
  [[ "$plan_id" =~ ^[A-Za-z0-9-]{1,128}$ ]] || app_usage_error apply "plan identifier is required"
  [[ "$fd" =~ ^[0-9]+$ ]] || app_usage_error apply "a confirmation file descriptor is required"
  plan_path="$(app_plan_file "$plan_id")"
  [[ -f "$plan_path" && ! -L "$plan_path" ]] || app_emit_error apply "MSW_PLAN_NOT_FOUND" "The confirmation plan is missing or expired." "Create a fresh plan." "" true 78
  while IFS='=' read -r key value; do
    case "$key" in
      action) action="$value" ;;
      workspace) box="$value" ;;
      expected) planned="$value" ;;
      path) path="$value" ;;
      created) created="$value" ;;
      expires) expires="$value" ;;
      local) expected_local="$value" ;;
      remote) expected_remote="$value" ;;
      branch) expected_branch="$value" ;;
      destination) expected_destination="$value" ;;
      worktree) expected_worktree="$value" ;;
      canonical) expected_canonical="$value" ;;
    esac
  done <"$plan_path"
  now="$(date +%s)"
  [[ "$expires" =~ ^[0-9]+$ && "$expires" -gt "$now" ]] || {
    rm -f "$plan_path"
    app_emit_error apply "MSW_PLAN_EXPIRED" "The confirmation plan expired." "Create a fresh plan." "$box" true 78
  }
  is_workspace "$box" || app_emit_error apply "MSW_PLAN_INVALID" "The plan contains an invalid workspace." "Create a fresh plan." "$box" false 78
  case "$action" in
    start|stop|restart) phrase="$(printf '%s' "$action" | tr '[:lower:]' '[:upper:]') $box" ;;
    push) phrase="PUSH" ;;
    *) app_emit_error apply "MSW_PLAN_INVALID" "The plan contains an unsupported action." "Create a fresh plan." "$box" false 78 ;;
  esac
  if ! IFS= read -r supplied <&"$fd"; then
    app_emit_error apply "MSW_CONFIRMATION_REQUIRED" "The action confirmation was not supplied." "Confirm the exact phrase shown by MSW Monitor." "$box" false 77
  fi
  [[ "$supplied" == "$phrase" ]] || app_emit_error apply "MSW_CONFIRMATION_MISMATCH" "The confirmation did not match the reviewed action." "Review the plan and confirm again." "$box" false 77

  app_require_config apply
  app_require_runtime apply
  # Consume a reviewed plan exactly once before mutation. Atomic rename makes
  # concurrent app/CLI apply attempts deterministic and prevents replay.
  claimed_path="${plan_path}.applying.$$"
  if ! mv "$plan_path" "$claimed_path" 2>/dev/null; then
    app_emit_error apply "MSW_PLAN_CONFLICT" "The reviewed plan is already being applied or was consumed." "Refresh state and create a new plan." "$box" true 73
  fi
  plan_path="$claimed_path"
  rm -f "$plan_path"
  if [[ "$action" == start || "$action" == stop || "$action" == restart ]]; then
    [[ -n "$planned" ]] || app_emit_error apply "MSW_PLAN_INVALID" "The lifecycle plan has no observed precondition." "Create a fresh plan." "$box" false 78
    if ! current_state="$(app_status_for_workspace "$box" 2>/dev/null)"; then
      app_emit_error apply "MSW_STATE_UNAVAILABLE" "Workspace state could not be observed before the operation." "Refresh after repairing the MSW runtime." "$box" true 69
    fi
    [[ "$current_state" == "$planned" ]] || app_emit_error apply "MSW_PLAN_STATE_CHANGED" "The workspace changed after the action was reviewed." "Refresh the workspace and create a new plan." "$box" true 73
    if app_workspace_quarantined "$box"; then
      app_emit_error apply "MSW_WORKSPACE_QUARANTINED" "The workspace is quarantined." "Repair the workspace before retrying this action." "$box" false 77
    fi
  fi
  case "$action" in
    start|stop|restart)
      case "$action" in
        start) expected="Running" ;;
        stop) expected="Stopped" ;;
        restart) expected="Running" ;;
      esac
      operation_error="$(mktemp "${TMPDIR:-/tmp}/msw-app-lifecycle.XXXXXX")"
      if ! (
        case "$action" in
          start) cmd_start "$box" ;;
          stop) cmd_stop "$box" ;;
          restart) cmd_restart "$box" ;;
        esac
      ) >/dev/null 2>"$operation_error"; then
        operation_detail="$(app_redact "$(/bin/cat "$operation_error")" | /usr/bin/tail -n 8 | /usr/bin/tr '\n' ' ' | /usr/bin/cut -c1-2000)"
        if [[ "$action" == start ]]; then
          runtime_detail="$(workspace_msb "$box" logs "$box" --source system --tail 40 2>/dev/null | /usr/bin/tail -n 12 | /usr/bin/tr '\n' ' ' | /usr/bin/cut -c1-2000 || true)"
          runtime_detail="$(app_redact "$runtime_detail")"
          [[ -z "$runtime_detail" ]] || operation_detail="$operation_detail Runtime: $runtime_detail"
        fi
        rm -f "$operation_error"
        [[ -n "$operation_detail" ]] || operation_detail="The workspace operation failed before reconciliation."
        app_emit_error apply "MSW_OPERATION_FAILED" "$operation_detail" "Resolve the runtime error shown above, then create a fresh plan and retry." "$box" true 1
      fi
      rm -f "$operation_error"
      if ! observed="$(app_status_for_workspace "$box" 2>/dev/null)" || [[ "$observed" != "$expected" ]]; then
        app_emit_error apply "MSW_RECONCILE_PENDING" "The lifecycle operation completed without a matching fresh state observation." "Refresh after checking the workspace runtime; MSW did not claim final state." "$box" true 69
      fi
      app_emit_success apply \
        "{\"workspace\":$(app_json_string "$box"),\"action\":$(app_json_string "$action"),\"reconciled\":true,\"outcome\":$(app_json_string "operation completed and the observed lifecycle is $observed")}" || return
      ;;
    push)
      app_valid_relative_path "$path" || app_emit_error apply "MSW_PLAN_INVALID" "The plan contains an invalid repository path." "Create a fresh plan." "$box" false 78
      [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] || app_emit_error apply "MSW_JSON_TOOL_UNAVAILABLE" "The repository adapter requires jq to validate its snapshot." "Repair the MSW toolchain and retry the repository review." "$box" true 69
      credential_state="$(app_workspace_credential_state "$box")"
      quarantine_state="$(app_workspace_quarantined "$box" && printf quarantined || printf clear)"
      [[ "$quarantine_state" == clear && "$credential_state" == Ready ]] || app_emit_error apply "MSW_PUSH_NOT_AUTHORIZED" "Host write authorization is no longer ready for this workspace." "Reauthorize host write access and create a fresh push plan." "$box" false 77
      if ! current_json="$(app_guest_repository_scan "$box" 1 "$credential_state" "$quarantine_state" "$path" 2>/dev/null)"; then
        app_emit_error apply "MSW_REPOSITORIES_UNAVAILABLE" "The running workspace did not provide a repository snapshot." "Refresh repositories and create a fresh push plan." "$box" true 69
      fi
      current_json="$("$JQ_BIN" -c --arg path "$path" 'map(select(.path == $path)) | if length == 1 then .[0] else empty end' <<<"$current_json" 2>/dev/null || true)"
      [[ -n "$current_json" ]] || app_emit_error apply "MSW_REPOSITORY_NOT_FOUND" "The reviewed repository is no longer available." "Refresh repositories and create a fresh push plan." "$box" false 78
      current_local="$("$JQ_BIN" -r '.localCommit // empty' <<<"$current_json")"
      current_remote="$("$JQ_BIN" -r '.remoteCommit // empty' <<<"$current_json")"
      current_branch="$("$JQ_BIN" -r '.branch // empty' <<<"$current_json")"
      current_canonical="$("$JQ_BIN" -r '.canonicalRemote // empty' <<<"$current_json")"
      current_pushability="$("$JQ_BIN" -r '.pushability // empty' <<<"$current_json")"
      current_ahead="$("$JQ_BIN" -r '.aheadCount // 0' <<<"$current_json")"
      [[ "$current_local" == "$expected_local" && "$current_remote" == "$expected_remote" && "$current_branch" == "$expected_branch" && "$current_canonical" == "$expected_canonical" ]] || \
        app_emit_error apply "MSW_PLAN_STATE_CHANGED" "The repository changed after the push was reviewed." "Refresh the repository and create a new push plan." "$box" true 73
      [[ "$current_pushability" == pushable || "$current_pushability" == publish ]] || \
        app_emit_error apply "MSW_PUSH_BLOCKED" "MSW policy no longer allows pushing this repository state." "Review the updated repository and create a new push plan." "$box" false 77
      [[ "$current_pushability" == publish || "$current_ahead" =~ ^[1-9][0-9]*$ ]] || \
        app_emit_error apply "MSW_NOTHING_TO_PUSH" "The reviewed repository has no committed changes to transfer." "Refresh the repository after committing the branch you want to push." "$box" false 77
      push_error="$(mktemp "${TMPDIR:-/tmp}/msw-app-push.XXXXXX")"
      if ! printf 'PUSH\n' | push_impl "$box" "$path" 0 0 1 >/dev/null 2>"$push_error"; then
        rm -f "$push_error"
        app_emit_error apply "MSW_PUSH_FAILED" "The host-only push failed." "Review the repository state and create a new plan; no uncommitted files were transferred." "$box" true 1
      fi
      rm -f "$push_error"
      if ! reconciled_json="$(app_guest_repository_scan "$box" 1 "$credential_state" "$quarantine_state" "$path" 2>/dev/null)"; then
        app_emit_error apply "MSW_RECONCILE_PENDING" "The host-only push exited without a fresh destination observation." "Refresh the repository before deciding whether another push is safe." "$box" true 69
      fi
      reconciled_json="$("$JQ_BIN" -c --arg path "$path" 'map(select(.path == $path)) | if length == 1 then .[0] else empty end' <<<"$reconciled_json" 2>/dev/null || true)"
      [[ -n "$reconciled_json" ]] || app_emit_error apply "MSW_RECONCILE_PENDING" "The pushed repository could not be re-observed." "Refresh the repository before deciding whether another push is safe." "$box" true 69
      reconciled_remote="$("$JQ_BIN" -r '.remoteCommit // empty' <<<"$reconciled_json")"
      reconciled_destination="$("$JQ_BIN" -r '.destinationState // empty' <<<"$reconciled_json")"
      [[ "$reconciled_remote" == "$expected_local" && "$reconciled_destination" == upToDate ]] ||
      app_emit_error apply "MSW_RECONCILE_PENDING" "The pushed repository destination did not match the reviewed commit." "Refresh the repository before deciding whether another push is safe." "$box" true 69
      app_emit_success apply \
        "{\"workspace\":$(app_json_string "$box"),\"action\":\"push\",\"pushed\":true,\"reconciled\":true,\"remoteCommit\":$(app_json_string "$reconciled_remote"),\"destinationState\":$(app_json_string "$reconciled_destination")}" || return
      ;;
  esac
}

app_workspace_configuration_valid() {
  "$JQ_BIN" -e '
    type == "object" and
    (keys | sort) == ["schemaVersion", "workspaces"] and
    .schemaVersion == 1 and
    (.workspaces | type == "array" and length > 0 and length <= 64) and
    ([.workspaces[].name] | length == (unique | length)) and
    all(.workspaces[]; . as $w |
      ($w | type == "object") and
      ($w | keys | sort) == ["cpu", "cpuCeiling", "memoryCeilingGiB", "memoryGiB", "name", "runtimeStorageGiB", "workspaceStorageGiB"] and
      ($w.name | type == "string" and test("^[a-z][a-z0-9-]{0,31}$")) and
      ([4,6,8,12] | index($w.cpu)) != null and
      ([4,6,8,12] | index($w.cpuCeiling)) != null and $w.cpu <= $w.cpuCeiling and
      ([16,32,48] | index($w.memoryGiB)) != null and
      ([16,32,48] | index($w.memoryCeilingGiB)) != null and $w.memoryGiB <= $w.memoryCeilingGiB and
      ([60,80,100,120] | index($w.workspaceStorageGiB)) != null and
      ([60,80,100,120] | index($w.runtimeStorageGiB)) != null)
  ' "$1" >/dev/null 2>&1
}

app_workspace_configuration_changed() {
  local old_file="$1" new_file="$2" box="$3"
  [[ -f "$old_file" ]] || return 0
  ! "$JQ_BIN" -e --arg box "$box" --slurpfile desired "$new_file" '
    (.workspaces[] | select(.name == $box)) ==
    ($desired[0].workspaces[] | select(.name == $box))
  ' "$old_file" >/dev/null 2>&1
}

app_create_configured_workspace() {
  local box="$1" cpu cpu_ceiling memory memory_ceiling workspace_storage runtime_storage host
  cpu="$(workspace_configuration_value "$box" cpu)"
  cpu_ceiling="$(workspace_configuration_value "$box" cpuCeiling)"
  memory="$(workspace_configuration_value "$box" memoryGiB)G"
  memory_ceiling="$(workspace_configuration_value "$box" memoryCeilingGiB)G"
  workspace_storage="$(workspace_configuration_value "$box" workspaceStorageGiB)G"
  runtime_storage="$(workspace_configuration_value "$box" runtimeStorageGiB)G"
  host="$(workspace_host "$box")"
  workspace_msb "$box" run --detach \
    --name "$box" --from-snapshot "$MSW_BASE_SNAPSHOT" \
    --cpus "$cpu" --max-cpus "$cpu_ceiling" --memory "$memory" --max-memory "$memory_ceiling" \
    --mount-named "msw-${box}-workspace:/workspace:kind=disk,size=${workspace_storage}" \
    --mount-named "msw-${box}-runtime:/var/lib/msw-runtime:kind=disk,size=${runtime_storage}" \
    --workdir /workspace --init auto --security default --net public --tls-intercept \
    --label msw.managed=true --label "msw.workspace=${box}" \
    --env "MSW_WORKSPACE=${box}" --env "MSW_BROWSER_HOST=${host}" \
    --env 'PATH=/root/.local/bin:/root/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
    --env SHELL=/usr/bin/zsh --env LANG=en_US.UTF-8 --env HOST=0.0.0.0 --env BIND_ADDRESS=0.0.0.0 \
    --env "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=${host}" -- sleep infinity >/dev/null || return
  workspace_msb "$box" exec --no-tty "$box" -- bash -s -- "$box" "$host" <<'GUEST' || return
set -Eeuo pipefail
workspace="$1"; browser_host="$2"
mkdir -p /workspace /var/lib/msw-runtime/docker /var/lib/msw-runtime/containerd
printf 'export MSW_WORKSPACE=%q\nexport MSW_BROWSER_HOST=%q\nexport HOST=%q\nexport BIND_ADDRESS=%q\nexport __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=%q\n' \
  "$workspace" "$browser_host" "0.0.0.0" "0.0.0.0" "$browser_host" \
  >/etc/profile.d/msw-workspace.sh
hostnamectl set-hostname "msw-$workspace"
printf '%s\n' "$workspace" >/workspace/.msw-workspace
systemctl daemon-reload
systemctl enable containerd.service docker.service
systemctl restart containerd.service docker.service
mkdir -p /workspace/.msw-docker-smoke
rm -rf /workspace/.msw-docker-smoke
GUEST
  __workspace_state_init "$box" || true
  workspace_msb "$box" stop -q -t 90 "$box" >/dev/null
}

app_workspace_volume_requires_reconcile() {
  local old_file="$1" new_file="$2" box="$3" field="$4" volume="$5" old_value new_value
  volume_exists "$volume" || return 1
  new_value="$($JQ_BIN -er --arg box "$box" --arg field "$field" \
    '.workspaces[] | select(.name == $box) | .[$field]' "$new_file")" || return 1
  if [[ ! -s "$old_file" ]]; then return 0; fi
  old_value="$($JQ_BIN -er --arg box "$box" --arg field "$field" \
    '.workspaces[] | select(.name == $box) | .[$field]' "$old_file" 2>/dev/null || true)"
  [[ -z "$old_value" || "$old_value" != "$new_value" ]]
}

# MicroSandbox cannot resize an existing named disk volume in place. Copy its
# complete contents through a private temporary disk, recreate the exact named
# volume at the requested size, then copy back. A failed restore deliberately
# retains the temporary volume and refuses a later automatic retry so recovery
# data can never be overwritten silently.
app_copy_named_volume() {
  local source="$1" destination="$2" helper="$3"
  "$MSB_BIN" run --detach --name "$helper" --from-snapshot "$MSW_BASE_SNAPSHOT" \
    --mount-named "$source:/source:kind=disk" \
    --mount-named "$destination:/destination:kind=disk" \
    --init auto --security default --net public -- sleep infinity >/dev/null || return 1
  if ! "$MSB_BIN" exec --no-tty "$helper" -- bash -s <<'GUEST'
set -Eeuo pipefail
# MSW named-volume migration: copy dotfiles, metadata, links, and empty trees.
cp -a /source/. /destination/
sync
GUEST
  then
    "$MSB_BIN" rm -f "$helper" >/dev/null 2>&1 || true
    return 1
  fi
  "$MSB_BIN" rm -f "$helper" >/dev/null || return 1
}

app_reconcile_named_volume_capacity() {
  local volume="$1" size="$2" temp helper="msw-volume-copy-$$"
  temp="${volume}-resize"
  if volume_exists "$temp"; then
    warn "retained recovery volume '$temp' blocks automatic resize of '$volume'"
    return 1
  fi
  "$MSB_BIN" volume create "$temp" --kind disk --size "${size}G" -q >/dev/null || return 1
  if ! app_copy_named_volume "$volume" "$temp" "$helper"; then
    "$MSB_BIN" volume rm "$temp" >/dev/null 2>&1 || true
    return 1
  fi
  "$MSB_BIN" volume rm "$volume" >/dev/null || return 1
  if ! "$MSB_BIN" volume create "$volume" --kind disk --size "${size}G" -q >/dev/null; then
    warn "workspace data remains recoverable in '$temp'"
    return 1
  fi
  if ! app_copy_named_volume "$temp" "$volume" "$helper"; then
    warn "workspace data remains recoverable in '$temp'"
    return 1
  fi
  "$MSB_BIN" volume rm "$temp" >/dev/null || return 1
}

app_reconcile_workspace_configuration() {
  local fd="$1" input old_copy config_dir box desired old_box policy policy_tmp ssh_config ssh_tmp
  local workspace_volume_name runtime_volume_name workspace_size runtime_size
  config_dir="$(dirname "$MSW_WORKSPACES_FILE")"
  mkdir -p "$config_dir" || return
  chmod 700 "$config_dir" || return
  input="$(mktemp "$config_dir/.workspaces-input.XXXXXX")" || return
  old_copy="$(mktemp "$config_dir/.workspaces-old.XXXXXX")" || { rm -f "$input"; return 1; }
  dd bs=262145 count=1 <&"$fd" >"$input" 2>/dev/null || { rm -f "$input" "$old_copy"; return 1; }
  [[ $(wc -c <"$input") -le 262144 ]] || { rm -f "$input" "$old_copy"; return 1; }
  app_workspace_configuration_valid "$input" || { rm -f "$input" "$old_copy"; return 1; }
  if [[ -f "$MSW_WORKSPACES_FILE" ]]; then cp -p "$MSW_WORKSPACES_FILE" "$old_copy" || return; else : >"$old_copy"; fi

  # Removed and renamed workspaces stop being managed resources. Persistent
  # named volumes are deliberately retained so an accidental removal remains
  # recoverable; only the VM root is removed.
  if [[ -s "$old_copy" ]]; then
    while IFS= read -r old_box; do
      desired="$($JQ_BIN -r --arg box "$old_box" '[.workspaces[].name] | index($box) != null' "$input")"
      if [[ "$desired" != true ]]; then
        port_forwarder_stop "$old_box"
        port_forwarder_stop_launchd "$old_box"
        if sandbox_exists "$old_box"; then
          workspace_msb "$old_box" rm -f "$old_box" >/dev/null || return
        fi
        if [[ -f "$HOME/.ssh/msw_known_hosts" ]] && command -v ssh-keygen >/dev/null 2>&1; then
          ssh-keygen -R "${old_box}.msb" -f "$HOME/.ssh/msw_known_hosts" >/dev/null 2>&1 || true
        fi
      fi
    done < <("$JQ_BIN" -r '.workspaces[].name' "$old_copy")
  fi

  chmod 600 "$input" || return
  mv "$input" "$MSW_WORKSPACES_FILE" || return
  WORKSPACES=()
  while IFS= read -r box; do WORKSPACES+=("$box"); done < <("$JQ_BIN" -r '.workspaces[].name' "$MSW_WORKSPACES_FILE")

  # A full policy may still contain a removed workspace. Prune only those
  # keys atomically so remaining grants stay usable; malformed policy remains
  # untouched and therefore fail-closed.
  policy="$(policy_file)"
  if [[ -f "$policy" && ! -L "$policy" ]] &&
     "$JQ_BIN" -e '.schemaVersion == 1 and (.workspaces | type == "object")' "$policy" >/dev/null 2>&1; then
    policy_tmp="$policy.reconcile.$$"
    if "$JQ_BIN" --argjson configured "$(printf '%s\n' "${WORKSPACES[@]}" | "$JQ_BIN" -Rsc 'split("\n")[:-1]')" \
      '.workspaces |= with_entries(select(.key as $key | $configured | index($key)))' \
      "$policy" >"$policy_tmp" && policy_json_valid "$(cat "$policy_tmp")"; then
      chmod 600 "$policy_tmp" && mv "$policy_tmp" "$policy"
    else
      rm -f "$policy_tmp"
    fi
  fi

  # The SSH proxy validates the requested host against workspaces.json, so a
  # wildcard host stanza is both safe and durable across add/remove/rename.
  ssh_config="$HOME/.ssh/config.d/msw.conf"
  if [[ -f "$ssh_config" && ! -L "$ssh_config" ]]; then
    ssh_tmp="$ssh_config.reconcile.$$"
    if /usr/bin/awk 'BEGIN { replaced=0 } !replaced && /^Host / { print "Host *.msb"; replaced=1; next } { print } END { if (!replaced) exit 1 }' \
      "$ssh_config" >"$ssh_tmp"; then
      chmod 600 "$ssh_tmp" && mv "$ssh_tmp" "$ssh_config"
    else
      rm -f "$ssh_tmp"
      return 1
    fi
  fi

  if [[ "${MSW_TEST_MODE:-0}" == 1 ]]; then
    cmd_host_repair_test || return
  fi

  for box in "${WORKSPACES[@]}"; do
    if sandbox_exists "$box" && app_workspace_configuration_changed "$old_copy" "$MSW_WORKSPACES_FILE" "$box"; then
      port_forwarder_stop "$box"
      port_forwarder_stop_launchd "$box"
      workspace_msb "$box" rm -f "$box" >/dev/null || return
    fi
    workspace_volume_name="$(workspace_volume "$box" workspace)"
    runtime_volume_name="$(workspace_volume "$box" runtime)"
    workspace_size="$(workspace_configuration_value "$box" workspaceStorageGiB)" || return
    runtime_size="$(workspace_configuration_value "$box" runtimeStorageGiB)" || return
    if app_workspace_volume_requires_reconcile \
      "$old_copy" "$MSW_WORKSPACES_FILE" "$box" workspaceStorageGiB "$workspace_volume_name"; then
      app_reconcile_named_volume_capacity "$workspace_volume_name" "$workspace_size" || return
    fi
    if app_workspace_volume_requires_reconcile \
      "$old_copy" "$MSW_WORKSPACES_FILE" "$box" runtimeStorageGiB "$runtime_volume_name"; then
      app_reconcile_named_volume_capacity "$runtime_volume_name" "$runtime_size" || return
    fi
    sandbox_exists "$box" || app_create_configured_workspace "$box" || return
    port_forwarder_start "$box" || return
  done
  rm -f "$input" "$old_copy"
}

app_cmd_bootstrap() {
  local resume=0 events_fd="" workspace_config_fd="" format="" phase request_id output recovery detail
  while (( $# > 0 )); do
    case "$1" in
      --resume) resume=1; shift ;;
      --events-fd) [[ $# -ge 2 ]] || app_usage_error bootstrap "missing value for --events-fd"; events_fd="$2"; shift 2 ;;
      --workspace-config-fd) [[ $# -ge 2 ]] || app_usage_error bootstrap "missing value for --workspace-config-fd"; workspace_config_fd="$2"; shift 2 ;;
      --format) [[ "${2:-}" == json ]] || app_usage_error bootstrap "bootstrap requires --format json"; format="$2"; shift 2 ;;
      *) app_usage_error bootstrap "unknown bootstrap option '$1'" ;;
    esac
  done
  [[ "$resume" == 1 ]] || app_usage_error bootstrap "bootstrap requires --resume"
  [[ -z "$events_fd" || "$events_fd" =~ ^[0-9]+$ ]] || app_usage_error bootstrap "events fd must be numeric"
  [[ -n "$workspace_config_fd" ]] || app_usage_error bootstrap "bootstrap requires --workspace-config-fd"
  [[ "$workspace_config_fd" =~ ^[0-9]+$ ]] || app_usage_error bootstrap "workspace config fd must be numeric"
  request_id="${MSW_APP_REQUEST_ID:-$(app_request_id)}"
  app_require_config bootstrap
  app_require_runtime bootstrap

  if ! app_reconcile_workspace_configuration "$workspace_config_fd"; then
    app_emit_error bootstrap "MSW_WORKSPACE_CONFIGURATION_FAILED" \
      "The requested workspace configuration could not be applied." \
      "Review workspace names and limits, then retry Setup." "" true 78
  fi

  for phase in preflight toolchain host-integration workspaces; do
    if [[ -n "$events_fd" ]]; then
      printf '{"schemaVersion":1,"type":"progress","requestId":%s,"phase":%s,"fraction":1,"message":%s,"safeForDisplay":true}\n' \
        "$(app_json_string "$request_id")" \
        "$(app_json_string "$phase")" \
        "$(app_json_string "The native setup coordinator completed this phase.")" >&"$events_fd"
    fi
  done

  # Deep verification must start each stopped workspace. A workspace whose
  # GitHub credential is unavailable cannot start, so report it precisely and
  # let the app route the user into the GitHub connection flow instead of
  # failing with a generic verification error.
  for box in "${WORKSPACES[@]}"; do
    if { [[ -f "$(metadata_file "$box")" ]] || app_metadata_profile_present "$box" guest; } &&
      ! keychain_has "$READ_KEYCHAIN_SERVICE" "$box" &&
      ! workspace_msb "$box" ping -q "$box" >/dev/null 2>&1; then
      app_emit_error bootstrap "MSW_GITHUB_RECONNECT_REQUIRED" \
        "GitHub is configured for '$box', but its credential is unavailable." \
        "Connect GitHub for '$box' in MSW Monitor, then resume Setup." "$box" true 69
    fi
  done

  if [[ -n "$events_fd" ]]; then
    printf '{"schemaVersion":1,"type":"progress","requestId":%s,"phase":"verification","fraction":0,"message":"Starting the complete deep verification. Workspaces may start temporarily and the previous running set will be restored.","safeForDisplay":true}\n' \
      "$(app_json_string "$request_id")" >&"$events_fd"
  fi
  if ! output="$(cmd_check --deep 2>&1)"; then
    recovery="Repair the reported MSW configuration or runtime issue, then resume Setup."
    if [[ -n "$output" ]]; then
      detail="$(app_redact "$output" | /usr/bin/tail -n 12 | /usr/bin/tr '\n' ' ')"
      [[ -z "$detail" ]] || recovery="Verification reported: ${detail}"
    fi
    app_emit_error bootstrap "MSW_BOOTSTRAP_VERIFICATION_FAILED" "Workspace bootstrap verification failed." "$recovery" "" true 69
  fi
  if [[ -n "$events_fd" ]]; then
    printf '{"schemaVersion":1,"type":"progress","requestId":%s,"phase":"verification","fraction":1,"message":"Deep verification passed and the previous running set was restored.","safeForDisplay":true}\n' \
      "$(app_json_string "$request_id")" >&"$events_fd"
  fi
  app_emit_success bootstrap '{"resumed":true,"phase":"complete","requiresApproval":false,"vmsStarted":true,"message":"Workspace bootstrap and deep verification completed; the previous running set was restored."}'
}

app_cmd_help() {
  cat <<'APPHELP'
Machine-readable MSW Monitor commands:
  msw app handshake --format json
  msw app state [--workspace WORKSPACE] --format json
  msw app metrics --workspace WORKSPACE --format json --once
  msw app logs --workspace WORKSPACE --format jsonl
  msw app repositories --workspace WORKSPACE [--if-running] --format json
  msw app directory-list --workspace WORKSPACE [--path PATH] [--limit 1..200] --format json
  msw app directory-search --workspace WORKSPACE [--path PATH] --query QUERY [--limit 1..200] --format json
  msw app editor-target --workspace WORKSPACE [--path PATH] --format json
  msw app push-plan --workspace WORKSPACE --repositories PATH... --format json
  msw app ports [--workspace WORKSPACE] --format json
  msw app github-state [--workspace WORKSPACE] --format json
  msw app github-policy-get [--workspace WORKSPACE] --format json
  msw app github-policy-set --workspace WORKSPACE --repository OWNER/REPO --mode read-only|read-write [--remove] [--clear] --format json
  msw app github-policy-apply --format json   (full desired policy JSON on stdin; provision+commit atomically)
  msw app github-bind --workspace WORKSPACE --repository OWNER/REPO --mode read-only|host-write --format json
  msw app github-unbind --workspace WORKSPACE --format json
  msw app github-quarantine --workspace WORKSPACE --format json
  msw app url --workspace WORKSPACE [--port PORT] [--scheme http|https] --format json
  msw app clone --workspace WORKSPACE --repository OWNER/REPO [--destination PATH] --format json
  msw app pull --workspace WORKSPACE [--path PATH|all] --format json
  msw app identity --name NAME --email EMAIL [--workspace WORKSPACE] --format json
  msw app disk [--workspace WORKSPACE] --format json
  msw app resize --workspace WORKSPACE --memory SIZE [--cpus COUNT] --format json
  msw app clean [--workspace WORKSPACE] [--volumes] --confirmation-fd FD --format json
  msw app upgrade [--workspace WORKSPACE] --confirmation-fd FD --format json
  msw app update --confirmation-fd FD --format json
  msw app check [--deep --confirmation-fd FD] --format json
  msw app backup-preview --directory DIRECTORY --format json
  msw app backup --directory DIRECTORY --format json
  msw app restore --archive ARCHIVE --confirmation-fd FD --format json
  msw app plan ACTION --workspace WORKSPACE --format json
  msw app apply PLAN_ID --confirmation-fd FD --format json
  msw app bootstrap --resume --workspace-config-fd FD [--events-fd FD] --format json

Every finite command returns one schemaVersion=1 JSON envelope. Lifecycle
observations never start a VM; unknown or unavailable observations are not
reported as Stopped.
APPHELP
}

cmd_app() {
  local sub="${1:-handshake}"
  shift || true
  MSW_APP_COMMAND="$sub"
  MSW_APP_REQUEST_ID="$(app_request_id)"
  trap app_unexpected_error ERR
  case "$sub" in
    handshake) app_cmd_handshake "$@" ;;
    state) app_cmd_state "$@" ;;
    url) app_cmd_url "$@" ;;
    clone) app_cmd_clone "$@" ;;
    pull) app_cmd_pull "$@" ;;
    identity) app_cmd_identity "$@" ;;
    disk) app_cmd_disk "$@" ;;
    resize) app_cmd_resize "$@" ;;
    clean) app_cmd_clean "$@" ;;
    upgrade) app_cmd_upgrade "$@" ;;
    update) app_cmd_update "$@" ;;
    check) app_cmd_check "$@" ;;
    backup-preview) app_cmd_backup_preview "$@" ;;
    backup) app_cmd_backup "$@" ;;
    restore) app_cmd_restore "$@" ;;
    push-plan) app_cmd_push_plan "$@" ;;
    metrics) app_cmd_metrics "$@" ;;
    logs) app_cmd_logs "$@" ;;
    repositories) app_cmd_repositories "$@" ;;
    directory-list) app_cmd_directory_query directory-list list "$@" ;;
    directory-search) app_cmd_directory_query directory-search search "$@" ;;
    editor-target) app_cmd_editor_target "$@" ;;
    ports) app_cmd_ports "$@" ;;
    github-state) app_cmd_github_state "$@" ;;
    github-policy-get) app_cmd_github_policy_get "$@" ;;
    github-policy-set) app_cmd_github_policy_set "$@" ;;
    github-policy-apply) app_cmd_github_policy_apply "$@" ;;
    github-bind) app_cmd_github_bind "$@" ;;
    github-unbind) app_cmd_github_unbind "$@" ;;
    github-quarantine) app_cmd_github_quarantine "$@" ;;
    plan) app_cmd_plan "$@" ;;
    apply) app_cmd_apply "$@" ;;
    bootstrap) app_cmd_bootstrap "$@" ;;
    help|--help|-h) app_cmd_help ;;
    *) app_emit_error app "MSW_UNKNOWN_COMMAND" "Unknown app command." "Run 'msw app help'." "" false 64 ;;
  esac
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    version|--version|-V) printf 'msw %s\n' "$MSW_VERSION"; return ;;
    help|--help|-h) show_help; return ;;
    docs) (( $# <= 1 )) || fatal "usage: msw docs [cheatsheet|setup|github|tests]"; cmd_docs "${1:-cheatsheet}"; return ;;
    app) cmd_app "$@"; return ;;
  esac
  require_command_path msb "$MSB_BIN"
  if is_workspace "$command"; then
      (( $# <= 1 )) || fatal "usage: msw $command [PATH]"
      cmd_shell "$command" "${1:-}"
      return
  fi
  case "$command" in
    shell)
      (( $# >= 1 && $# <= 2 )) || fatal "usage: msw shell WORKSPACE [PATH]"
      cmd_shell "$1" "${2:-}"
      ;;
    zed)
      (( $# >= 1 && $# <= 2 )) || fatal "usage: msw zed WORKSPACE [PATH]"
      cmd_zed "$1" "${2:-}"
      ;;
    open)
      (( $# >= 1 && $# <= 3 )) || fatal "usage: msw open WORKSPACE [PORT] [http|https]"
      cmd_open "$1" "${2:-3000}" "${3:-http}"
      ;;
    url)
      (( $# >= 1 && $# <= 3 )) || fatal "usage: msw url WORKSPACE [PORT] [http|https]"
      cmd_url "$1" "${2:-3000}" "${3:-http}"
      ;;
    ports) cmd_ports "${1:-all}" ;;
    tunnel)
      (( $# >= 2 && $# <= 3 )) || fatal "usage: msw tunnel WORKSPACE REMOTE_PORT [LOCAL_PORT]"
      cmd_tunnel "$1" "$2" "${3:-$2}"
      ;;
    clone)
      (( $# >= 2 && $# <= 3 )) || fatal "usage: msw clone WORKSPACE OWNER/REPO [PATH]"
      cmd_clone "$1" "$2" "${3:-}"
      ;;
    repos) (( $# == 1 )) || fatal "usage: msw repos WORKSPACE"; cmd_repos "$1" ;;
    pull)
      (( $# >= 1 && $# <= 2 )) || fatal "usage: msw pull WORKSPACE [PATH|all]"
      cmd_pull "$1" "${2:-all}"
      ;;
    push)
      (( $# >= 2 )) || fatal "usage: msw push WORKSPACE PATH [--yes] [--force-with-lease]"
      local push_box="$1" push_path="$2"; shift 2
      cmd_push "$push_box" "$push_path" "$@"
      ;;
    identity)
      (( $# >= 2 && $# <= 3 )) || fatal 'usage: msw identity "NAME" EMAIL [WORKSPACE|all]'
      cmd_identity "$1" "$2" "${3:-all}"
      ;;
    github) cmd_github "$@" ;;
    start) cmd_start "${1:-all}" ;;
    stop) cmd_stop "${1:-all}" ;;
    restart) cmd_restart "${1:-all}" ;;
    status|ps) cmd_status ;;
    metrics) cmd_metrics "${1:-all}" ;;
    logs) (( $# >= 1 )) || fatal "usage: msw logs WORKSPACE [OPTIONS]"; local logs_box="$1"; shift; cmd_logs "$logs_box" "$@" ;;
    exec) (( $# >= 2 )) || fatal "usage: msw exec WORKSPACE COMMAND..."; local exec_box="$1"; shift; cmd_exec "$exec_box" "$@" ;;
    disk) cmd_disk "${1:-all}" ;;
    resize) (( $# >= 2 && $# <= 3 )) || fatal "usage: msw resize WORKSPACE MEMORY [CPUS]"; cmd_resize "$1" "$2" "${3:-}" ;;
    clean) cmd_clean "$@" ;;
    upgrade) cmd_upgrade "${1:-all}" ;;
    update) cmd_update ;;
    check) cmd_check "$@" ;;
    host)
      [[ "${1:-}" == repair && $# == 1 ]] || fatal "usage: msw host repair"
      cmd_host_repair
      ;;
    __github-verify-transaction)
      (( $# >= 2 && $# <= 3 )) || fatal "internal GitHub verification arguments missing"
      [[ "${MSW_GITHUB_VERIFY_INHERITED:-0}" == 1 ]] || fatal "internal GitHub verification lock missing"
      "$LOCKF_BIN" -s -t 0 9 >/dev/null 2>&1 || fatal "internal GitHub verification lock missing"
      cmd_github_verify "$1" "$2" "${3:-}" 1
      ;;
    __workspace-state-init)
      (( $# == 1 )) || fatal "internal workspace state arguments missing"
      __workspace_state_init "$@"
      ;;
    __port-forwarder-start)
      (( $# == 1 )) || fatal "internal port forwarder arguments missing"
      port_forwarder_start "$1"
      ;;
    __proxy-plist-render)
      (( $# == 0 )) || fatal "internal proxy plist arguments missing"
      github_proxy_render_plist || fatal "could not render the GitHub proxy launch agent plist"
      ;;
    __verify-vendored-h11)
      # Phase 1 entry point for setup.sh / proxy start; also used by tests.
      verify_vendored_h11
      ;;
    backup) (( $# <= 1 )) || fatal "usage: msw backup [DIRECTORY]"; cmd_backup "${1:-$MSW_BACKUP_DIR}" ;;
    restore) cmd_restore "$@" ;;
    *) fatal "unknown command '$command'; run: msw help" ;;
  esac
}

# ============================================================================
# Vendored h11 verification region — Path C §6 (append-only; Phase 1 may wire
# MSW_VENDOR_H11_ENFORCED or call verify_vendored_h11 directly, but MUST NOT
# edit the existing helper below).
# ----------------------------------------------------------------------------
# Phase 0: verify_vendored_h11 plus guarded (no-op) call sites in cmd_check /
# cmd_update. Self-contained so setup.sh can invoke it in Phase 1: verifies
# every vendored file's SHA-256 against the lib/vendor/h11 block in
# MANIFEST.txt AND the vendored __version__ floor, importing h11 ONLY from the
# vendored tree via sys.path insertion — never from site-packages. Any failure
# exits nonzero (setup fails / proxy refuses to start in Phase 1).
readonly MSW_VENDOR_H11_FLOOR="0.16.0"
readonly MSW_VENDOR_H11_ENFORCED="${MSW_VENDOR_H11_ENFORCED:-0}"

verify_vendored_h11() {
  local vendor_dir manifest py_bin shasum_bin script_dir root \
        entry sha path rel file actual version status=0 count=0 tree_file manifest_paths=""
  vendor_dir="${MSW_VENDOR_H11_DIR:-}"
  manifest="${MSW_MANIFEST_FILE:-}"
  py_bin="${MSW_PYTHON_BIN:-/usr/bin/python3}"
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd -P)" || return 1
  root="$(cd "$script_dir/.." && pwd -P)" || return 1
  [[ -n "$vendor_dir" ]] || vendor_dir="$root/lib/vendor/h11"
  [[ -n "$manifest" ]] || manifest="$root/MANIFEST.txt"
  vendor_dir="${vendor_dir%/}"
  [[ -d "$vendor_dir" ]] || { warn "vendored h11 tree missing: $vendor_dir"; return 1; }
  [[ -f "$manifest" ]] || { warn "MANIFEST.txt missing: $manifest"; return 1; }
  [[ -x "$py_bin" ]] || { warn "python3 not found at $py_bin"; return 1; }
  shasum_bin="${SHASUM_BIN:-shasum}"
  command -v "$shasum_bin" >/dev/null 2>&1 || { warn "shasum not found"; return 1; }
  # 1) Every lib/vendor/h11 entry in MANIFEST.txt must exist with a matching
  #    SHA-256; the entry set is collected for the completeness check below.
  while IFS= read -r entry; do
    case "$entry" in
      \#*|'') continue ;;
      *lib/vendor/h11/*)
        sha="${entry%%  *}"
        path="${entry#*  }"
        [[ "$path" == lib/vendor/h11/* ]] || continue
        rel="${path#lib/vendor/h11/}"
        file="$vendor_dir/$rel"
        [[ -f "$file" ]] || { warn "vendored file missing: $path"; status=1; continue; }
        actual="$("$shasum_bin" -a 256 "$file" 2>/dev/null | cut -d' ' -f1)"
        if [[ "$actual" != "$sha" ]]; then
          warn "vendored hash mismatch for $path (manifest $sha, actual ${actual:-<unreadable>})"
          status=1
        fi
        manifest_paths+="$path"$'\n'
        count=$((count+1))
        ;;
    esac
  done < "$manifest"
  # 2) Every file in the vendored tree must be listed in MANIFEST.txt.
  while IFS= read -r tree_file; do
    rel="${tree_file#"$vendor_dir"/}"
    if [[ "$rel" == "$tree_file" ]] || ! grep -Fxq "lib/vendor/h11/$rel" <<<"$manifest_paths"; then
      warn "vendored file missing from MANIFEST.txt: lib/vendor/h11/$rel"
      status=1
    fi
  done < <(find "$vendor_dir" -type f | sort)
  (( count > 0 )) || { warn "no lib/vendor/h11 entries in MANIFEST.txt"; return 1; }
  (( status == 0 )) || { warn "vendored h11 hash verification failed"; return 1; }
  # 3) Vendored __version__ floor, importing ONLY from the vendored tree.
  version="$("$py_bin" - "$vendor_dir" "$MSW_VENDOR_H11_FLOOR" <<'PY'
import os, re, sys
vendor_dir = os.path.realpath(sys.argv[1])
floor = sys.argv[2]
sys.path.insert(0, os.path.dirname(vendor_dir))
import h11
mod_dir = os.path.realpath(os.path.dirname(h11.__file__))
if mod_dir != vendor_dir:
    sys.stderr.write("h11 resolved to %s, not the vendored tree %s\n" % (mod_dir, vendor_dir))
    sys.exit(1)
def version_key(v):
    return [int(x) for x in re.split(r"[^0-9]+", v) if x]
if version_key(h11.__version__) < version_key(floor):
    sys.stderr.write("vendored h11 %s is below the floor %s\n" % (h11.__version__, floor))
    sys.exit(1)
print(h11.__version__)
PY
)"
  (( $? == 0 )) || { warn "vendored h11 version check failed"; return 1; }
  ok "vendored h11 $version verified ($count files, floor $MSW_VENDOR_H11_FLOOR)"
  return 0
}

# Guarded call sites — no-ops while MSW_VENDOR_H11_ENFORCED is 0, so existing
# commands behave unchanged this phase. Phase 1 flips the flag to enforce.
verify_vendored_h11_if_enforced() {
  (( MSW_VENDOR_H11_ENFORCED == 1 )) || return 0
  verify_vendored_h11 || fatal "vendored h11 verification failed"
}
# ============================================================================
# End vendored h11 verification region
# ============================================================================


if [[ "${MSW_SOURCE_ONLY:-0}" != 1 ]]; then
  main "$@"
fi
