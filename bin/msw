#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE="${MSW_CONFIG_FILE:-$HOME/.config/msw/config.sh}"
MSW_APP_MODE=0
[[ "${1:-}" == app ]] && MSW_APP_MODE=1
MSW_APP_ROOT_SUBSHELL="${BASH_SUBSHELL:-0}"
MSW_APP_RESPONSE_EMITTED=0
MSW_APP_COMMAND="app"
if [[ ! -f "$CONFIG_FILE" ]]; then
  if (( MSW_APP_MODE == 0 )); then
    printf 'msw: missing %s\nRun the MicroSandbox Workspaces setup installer.\n' "$CONFIG_FILE" >&2
    exit 1
  fi
  MSW_CONFIG_AVAILABLE=0
else
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
  MSW_CONFIG_AVAILABLE=1
fi
# App protocol commands must be able to report a typed configuration error
# without requiring a shell profile or a live MicroSandbox installation.
: "${MSW_PUBLISHED_PORTS:=3000,5173,8080}"
: "${MSW_DEV_IP:=127.0.0.10}"
: "${MSW_PLAYGROUNDS_IP:=127.0.0.11}"
: "${MSW_PERSONAL_IP:=127.0.0.12}"
: "${MSW_DEV_HOST:=dev.msw.test}"
: "${MSW_PLAYGROUNDS_HOST:=playgrounds.msw.test}"
: "${MSW_PERSONAL_HOST:=personal.msw.test}"

readonly WORKSPACES=(dev playgrounds personal)
readonly READ_KEYCHAIN_SERVICE="msw.github.read"
readonly WRITE_KEYCHAIN_SERVICE="msw.github.write"
readonly GITHUB_META_DIR="$HOME/.config/msw/github"
readonly APP_CREDENTIALS_FILE="$HOME/Library/Application Support/MSW Monitor/credentials.json"
SETUP_TRANSACTION_ACTIVE=0
SETUP_TRANSACTION_BOX=""
GITHUB_LOCK_HELD=0

MSB_BIN="${MSW_MSB_BIN:-$(command -v msb 2>/dev/null || true)}"
SSH_BIN="${MSW_SSH_BIN:-$(command -v ssh 2>/dev/null || true)}"
CURL_BIN="${MSW_CURL_BIN:-$(command -v curl 2>/dev/null || true)}"
GIT_BIN="${MSW_GIT_BIN:-$(command -v git 2>/dev/null || true)}"
JQ_BIN="${MSW_JQ_BIN:-$(command -v jq 2>/dev/null || true)}"
OPEN_BIN="${MSW_OPEN_BIN:-/usr/bin/open}"
SECURITY_BIN="${MSW_SECURITY_BIN:-/usr/bin/security}"
ASKPASS_BIN="${MSW_ASKPASS_BIN:-$HOME/.local/libexec/msw-git-askpass}"
GTAR_BIN="${MSW_GTAR_BIN:-$(command -v gtar 2>/dev/null || command -v tar 2>/dev/null || true)}"
ZSTD_BIN="${MSW_ZSTD_BIN:-$(command -v zstd 2>/dev/null || true)}"
SHASUM_BIN="${MSW_SHASUM_BIN:-$(command -v shasum 2>/dev/null || true)}"
LOCKF_BIN="${MSW_LOCKF_BIN:-$(command -v lockf 2>/dev/null || true)}"

fatal() { printf 'msw: %s\n' "$*" >&2; exit 1; }
note() { printf '\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mwarning: %s\033[0m\n' "$*" >&2; }
ok() { printf '\033[1;32m✓\033[0m %s\n' "$*"; }

require_command_path() {
  local label="$1" value="$2"
  [[ -n "$value" && -x "$value" ]] || fatal "'$label' is required"
}

is_workspace() {
  case "${1:-}" in dev|playgrounds|personal) return 0 ;; *) return 1 ;; esac
}

validate_workspace() {
  is_workspace "${1:-}" || fatal "workspace must be dev, playgrounds, or personal"
}

for_targets() {
  local target="${1:-all}" box
  if [[ "$target" == all ]]; then
    for box in "${WORKSPACES[@]}"; do printf '%s\n' "$box"; done
  else
    validate_workspace "$target"
    printf '%s\n' "$target"
  fi
}

workspace_ip() {
  case "$1" in
    dev) printf '%s\n' "$MSW_DEV_IP" ;;
    playgrounds) printf '%s\n' "$MSW_PLAYGROUNDS_IP" ;;
    personal) printf '%s\n' "$MSW_PERSONAL_IP" ;;
  esac
}

workspace_host() {
  case "$1" in
    dev) printf '%s\n' "$MSW_DEV_HOST" ;;
    playgrounds) printf '%s\n' "$MSW_PLAYGROUNDS_HOST" ;;
    personal) printf '%s\n' "$MSW_PERSONAL_HOST" ;;
  esac
}

workspace_ssh_host() { printf '%s.msb\n' "$1"; }
workspace_volume() { printf 'msw-%s-%s\n' "$1" "$2"; }

safe_key_component() { printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'; }

keychain_test_file() {
  local service account
  service="$(safe_key_component "$1")"
  account="$(safe_key_component "$2")"
  printf '%s/%s__%s\n' "$MSW_TEST_KEYCHAIN_DIR" "$service" "$account"
}

keychain_get() {
  local service="$1" account="$2"
  if [[ -n "${MSW_TEST_KEYCHAIN_DIR:-}" ]]; then
    local file
    file="$(keychain_test_file "$service" "$account")"
    [[ -f "$file" ]] || return 1
    cat "$file"
  else
    "$SECURITY_BIN" find-generic-password -w -s "$service" -a "$account" 2>/dev/null
  fi
}

keychain_has() {
  local service="$1" account="$2"
  case "$service" in
    "$READ_KEYCHAIN_SERVICE")
      app_credential_available "$account" guest && return 0
      ;;
    "$WRITE_KEYCHAIN_SERVICE")
      app_credential_available "$account" host && return 0
      ;;
  esac
  keychain_get "$service" "$account" >/dev/null 2>&1
}


keychain_set() {
  local service="$1" account="$2" value="$3"
  if [[ -n "${MSW_TEST_KEYCHAIN_DIR:-}" ]]; then
    local file
    mkdir -p "$MSW_TEST_KEYCHAIN_DIR"
    chmod 700 "$MSW_TEST_KEYCHAIN_DIR"
    file="$(keychain_test_file "$service" "$account")"
    umask 077
    printf '%s' "$value" >"$file"
  else
    "$SECURITY_BIN" add-generic-password -U -s "$service" -a "$account" -w "$value" >/dev/null
  fi
}

keychain_item_not_found() {
  local status="$1" error="$2"
  [[ "$status" == 44 ]] && return 0
  case "$error" in
    *"The specified item could not be found in the keychain."*) return 0 ;;
    *) return 1 ;;
  esac
}

keychain_delete() {
  local service="$1" account="$2" error="" status
  if [[ -n "${MSW_TEST_KEYCHAIN_DIR:-}" ]]; then
    rm -f "$(keychain_test_file "$service" "$account")"
  else
    if error="$("$SECURITY_BIN" delete-generic-password -s "$service" -a "$account" 2>&1)"; then
      status=0
    else
      status=$?
    fi
    if (( status != 0 )) && ! keychain_item_not_found "$status" "$error"; then
      printf 'msw: could not delete Keychain item %s/%s: %s\n' "$service" "$account" "${error:-security exited $status}" >&2
      return 1
    fi
    if error="$("$SECURITY_BIN" find-generic-password -w -s "$service" -a "$account" 2>&1)"; then
      printf 'msw: Keychain item still exists %s/%s\n' "$service" "$account" >&2
      return 1
    else
      status=$?
    fi
    if ! keychain_item_not_found "$status" "$error"; then
      printf 'msw: could not verify Keychain item removal %s/%s: %s\n' "$service" "$account" "${error:-security exited $status}" >&2
      return 1
    fi
  fi
  return 0
}

metadata_file() { printf '%s/%s.conf\n' "$GITHUB_META_DIR" "$1"; }

metadata_access() {
  local box="$1" file
  file="$(metadata_file "$box")"
  if app_metadata_profile_present "$box" guest; then
    # Native OAuth credentials are independent guest and host profiles. The
    # guest profile remains read-only after host authorization, so aggregate
    # write capability must be derived from the host profile as well.
    if app_metadata_profile_present "$box" host &&
      [[ "$(app_metadata_value "$box" host accessMode 2>/dev/null || true)" == host-write ]]; then
      printf 'host-write\n'
    else
      app_metadata_value "$box" guest accessMode
    fi
  elif [[ -f "$file" && ! -L "$file" ]]; then
    sed -n 's/^access=//p' "$file" | head -n 1
  else
    return 1
  fi
}

metadata_repo() {
  local box="$1" file
  file="$(metadata_file "$box")"
  if app_metadata_profile_present "$box" guest; then
    app_metadata_value "$box" guest verificationRepository
  elif [[ -f "$file" && ! -L "$file" ]]; then
    sed -n 's/^verification_repo=//p' "$file" | head -n 1
  else
    return 1
  fi
}


app_credential_environment_token() {
  local box="$1" role="$2" suffix variable value=""
  suffix="$(printf '%s' "$box" | tr '[:lower:]' '[:upper:]')"
  case "$role" in
    guest) variable="MSW_GITHUB_READ_TOKEN_${suffix}" ;;
    host) variable="MSW_GITHUB_WRITE_TOKEN_${suffix}" ;;
    *) return 1 ;;
  esac
  value="${!variable:-}"
  if [[ -z "$value" ]]; then
    case "$role" in
      guest) value="${MSW_GITHUB_READ_TOKEN:-}" ;;
      host) value="${MSW_GITHUB_WRITE_TOKEN:-}" ;;
    esac
  fi
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

app_keychain_service() {
  local box="$1" role="$2"
  case "$role" in
    guest) printf 'msw.github.app.%s.guest.tokens' "$box" ;;
    host) printf 'msw.github.app.%s.host.tokens' "$box" ;;
    *) return 1 ;;
  esac
}

app_keychain_get() {
  local box="$1" role="$2" service raw
  [[ -z "${MSW_TEST_KEYCHAIN_DIR:-}" ]] || return 1
  app_metadata_profile_present "$box" "$role" || return 1
  service="$(app_keychain_service "$box" "$role")"
  raw="$("$SECURITY_BIN" find-generic-password -w -s "$service" -a profile 2>/dev/null)" || return 1
  # Native MSW Monitor keeps the access/refresh pair as one atomic Keychain
  # record. This broker emits only the access token to callers such as Git.
  [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] || return 1
  "$JQ_BIN" -e '
    type == "object" and
    .schemaVersion == 2 and
    (.accessToken | type == "string" and length > 0) and
    (.refreshToken | type == "string" and length > 0) and
    (.accessExpiresAt | type == "string" and length > 0) and
    (.refreshExpiresAt | type == "string" and length > 0) and
    (.generation | type == "number" and . > 0)
  ' <<<"$raw" >/dev/null 2>&1 || return 1
  "$JQ_BIN" -r '.accessToken' <<<"$raw"
}

app_keychain_has() {
  local box="$1" role="$2"
  [[ -z "${MSW_TEST_KEYCHAIN_DIR:-}" ]] || return 1
  app_metadata_profile_present "$box" "$role" || return 1
  app_keychain_get "$box" "$role" >/dev/null 2>&1
}

app_credential_available() {
  local box="$1" role="$2"
  app_credential_environment_token "$box" "$role" >/dev/null 2>&1 ||
    app_keychain_has "$box" "$role"
}

app_credential_value() {
  local box="$1" role="$2" value
  if value="$(app_credential_environment_token "$box" "$role" 2>/dev/null)"; then
    printf '%s' "$value"
  else
    app_keychain_get "$box" "$role"
  fi
}

app_metadata_value() {
  local box="$1" role="$2" field="$3" key
  [[ -f "$APP_CREDENTIALS_FILE" && ! -L "$APP_CREDENTIALS_FILE" ]] || return 1
  [[ -n "${JQ_BIN:-}" && -x "${JQ_BIN:-}" ]] || return 1
  key="$box.$role"
  "$JQ_BIN" -r --arg key "$key" --arg field "$field" \
    '.entries[$key][$field] // empty' "$APP_CREDENTIALS_FILE" 2>/dev/null
}

app_metadata_profile_present() {
  local box="$1" role="$2" value
  value="$(app_metadata_value "$box" "$role" workspace 2>/dev/null || true)"
  [[ "$value" == "$box" ]]
}

write_metadata() {
  local box="$1" repo="$2" access="${3:-host-write}"
  mkdir -p "$GITHUB_META_DIR"
  chmod 700 "$GITHUB_META_DIR"
  umask 077
  printf 'verification_repo=%s\naccess=%s\nconfigured_at=%s\n' "$repo" "$access" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$(metadata_file "$box")"
}

sandbox_exists() { workspace_msb "$1" inspect "$1" >/dev/null 2>&1; }
sandbox_inspect_state() {
  local box="$1" output
  if output="$(workspace_msb "$box" inspect "$box" 2>&1)"; then return 0; fi
  [[ "$output" == *"sandbox not found"* ]] && return 1
  return 2
}
github_tls_interception_enabled() {
  local box="$1" output enabled
  require_command_path jq "$JQ_BIN"
  output="$("$MSB_BIN" inspect "$box" --format json 2>/dev/null)" || return 2
  enabled="$(printf '%s\n' "$output" | "$JQ_BIN" -r '(.active_config // .config).network.tls.enabled // false' 2>/dev/null)" || return 2
  [[ "$enabled" == true ]]
}

require_github_tls_interception() {
  local box="$1" status
  if github_tls_interception_enabled "$box"; then
    return 0
  else
    status=$?
  fi
  if (( status == 1 )); then
    fatal "workspace '$box' has TLS interception disabled; recreate it with: ./setup.sh --recreate-workspaces"
  fi
  fatal "could not inspect TLS interception for workspace '$box'; recreate it with: ./setup.sh --recreate-workspaces"
}
snapshot_exists() { "$MSB_BIN" snapshot inspect "$1" >/dev/null 2>&1; }
volume_exists() { "$MSB_BIN" volume inspect "$1" >/dev/null 2>&1; }
quarantine_file() { printf '%s/%s.quarantine\n' "$GITHUB_META_DIR" "$1"; }
github_lock_file() { printf '%s/%s.lock\n' "$GITHUB_META_DIR" "$1"; }
github_lock_reclaim_legacy() {
  local lock="$1" owner="" moved_owner="" stale="${lock}.legacy.$$.$RANDOM"
  if [[ -f "$lock/pid" ]]; then
    owner="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then return 1; fi
  fi
  [[ ! -e "$stale" ]] || return 1
  if ! mv "$lock" "$stale" 2>/dev/null; then return 1; fi
  moved_owner="$(cat "$stale/pid" 2>/dev/null || true)"
  if [[ "$moved_owner" =~ ^[0-9]+$ ]] && kill -0 "$moved_owner" 2>/dev/null; then
    if [[ ! -e "$lock" ]]; then mv "$stale" "$lock" 2>/dev/null || true; fi
    return 1
  fi
  # The rename owns this directory; remove its stale pid before removing it.
  if ! rm -f "$stale/pid" 2>/dev/null || ! rmdir "$stale" 2>/dev/null; then return 1; fi
}
github_lock_release() {
  if (( GITHUB_LOCK_HELD )); then
    exec 9>&-
    GITHUB_LOCK_HELD=0
  fi
  trap - EXIT
}

github_lock_exit() {
  local status="${1:-1}"
  trap - EXIT
  github_lock_release
  exit "$status"
}

github_lock_acquire() {
  local box="$1" lock
  require_command_path lockf "$LOCKF_BIN"
  mkdir -p "$GITHUB_META_DIR" || return 1
  chmod 700 "$GITHUB_META_DIR" || return 1
  lock="$(github_lock_file "$box")"
  if [[ -d "$lock" ]]; then
    if ! github_lock_reclaim_legacy "$lock"; then
      (( MSW_APP_MODE == 1 )) && return 1
      fatal "GitHub operation already in progress for workspace '$box'"
    fi
  fi
  if ! exec 9>>"$lock"; then return 1; fi
  if ! "$LOCKF_BIN" -s -t 0 9; then
    exec 9>&-
    (( MSW_APP_MODE == 1 )) && return 1
    fatal "GitHub operation already in progress for workspace '$box'"
  fi
  if ! printf '%s\n' "$$" >"$lock"; then
    exec 9>&-
    return 1
  fi
  GITHUB_LOCK_HELD=1
  trap 'github_lock_exit $?' EXIT
}

assert_not_quarantined() {
  local box="$1" file role app_quarantined=0
  [[ "${MSW_ALLOW_QUARANTINED:-0}" == 1 ]] && return 0
  file="$(quarantine_file "$box")"
  if [[ -e "$file" || -L "$file" ]]; then
    fatal "workspace '$box' is quarantined; repair it with: msw github setup $box OWNER/REPO"
  fi
  for role in guest host; do
    if app_metadata_profile_present "$box" "$role" &&
      [[ "$(app_metadata_value "$box" "$role" quarantined 2>/dev/null || true)" == true ]]; then
      app_quarantined=1
    fi
  done
  (( app_quarantined == 0 )) ||
    fatal "workspace '$box' is quarantined; repair it from MSW Monitor setup"
}

sandbox_running() {
  local box="$1" status
  status="$(workspace_msb "$box" status "$box" --format json 2>/dev/null)" || return 2
  status="$(printf '%s' "$status" | tr -d '[:space:]')"
  case "$status" in
    *'"status":"Running"'*) return 0 ;;
    *'"status":"Stopped"'*) return 1 ;;
    *) return 2 ;;
  esac
}

quarantine_workspace() {
  local box="$1" reason="${2:-GitHub credential cleanup failed}" file attempt=0 stop_failed=0 running_rc inspect_rc
  file="$(quarantine_file "$box")"
  mkdir -p "$GITHUB_META_DIR" || return 1
  chmod 700 "$GITHUB_META_DIR" || return 1
  umask 077 || return 1
  printf '%s\n' "$reason" >"$file" || return 1
  if sandbox_inspect_state "$box"; then
    :
  else
    inspect_rc=$?
    if (( inspect_rc == 1 )); then return 0; fi
    printf 'msw: could not inspect quarantined workspace %s; stop not confirmed\n' "$box" >&2
    return 1
  fi
  if ! workspace_msb "$box" stop -q -t 60 "$box" >/dev/null 2>&1; then stop_failed=1; fi
  while (( attempt < 5 )); do
    if sandbox_running "$box"; then
      :
    else
      running_rc=$?
      if (( running_rc == 1 )); then return 0; fi
    fi
    attempt=$((attempt + 1))
    if (( attempt < 5 )); then sleep 1; fi
  done
  if (( stop_failed )); then
    printf 'msw: could not stop quarantined workspace %s\n' "$box" >&2
  else
    printf 'msw: could not prove quarantined workspace %s is stopped\n' "$box" >&2
  fi
  return 1
}

clear_quarantine() {
  local file
  file="$(quarantine_file "$1")"
  rm -f "$file"
  [[ ! -e "$file" ]]
}
setup_transaction_arm() {
  SETUP_TRANSACTION_BOX="$1"
  SETUP_TRANSACTION_ACTIVE=1
  trap 'setup_transaction_trap EXIT $?' EXIT
  trap 'setup_transaction_trap INT 130' INT
  trap 'setup_transaction_trap TERM 143' TERM
  trap 'setup_transaction_trap HUP 129' HUP
}

setup_transaction_disarm() {
  SETUP_TRANSACTION_ACTIVE=0
  SETUP_TRANSACTION_BOX=""
  trap - EXIT INT TERM HUP
  if (( GITHUB_LOCK_HELD )); then trap 'github_lock_exit $?' EXIT; fi
}

setup_transaction_trap() {
  local signal="$1" status="${2:-1}"
  trap - EXIT
  trap '' INT TERM HUP
  if (( SETUP_TRANSACTION_ACTIVE )); then
    SETUP_TRANSACTION_ACTIVE=0
    quarantine_workspace "$SETUP_TRANSACTION_BOX" "GitHub setup interrupted" >/dev/null 2>&1 || true
  fi
  github_lock_release
  trap - INT TERM HUP
  exit "$status"
}

read_token_for_workspace() {
  local box="$1"
  app_credential_value "$box" guest 2>/dev/null ||
    keychain_get "$READ_KEYCHAIN_SERVICE" "$box"
}



workspace_msb() {
  local box="$1"
  shift
  "$MSB_BIN" "$@" 9>&-
}

workspace_msb_with_read_token() {
  local box="$1" token="" status
  shift
  if token="$(read_token_for_workspace "$box" 2>/dev/null)"; then
    if GH_TOKEN="$token" "$MSB_BIN" "$@" 9>&-; then
      status=0
    else
      status=$?
    fi
    unset token
    return "$status"
  fi
  "$MSB_BIN" "$@" 9>&-
}

start_sandbox() {
  local box="$1"
  assert_not_quarantined "$box"
  if ! keychain_has "$READ_KEYCHAIN_SERVICE" "$box" &&
    { [[ -f "$(metadata_file "$box")" ]] || app_metadata_profile_present "$box" guest; }; then
    fatal "GitHub is configured for '$box', but its read token is missing from Keychain. Run: msw github setup $box OWNER/REPO"
  fi
  workspace_msb_with_read_token "$box" start -q "$box"
}


wait_for_guest_systemd() {
  local box="$1" attempt=0
  until workspace_msb "$box" exec --no-tty "$box" -- systemctl daemon-reload >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    (( attempt < 120 )) || fatal "$box systemd bus did not become ready"
    sleep 1
  done
}

ensure_running() {
  local box="$1" attempt=0 output=""
  validate_workspace "$box"
  assert_not_quarantined "$box"
  sandbox_exists "$box" || fatal "workspace '$box' does not exist; rerun setup.sh"
  if workspace_msb "$box" ping -q "$box" >/dev/null 2>&1; then
    wait_for_guest_systemd "$box"
    return 0
  fi
  note "Starting $box"
  if ! output="$(start_sandbox "$box" 2>&1)"; then
    sleep 1
    if ! workspace_msb "$box" ping -q "$box" >/dev/null 2>&1; then
      [[ -n "$output" ]] && printf '%s\n' "$output" >&2
      fatal "workspace '$box' could not start; run 'msw logs $box'"
    fi
  fi
  until workspace_msb "$box" ping -q "$box" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    (( attempt < 120 )) || fatal "workspace '$box' did not become ready"
    sleep 1
  done
  wait_for_guest_systemd "$box"
}

guest_exec() {
  local box="$1"; shift
  ensure_running "$box"
  workspace_msb "$box" exec --no-tty "$box" -- "$@"
}

guest_exec_w() {
  local box="$1" workdir="$2"; shift 2
  ensure_running "$box"
  workspace_msb "$box" exec --no-tty -w "$workdir" "$box" -- "$@"
}

guest_script() {
  local box="$1" script="$2"; shift 2
  ensure_running "$box"
  printf '%s\n' "$script" | workspace_msb "$box" exec --no-tty "$box" -- bash -s -- "$@"
}

validate_relative_path() {
  local path="${1:-}" component
  [[ -n "$path" ]] || fatal "path cannot be empty"
  [[ "$path" != /* ]] || fatal "path must be relative to /workspace"
  [[ "$path" != *$'\n'* && "$path" != *$'\r'* && "$path" != *$'\t'* ]] || fatal "path contains a control character"
  if [[ "$path" == . ]]; then return 0; fi
  IFS='/' read -r -a _parts <<<"$path"
  for component in "${_parts[@]}"; do
    [[ -n "$component" && "$component" != . && "$component" != .. ]] || fatal "path may not contain empty, '.' or '..' components"
  done
}

resolve_workspace_path() {
  local requested="${1:-}"
  if [[ -z "$requested" || "$requested" == . ]]; then
    printf '/workspace\n'
  else
    validate_relative_path "$requested"
    printf '/workspace/%s\n' "$requested"
  fi
}

resolve_guest_repo() {
  local box="$1" relative="$2"
  validate_workspace "$box"
  validate_relative_path "$relative"
  local script
  read -r -d '' script <<'SCRIPT' || true
set -Eeuo pipefail
relative="$1"
root="${MSW_GUEST_WORKSPACE_ROOT:-/workspace}"
candidate="$root/$relative"
resolved="$(realpath -- "$candidate")" || { echo "repository path does not exist: $relative" >&2; exit 2; }
[[ -e "$resolved" ]] || { echo "repository path does not exist: $relative" >&2; exit 2; }
case "$resolved" in
  "$root"|"$root"/*) ;;
  *) echo "repository path escapes /workspace" >&2; exit 3 ;;
esac
repo="$(git -C "$resolved" rev-parse --show-toplevel 2>/dev/null)" || { echo "not a Git repository: $relative" >&2; exit 4; }
case "$repo" in
  "$root"|"$root"/*) ;;
  *) echo "Git repository escapes /workspace" >&2; exit 5 ;;
esac
printf '%s\n' "$repo"
SCRIPT
  guest_script "$box" "$script" "$relative"
}

expand_ports() {
  local token start end p old_ifs="$IFS"
  IFS=','
  for token in $MSW_PUBLISHED_PORTS; do
    if [[ "$token" == *-* ]]; then
      start="${token%-*}"; end="${token#*-}"
      for ((p=start; p<=end; p++)); do printf '%s\n' "$p"; done
    else
      printf '%s\n' "$token"
    fi
  done
  IFS="$old_ifs"
}

port_is_published() {
  local wanted="$1" p
  while IFS= read -r p; do [[ "$p" == "$wanted" ]] && return 0; done < <(expand_ports)
  return 1
}

validate_port() {
  local port="${1:-}" label="${2:-port}" numeric
  [[ "$port" =~ ^[0-9]+$ ]] || fatal "$label must be an integer from 1 to 65535"
  numeric=$((10#$port))
  (( numeric >= 1 && numeric <= 65535 )) || fatal "$label must be an integer from 1 to 65535"
}

cmd_shell() {
  local box="$1" path
  validate_workspace "$box"
  path="$(resolve_workspace_path "${2:-}")"
  ensure_running "$box"
  local quoted
  printf -v quoted '%q' "$path"
  exec "$SSH_BIN" -t "$(workspace_ssh_host "$box")" "cd $quoted && export TERM=xterm-256color && exec zsh -l"
}

cmd_zed() {
  local box="$1" path zed_bin
  validate_workspace "$box"
  path="$(resolve_workspace_path "${2:-}")"
  ensure_running "$box"
  zed_bin="${MSW_ZED_BIN:-$(command -v zed 2>/dev/null || true)}"
  [[ -n "$zed_bin" && -x "$zed_bin" ]] || fatal "Zed CLI missing. In Zed run: cli: install cli binary"
  "$zed_bin" "ssh://root@$(workspace_ssh_host "$box")${path}"
}

cmd_url() {
  local box="$1" port="${2:-3000}" scheme="${3:-http}"
  validate_workspace "$box"
  validate_port "$port" port
  [[ "$scheme" == http || "$scheme" == https ]] || fatal "scheme must be http or https"
  port_is_published "$port" || fatal "port $port is not pre-published; use: msw tunnel $box $port"
  printf '%s://%s:%s\n' "$scheme" "$(workspace_host "$box")" "$port"
}

cmd_open() {
  local box="$1" port="${2:-3000}" scheme="${3:-http}" url
  ensure_running "$box"
  url="$(cmd_url "$box" "$port" "$scheme")"
  note "Opening $url"
  "$OPEN_BIN" "$url"
}

cmd_ports() {
  local target="${1:-all}" box
  printf 'Published TCP ports\n  %s\n\n' "$MSW_PUBLISHED_PORTS"
  for box in $(for_targets "$target"); do
    printf '%-12s %s\n' "$box" "http://$(workspace_host "$box"):<port>"
  done
  cat <<'MSG'

Examples
  http://dev.msw.test:3000
  http://playgrounds.msw.test:5173
  http://personal.msw.test:8080

The service inside the VM must listen on 0.0.0.0.
MSG
}

cmd_start() {
  local target="${1:-all}" box
  while IFS= read -r box; do ensure_running "$box"; echo "$box: running"; done < <(for_targets "$target")
}

cmd_stop() {
  local target="${1:-all}" box
  while IFS= read -r box; do
    if sandbox_exists "$box" && workspace_msb "$box" ping -q "$box" >/dev/null 2>&1; then
      note "Stopping $box"
      workspace_msb "$box" stop -q -t 60 "$box"
    else
      echo "$box: already stopped"
    fi
  done < <(for_targets "$target")
}

cmd_restart() {
  local target="${1:-all}" box
  while IFS= read -r box; do
    sandbox_exists "$box" || fatal "workspace '$box' does not exist"
    assert_not_quarantined "$box"
    note "Restarting $box"
    if ! keychain_has "$READ_KEYCHAIN_SERVICE" "$box" &&
      { [[ -f "$(metadata_file "$box")" ]] || app_metadata_profile_present "$box" guest; }; then
      fatal "GitHub is configured for '$box', but its read token is missing from Keychain. Run: msw github setup $box OWNER/REPO"
    fi
    workspace_msb_with_read_token "$box" restart -q -t 60 "$box"
  done < <(for_targets "$target")
}

cmd_status() {
  "$MSB_BIN" ps -a --label msw.managed=true
  echo
  cmd_ports all
}

cmd_metrics() {
  local target="${1:-all}"
  if [[ "$target" == all ]]; then exec "$MSB_BIN" metrics --watch; fi
  validate_workspace "$target"
  workspace_msb "$target" metrics --watch "$target"
}

cmd_logs() {
  local box="$1"; shift
  validate_workspace "$box"
  workspace_msb "$box" logs "$box" "$@"
}

cmd_exec() {
  local box="$1"; shift
  validate_workspace "$box"
  (( $# > 0 )) || fatal "usage: msw exec WORKSPACE COMMAND [ARG ...]"
  guest_exec_w "$box" /workspace "$@"
}

cmd_disk() {
  local target="${1:-all}" box
  while IFS= read -r box; do
    ensure_running "$box"
    printf '\n\033[1;36m[%s]\033[0m\n' "$box"
    guest_exec "$box" bash -lc 'df -h / /workspace /var/lib/msw-runtime; echo; docker system df'
  done < <(for_targets "$target")
}

cmd_resize() {
  local box="$1" memory="${2:-}" cpus="${3:-}"
  validate_workspace "$box"
  [[ -n "$memory" ]] || fatal "usage: msw resize WORKSPACE MEMORY [CPUS]"
  if [[ -n "$cpus" ]]; then workspace_msb "$box" modify "$box" --memory "$memory" --cpus "$cpus"; else workspace_msb "$box" modify "$box" --memory "$memory"; fi
}

cmd_upgrade() {
  local target="${1:-all}" box
  while IFS= read -r box; do
    note "Upgrading Ubuntu packages in $box"
    guest_exec "$box" bash -lc 'apt-get update && DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y && apt-get autoremove -y && apt-get clean'
  done < <(for_targets "$target")
}

cmd_update() {
  if command -v brew >/dev/null 2>&1 && brew list --versions superradcompany/tap/microsandbox >/dev/null 2>&1; then
    note "Updating MicroSandbox through Homebrew"
    brew update
    brew upgrade superradcompany/tap/microsandbox || true
  else
    note "Updating MicroSandbox"
    "$MSB_BIN" self update
  fi
  "$MSB_BIN" doctor
}

cmd_tunnel() {
  local box="$1" remote_port="${2:-}" local_port="${3:-$remote_port}"
  validate_workspace "$box"
  validate_port "$remote_port" "remote port"
  validate_port "$local_port" "local port"
  ensure_running "$box"
  note "http://localhost:$local_port -> $box:$remote_port (Ctrl-C closes it)"
  exec "$SSH_BIN" -N -o ExitOnForwardFailure=yes -L "${local_port}:127.0.0.1:${remote_port}" "$(workspace_ssh_host "$box")"
}

cmd_host_repair_test() {
  local root="$HOME/.config/msw/test-host"
  mkdir -p "$root" "$HOME/.ssh/config.d" "$HOME/.microsandbox/ssh"
  printf '%s\n%s\n%s\n' "$MSW_DEV_IP $MSW_DEV_HOST" "$MSW_PLAYGROUNDS_IP $MSW_PLAYGROUNDS_HOST" "$MSW_PERSONAL_IP $MSW_PERSONAL_HOST" >"$root/hosts"
  printf '%s\n%s\n%s\n' "$MSW_DEV_IP" "$MSW_PLAYGROUNDS_IP" "$MSW_PERSONAL_IP" >"$root/loopback"
  if [[ ! -f "$HOME/.ssh/msw_ed25519" ]]; then
    printf 'fake-private-key\n' >"$HOME/.ssh/msw_ed25519"
    printf 'ssh-ed25519 AAAATEST microsandbox-workspaces\n' >"$HOME/.ssh/msw_ed25519.pub"
  fi
  cat "$HOME/.ssh/msw_ed25519.pub" >"$HOME/.microsandbox/ssh/authorized_keys"
  cat >"$HOME/.ssh/config.d/msw.conf" <<SSH
Host dev.msb playgrounds.msb personal.msb
  User root
  IdentityFile $HOME/.ssh/msw_ed25519
  IdentitiesOnly yes
  ProxyCommand $HOME/.local/bin/msw-ssh-proxy %h
SSH
  chmod 600 "$HOME/.ssh/config.d/msw.conf"
}

cmd_host_repair() {
  if [[ "${MSW_TEST_MODE:-0}" == 1 ]]; then cmd_host_repair_test; ok "test host integration configured"; return; fi
  [[ "$(uname -s)" == Darwin ]] || fatal "host repair is only supported on macOS"
  require_command_path msb "$MSB_BIN"
  note "Configuring local browser addresses"
  if [[ "${MSW_SKIP_HOST_REPAIR:-0}" != 1 ]]; then
  sudo -v
  local loop_script loop_plist hosts_tmp
  loop_script="$(mktemp "${TMPDIR:-/tmp}/msw-loopback.XXXXXX")"
  cat >"$loop_script" <<LOOP
#!/bin/sh
set -eu
for ip in "$MSW_DEV_IP" "$MSW_PLAYGROUNDS_IP" "$MSW_PERSONAL_IP"; do
  /sbin/ifconfig lo0 | /usr/bin/grep -q "inet \${ip} " || /sbin/ifconfig lo0 alias "\${ip}" up
done
LOOP
  sudo /usr/bin/install -d -o root -g wheel -m 0755 /usr/local/libexec
  sudo /usr/bin/install -o root -g wheel -m 0755 "$loop_script" /usr/local/libexec/msw-loopback-aliases
  rm -f "$loop_script"

  loop_plist="$(mktemp "${TMPDIR:-/tmp}/msw-loopback.XXXXXX.plist")"
  cat >"$loop_plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.msw.loopback-aliases</string>
<key>ProgramArguments</key><array><string>/usr/local/libexec/msw-loopback-aliases</string></array>
<key>RunAtLoad</key><true/>
</dict></plist>
PLIST
  /usr/bin/plutil -lint "$loop_plist" >/dev/null
  sudo /usr/bin/install -o root -g wheel -m 0644 "$loop_plist" /Library/LaunchDaemons/dev.msw.loopback-aliases.plist
  rm -f "$loop_plist"
  sudo /usr/local/libexec/msw-loopback-aliases
  sudo /bin/launchctl bootout system /Library/LaunchDaemons/dev.msw.loopback-aliases.plist >/dev/null 2>&1 || true
  sudo /bin/launchctl bootstrap system /Library/LaunchDaemons/dev.msw.loopback-aliases.plist

  hosts_tmp="$(mktemp "${TMPDIR:-/tmp}/msw-hosts.XXXXXX")"
  /usr/bin/awk '/^# BEGIN MSW WORKSPACES$/{skip=1;next}/^# END MSW WORKSPACES$/{skip=0;next}!skip{print}' /etc/hosts >"$hosts_tmp"
  cat >>"$hosts_tmp" <<HOSTS

# BEGIN MSW WORKSPACES
$MSW_DEV_IP $MSW_DEV_HOST
$MSW_PLAYGROUNDS_IP $MSW_PLAYGROUNDS_HOST
$MSW_PERSONAL_IP $MSW_PERSONAL_HOST
# END MSW WORKSPACES
HOSTS
  sudo /usr/bin/install -o root -g wheel -m 0644 "$hosts_tmp" /etc/hosts
  rm -f "$hosts_tmp"
  sudo /usr/bin/dscacheutil -flushcache
  sudo /usr/bin/killall -HUP mDNSResponder >/dev/null 2>&1 || true
  else
    note "Deferring privileged host repair to MSW Monitor"
  fi

  note "Configuring SSH for Ghostty and Zed"
  mkdir -p "$HOME/.ssh/config.d" "$HOME/.microsandbox/ssh"
  chmod 700 "$HOME/.ssh" "$HOME/.ssh/config.d"
  if [[ ! -f "$HOME/.ssh/msw_ed25519" ]]; then
    ssh-keygen -t ed25519 -f "$HOME/.ssh/msw_ed25519" -N '' -C microsandbox-workspaces
  fi
  chmod 600 "$HOME/.ssh/msw_ed25519"
  chmod 644 "$HOME/.ssh/msw_ed25519.pub"
  local public_key authorized
  public_key="$(cat "$HOME/.ssh/msw_ed25519.pub")"
  authorized="$HOME/.microsandbox/ssh/authorized_keys"
  if [[ ! -f "$authorized" ]] || ! grep -qxF "$public_key" "$authorized"; then
    "$MSB_BIN" ssh authorize --file "$HOME/.ssh/msw_ed25519.pub"
  fi
  cat >"$HOME/.ssh/config.d/msw.conf" <<SSH
Host dev.msb playgrounds.msb personal.msb
  User root
  IdentityFile $HOME/.ssh/msw_ed25519
  IdentitiesOnly yes
  ProxyCommand $HOME/.local/bin/msw-ssh-proxy %h
  ServerAliveInterval 30
  ServerAliveCountMax 3
  StrictHostKeyChecking accept-new
  SetEnv TERM=xterm-256color
SSH
  chmod 600 "$HOME/.ssh/config.d/msw.conf"
  touch "$HOME/.ssh/config"; chmod 600 "$HOME/.ssh/config"
  local include_line="Include $HOME/.ssh/config.d/*"
  if ! grep -qxF "$include_line" "$HOME/.ssh/config"; then
    local ssh_tmp
    ssh_tmp="$(mktemp "${TMPDIR:-/tmp}/msw-ssh.XXXXXX")"
    { printf '%s\n\n' "$include_line"; cat "$HOME/.ssh/config"; } >"$ssh_tmp"
    mv "$ssh_tmp" "$HOME/.ssh/config"
    chmod 600 "$HOME/.ssh/config"
  fi
  ok "host browser names and SSH integration configured"
}

validate_github_repo() {
  local repo="${1:-}"
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fatal "GitHub repository must be OWNER/REPOSITORY"
}

normalize_github_remote() {
  local raw="$1" owner repo
  case "$raw" in
    https://github.com/*)
      raw="${raw#https://github.com/}"
      ;;
    git@github.com:*)
      raw="${raw#git@github.com:}"
      ;;
    ssh://git@github.com:22/*)
      raw="${raw#ssh://git@github.com:22/}"
      ;;
    ssh://git@github.com/*)
      raw="${raw#ssh://git@github.com/}"
      ;;
    *)
      fatal "origin must point to github.com over HTTPS or SSH"
      ;;
  esac
  raw="${raw%.git}"
  [[ "$raw" != *'?'* && "$raw" != *'#'* && "$raw" != */*/* ]] || fatal "unsupported GitHub origin URL"
  owner="${raw%%/*}"; repo="${raw#*/}"
  validate_github_repo "$owner/$repo"
  printf 'https://github.com/%s/%s.git\n' "$owner" "$repo"
}

cmd_identity() {
  local name="${1:-}" email="${2:-}" target="${3:-all}" box
  [[ -n "$name" && -n "$email" ]] || fatal 'usage: msw identity "NAME" EMAIL [WORKSPACE|all]'
  while IFS= read -r box; do
    guest_exec "$box" git config --global user.name "$name"
    guest_exec "$box" git config --global user.email "$email"
    printf '%-12s %s <%s>\n' "$box" "$name" "$email"
  done < <(for_targets "$target")
}

cmd_clone() {
  local box="$1" repo="${2:-}" destination="${3:-}" remote repo_name parent
  validate_workspace "$box"
  validate_github_repo "$repo"
  repo_name="${repo#*/}"
  if [[ -z "$destination" ]]; then destination="$repo_name"; fi
  validate_relative_path "$destination"
  parent="${destination%/*}"
  [[ "$parent" == "$destination" ]] && parent=.
  remote="https://github.com/${repo}.git"
  ensure_running "$box"
  note "Cloning $repo into $box:/workspace/$destination"
  local script
  read -r -d '' script <<'SCRIPT' || true
set -Eeuo pipefail
remote="$1" destination="$2" parent="$3"
root="${MSW_GUEST_WORKSPACE_ROOT:-/workspace}"
mkdir -p -- "$root/$parent"
if [ -e "$root/$destination" ]; then
  echo "destination already exists: $destination" >&2
  exit 2
fi
git -C "$root" clone -- "$remote" "$destination"
SCRIPT
  guest_script "$box" "$script" "$remote" "$destination" "$parent"
}

cmd_repos() {
  local box="$1"
  validate_workspace "$box"
  local script
  read -r -d '' script <<'SCRIPT' || true
set -Eeuo pipefail
root="${MSW_GUEST_WORKSPACE_ROOT:-/workspace}"
find "$root" -mindepth 2 \( -type d -o -type f \) -name .git -prune -print 2>/dev/null |
  sed -e 's#/.git$##' -e "s#^$root/##" | sort
SCRIPT
  guest_script "$box" "$script"
}

pull_one() {
  local box="$1" relative="$2" repo_root
  repo_root="$(resolve_guest_repo "$box" "$relative")"
  note "$box:$relative"
  guest_exec_w "$box" "$repo_root" git pull --ff-only --prune
}

cmd_pull() {
  local box="$1" target="${2:-all}" repo failed=0
  validate_workspace "$box"
  if [[ "$target" != all ]]; then pull_one "$box" "$target"; return; fi
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    if ! pull_one "$box" "$repo"; then failed=1; fi
  done < <(cmd_repos "$box")
  (( failed == 0 )) || fatal "one or more repositories could not fast-forward"
}

cmd_clean() {
  local target="all" remove_volumes=0 arg box
  for arg in "$@"; do
    case "$arg" in
      dev|playgrounds|personal|all)
        [[ "$target" == all ]] || fatal "only one cleanup target may be specified"
        target="$arg"
        ;;
      --volumes) remove_volumes=1 ;;
      *) fatal "usage: msw clean [WORKSPACE|all] [--volumes]" ;;
    esac
  done
  while IFS= read -r box; do
    note "Pruning unused Docker images, containers, networks, and build cache in $box"
    if (( remove_volumes == 1 )); then
      warn "$box: also deleting every unused Docker volume"
      guest_exec "$box" docker system prune -af --volumes
    else
      guest_exec "$box" docker system prune -af
    fi
    guest_exec "$box" docker builder prune -af
  done < <(for_targets "$target")
}

bind_github_read_token() {
  local box="$1"
  keychain_has "$READ_KEYCHAIN_SERVICE" "$box" || fatal "read token missing for $box"
  workspace_msb_with_read_token "$box" modify "$box" --secret "GH_TOKEN@${MSW_GITHUB_SECRET_HOSTS}" --restart >/dev/null
}

remove_github_secret() {
  local box="$1" inspect_rc
  if sandbox_inspect_state "$box"; then
    :
  else
    inspect_rc=$?
    if (( inspect_rc == 1 )); then return 0; fi
    printf 'msw: could not inspect workspace %s before removing its GitHub secret\n' "$box" >&2
    return 1
  fi
  workspace_msb "$box" modify "$box" --secret-rm GH_TOKEN --restart >/dev/null
}

host_safe_path() {
  local path="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin" dir tool
  for tool in "$GIT_BIN" "$(command -v git-lfs 2>/dev/null || true)" "$ASKPASS_BIN"; do
    [[ -n "$tool" ]] || continue
    dir="$(dirname "$tool")"
    case ":$path:" in *":$dir:"*) ;; *) path="$dir:$path" ;; esac
  done
  printf '%s\n' "$path"
}

host_git_run() {
  local temp_home="$1" box="$2" keychain_home="$HOME" app_service=""; shift 2
  if app_metadata_profile_present "$box" host; then
    app_service="$(app_keychain_service "$box" host)"
  fi
  mkdir -p "$temp_home"
  env -i \
    HOME="$temp_home" \
    XDG_CONFIG_HOME="$temp_home/.config" \
    TMPDIR="${TMPDIR:-/tmp}" \
    PATH="$(host_safe_path)" \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_TERMINAL_PROMPT=0 \
    GIT_ASKPASS="$ASKPASS_BIN" \
    GIT_ASKPASS_REQUIRE=force \
    SSH_ASKPASS="$ASKPASS_BIN" \
    MSW_KEYCHAIN_SERVICE="$WRITE_KEYCHAIN_SERVICE" \
    MSW_KEYCHAIN_ACCOUNT="$box" \
    MSW_KEYCHAIN_HOME="$keychain_home" \
    MSW_SECURITY_BIN="$SECURITY_BIN" \
    MSW_JQ_BIN="$JQ_BIN" \
    MSW_APP_KEYCHAIN_SERVICE="$app_service" \
    MSW_APP_KEYCHAIN_ACCOUNT=profile \
    MSW_GITHUB_WRITE_TOKEN="${MSW_GITHUB_WRITE_TOKEN:-}" \
    MSW_TEST_KEYCHAIN_DIR="${MSW_TEST_KEYCHAIN_DIR:-}" \
    GIT_LFS_SKIP_SMUDGE=1 \
    "$@"
}

host_remote_url() {
  local canonical="$1" path owner repo
  if [[ -n "${MSW_TEST_GITHUB_REMOTE_ROOT:-}" ]]; then
    path="${canonical#https://github.com/}"
    path="${path%.git}"
    owner="${path%%/*}"; repo="${path#*/}"
    printf '%s/%s/%s.git\n' "$MSW_TEST_GITHUB_REMOTE_ROOT" "$owner" "$repo"
  else
    printf '%s\n' "$canonical"
  fi
}

host_delete_branch() {
  local box="$1" canonical_url="$2" branch="$3" temp temp_home repo remote
  temp="$(mktemp -d "${TMPDIR:-/tmp}/msw-delete.XXXXXX")"
  temp_home="$temp/home"; repo="$temp/repo"; remote="$(host_remote_url "$canonical_url")"
  "$GIT_BIN" init -q "$repo"
  host_git_run "$temp_home" "$box" "$GIT_BIN" -C "$repo" \
    -c credential.helper= -c core.hooksPath=/dev/null \
    push "$remote" ":refs/heads/$branch"
  rm -rf "$temp"
}

collect_lfs_oids() {
  local box="$1" repo_root="$2" local_sha="$3" script
  read -r -d '' script <<'SCRIPT' || true
set -Eeuo pipefail
sha="$1"
git rev-list --objects "$sha" --not --remotes=origin |
  awk '{print $1}' | sort -u |
  while IFS= read -r object; do
    [ -n "$object" ] || continue
    [ "$(git cat-file -t "$object" 2>/dev/null || true)" = blob ] || continue
    size="$(git cat-file -s "$object")"
    [ "$size" -le 4096 ] || continue
    content="$(git cat-file blob "$object")"
    first="$(printf '%s\n' "$content" | sed -n '1p')"
    [ "$first" = 'version https://git-lfs.github.com/spec/v1' ] || continue
    oid="$(printf '%s\n' "$content" | sed -n 's/^oid sha256:\([0-9a-f]\{64\}\)$/\1/p' | head -n 1)"
    [ -n "$oid" ] || { echo "invalid Git LFS pointer in Git blob $object" >&2; exit 9; }
    printf '%s\n' "$oid"
  done | sort -u
SCRIPT
  guest_exec_w "$box" "$repo_root" bash -s -- "$local_sha" <<<"$script"
}

copy_lfs_objects() {
  local box="$1" repo_root="$2" host_repo="$3" oid_list="$4" oid count=0 guest_path dest actual
  [[ -s "$oid_list" ]] || return 0
  while IFS= read -r oid; do
    [[ -n "$oid" ]] || continue
    [[ "$oid" =~ ^[0-9a-f]{64}$ ]] || fatal "guest returned an invalid Git LFS object id"
    count=$((count + 1))
    (( count <= 10000 )) || fatal "more than 10,000 new Git LFS objects; use a narrower push"
    guest_path="$(guest_exec_w "$box" "$repo_root" git rev-parse --path-format=absolute --git-path "lfs/objects/${oid:0:2}/${oid:2:2}/$oid")"
    dest="$host_repo/.git/lfs/objects/${oid:0:2}/${oid:2:2}/$oid"
    mkdir -p "$(dirname "$dest")"
    workspace_msb "$box" copy -q "$box:$guest_path" "$dest.partial"
    [[ -f "$dest.partial" && ! -L "$dest.partial" ]] || fatal "Git LFS object $oid was not a regular file"
    require_command_path shasum "$SHASUM_BIN"
    actual="$("$SHASUM_BIN" -a 256 "$dest.partial" | awk '{print $1}')"
    [[ "$actual" == "$oid" ]] || fatal "Git LFS object $oid failed SHA-256 verification"
    mv "$dest.partial" "$dest"
  done <"$oid_list"
}

push_impl() {
  local box="$1" relative="$2" force_mode="$3" assume_yes="$4" quiet_mode="${5:-0}"
  validate_workspace "$box"
  validate_relative_path "$relative"
  assert_not_quarantined "$box"
  local access
  access="$(metadata_access "$box" 2>/dev/null || true)"
  [[ "$access" == host-write ]] || fatal "host write access is not enabled (host write token missing or workspace is read-only); run: msw github setup $box OWNER/REPO"
  keychain_has "$WRITE_KEYCHAIN_SERVICE" "$box" || fatal "host write token missing; run: msw github setup $box OWNER/REPO"
  [[ -x "$ASKPASS_BIN" ]] || fatal "host askpass helper missing; rerun setup.sh"
  require_command_path git "$GIT_BIN"

  local repo_root branch local_sha remote_raw canonical_url remote_sha ff_status commits
  repo_root="$(resolve_guest_repo "$box" "$relative")"
  remote_raw="$(guest_exec_w "$box" "$repo_root" git config --get remote.origin.url)"
  canonical_url="$(normalize_github_remote "$remote_raw")"
  guest_exec_w "$box" "$repo_root" git fetch --prune origin
  branch="$(guest_exec_w "$box" "$repo_root" git symbolic-ref --quiet --short HEAD)" || fatal "detached HEAD cannot be pushed"
  guest_exec_w "$box" "$repo_root" git check-ref-format --branch "$branch" >/dev/null
  local_sha="$(guest_exec_w "$box" "$repo_root" git rev-parse --verify HEAD)"
  remote_sha="$(guest_exec_w "$box" "$repo_root" bash -c 'git ls-remote --exit-code origin "refs/heads/$1" 2>/dev/null | awk '\''NR==1 {print $1}'\''' _ "$branch" || true)"
  [[ -z "$remote_sha" || "$remote_sha" =~ ^[0-9a-f]{40,64}$ ]] || fatal "origin returned an invalid branch SHA"

  ff_status=new
  if [[ -n "$remote_sha" ]]; then
    if guest_exec_w "$box" "$repo_root" git merge-base --is-ancestor "$remote_sha" "$local_sha"; then ff_status=fast-forward; else ff_status=non-fast-forward; fi
  fi
  if [[ "$ff_status" == non-fast-forward && "$force_mode" != 1 ]]; then
    fatal "push is not a fast-forward. Review it, then use: msw push $box $relative --force-with-lease"
  fi

  if [[ -n "$remote_sha" ]]; then
    commits="$(guest_exec_w "$box" "$repo_root" git log --oneline --decorate --max-count=30 "$remote_sha..$local_sha" || true)"
  else
    commits="$(guest_exec_w "$box" "$repo_root" git log --oneline --decorate --max-count=15 "$local_sha" || true)"
  fi
  if [[ "$quiet_mode" != 1 ]]; then
    cat <<SUMMARY
Workspace:   $box
Repository:  ${canonical_url#https://github.com/}
Path:        $relative
Branch:      $branch
Commit:      $local_sha
Mode:        $ff_status$([[ "$force_mode" == 1 ]] && printf ' (exact force-with-lease)' || true)

Commits:
${commits:-  (no new commits)}
SUMMARY
  fi
  if [[ "$assume_yes" != 1 ]]; then
    printf '\nType PUSH to continue: '
    local answer; read -r answer
    [[ "$answer" == PUSH ]] || fatal "push cancelled"
  fi

  local temp guest_bundle host_bundle host_repo temp_home lfs_oids remote_url ref lease_arg
  temp="$(mktemp -d "${TMPDIR:-/tmp}/msw-push.XXXXXX")"
  guest_bundle="/tmp/msw-push-$(date +%s)-$RANDOM.bundle"
  host_bundle="$temp/branch.bundle"
  host_repo="$temp/repo"
  temp_home="$temp/home"
  lfs_oids="$temp/lfs-oids"
  ref="refs/heads/$branch"
  remote_url="$(host_remote_url "$canonical_url")"

  (
    cleanup_push() {
      guest_exec "$box" rm -f "$guest_bundle" >/dev/null 2>&1 || true
      rm -rf "$temp"
    }
    trap cleanup_push EXIT INT TERM HUP

    guest_exec_w "$box" "$repo_root" git bundle create "$guest_bundle" "$ref"
    workspace_msb "$box" copy -q "$box:$guest_bundle" "$host_bundle"
    [[ -f "$host_bundle" && ! -L "$host_bundle" ]] || fatal "invalid Git bundle transfer"

    "$GIT_BIN" init -q "$host_repo"
    "$GIT_BIN" -C "$host_repo" -c core.hooksPath=/dev/null bundle verify "$host_bundle" >/dev/null
    "$GIT_BIN" -C "$host_repo" -c core.hooksPath=/dev/null fetch -q --update-head-ok "$host_bundle" "$ref:$ref"
    [[ "$("$GIT_BIN" -C "$host_repo" rev-parse "$ref")" == "$local_sha" ]] || fatal "bundle commit did not match the guest commit"
    "$GIT_BIN" -C "$host_repo" remote add origin "$remote_url"

    collect_lfs_oids "$box" "$repo_root" "$local_sha" >"$lfs_oids"
    if [[ -s "$lfs_oids" ]]; then
      command -v git-lfs >/dev/null 2>&1 || fatal "Git LFS objects are present but git-lfs is not installed on the Mac"
      copy_lfs_objects "$box" "$repo_root" "$host_repo" "$lfs_oids"
      host_git_run "$temp_home" "$box" "$GIT_BIN" -C "$host_repo" \
        -c credential.helper= -c core.hooksPath=/dev/null \
        lfs push --object-id origin --stdin <"$lfs_oids"
    fi

    local push_args=(push origin "$ref:$ref")
    if [[ "$force_mode" == 1 ]]; then
      if [[ -n "$remote_sha" ]]; then lease_arg="--force-with-lease=$ref:$remote_sha"; else lease_arg="--force-with-lease=$ref:"; fi
      push_args=(push "$lease_arg" origin "$ref:$ref")
    fi
    host_git_run "$temp_home" "$box" "$GIT_BIN" -C "$host_repo" \
      -c credential.helper= -c core.hooksPath=/dev/null "${push_args[@]}"

    guest_exec_w "$box" "$repo_root" git fetch --prune origin "$ref"
  )
  ok "pushed $branch from $box:$relative"
}

cmd_push() {
  local box="$1" relative="$2"; shift 2
  local force_mode=0 assume_yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --force-with-lease) force_mode=1 ;;
      --yes|-y) assume_yes=1 ;;
      *) fatal "unknown push option: $arg" ;;
    esac
  done
  push_impl "$box" "$relative" "$force_mode" "$assume_yes" 0
}

read_hidden_token() {
  local prompt="$1" env_name="$2" value=""
  if [[ -n "${!env_name:-}" ]]; then
    value="${!env_name}"
  else
    printf '%s' "$prompt" >&2
    IFS= read -r -s value
    printf '\n' >&2
  fi
  [[ ${#value} -ge 20 ]] || fatal "token looks too short"
  printf '%s' "$value"
}

cmd_github_verify() {
  local box="$1" repo="${2:-}" mode="${3:-}" inherited_lock="${4:-0}" lock_acquired=0 id temp_rel branch repo_root canonical remote_heads="" remote_sha="" host_write=1 read_token="" verify_status=0
  validate_workspace "$box"
  if (( inherited_lock == 0 )); then
    if ! github_lock_acquire "$box"; then fatal "could not acquire GitHub workspace lock for $box"; fi
    lock_acquired=1
  fi
  assert_not_quarantined "$box"
  if [[ -z "$mode" ]]; then mode="$(metadata_access "$box" 2>/dev/null || printf 'host-write')"; fi
  case "$mode" in
    host-write) ;;
    read-only) host_write=0 ;;
    *) fatal "unknown GitHub access mode '$mode'" ;;
  esac
  if [[ -z "$repo" ]]; then repo="$(metadata_repo "$box")" || fatal "no verification repository recorded for $box"; fi
  validate_github_repo "$repo"
  read_token="$(read_token_for_workspace "$box")" || fatal "read token missing for $box"
  if (( host_write )); then
    keychain_has "$WRITE_KEYCHAIN_SERVICE" "$box" || fatal "write token missing for $box"
  fi

  # MicroSandbox secret references require the source environment variable for
  # every CLI operation that reads the sandbox config, not only for modify/start.
  # Keep the host-held token in this verifier process so guest exec, clone, and
  # cleanup commands all resolve the source reference without exposing it to the VM.
  export GH_TOKEN="$read_token"
  bind_github_read_token "$box"
  ensure_running "$box"
  id="$(date +%Y%m%d%H%M%S)-$RANDOM"
  temp_rel=".msw-verification/$id"
  branch="msw-permission-test-$id"
  canonical="https://github.com/$repo.git"

  (
    cleanup_verify() {
      local event="${1:-EXIT}" status="${2:-0}"
      if [[ "$event" != EXIT ]]; then
        trap - INT TERM HUP
        exit "$status"
      fi
      guest_exec "$box" rm -rf "/workspace/$temp_rel" >/dev/null 2>&1 || true
    }
    trap 'cleanup_verify EXIT' EXIT
    trap 'cleanup_verify INT 130' INT
    trap 'cleanup_verify TERM 143' TERM
    trap 'cleanup_verify HUP 129' HUP

    note "Verifying read-only guest access in $box"
    cmd_clone "$box" "$repo" "$temp_rel" >/dev/null
    repo_root="$(resolve_guest_repo "$box" "$temp_rel")"
    remote_heads="$(guest_exec_w "$box" "$repo_root" git ls-remote --heads origin)" || fatal "could not inspect verification repository branches"
    [[ -n "$remote_heads" ]] || fatal "verification repository '$repo' has no branches; initialize main (for example, add a README.md and push main) before retrying"
    guest_exec_w "$box" "$repo_root" git config user.name "MSW Permission Test"
    guest_exec_w "$box" "$repo_root" git config user.email "msw-permission-test@localhost"
    guest_exec_w "$box" "$repo_root" git switch -c "$branch" >/dev/null
    guest_exec_w "$box" "$repo_root" git commit --allow-empty -m "MSW permission verification" >/dev/null

    if guest_exec_w "$box" "$repo_root" git push origin "HEAD:refs/heads/$branch" >/dev/null 2>&1; then
      if (( host_write )); then
        host_delete_branch "$box" "$canonical" "$branch" >/dev/null 2>&1 || true
      else
        guest_exec_w "$box" "$repo_root" git push origin --delete "$branch" >/dev/null 2>&1 || true
      fi
      fatal "the guest token can push. Replace it with a Contents: read-only fine-grained token"
    fi
    ok "guest push rejected"

    if (( host_write )); then
      note "Verifying the host-only push path"
      push_impl "$box" "$temp_rel" 0 1 1
      remote_sha="$(guest_exec_w "$box" "$repo_root" bash -c 'git ls-remote --exit-code origin "refs/heads/$1" | awk '\''NR==1 {print $1}'\''' _ "$branch")"
      [[ "$remote_sha" =~ ^[0-9a-f]{40,64}$ ]] || fatal "host push could not be confirmed"
      host_delete_branch "$box" "$canonical" "$branch" >/dev/null
      if guest_exec_w "$box" "$repo_root" git ls-remote --exit-code origin "refs/heads/$branch" >/dev/null 2>&1; then
        fatal "temporary verification branch could not be deleted"
      fi
      ok "host push and cleanup succeeded"
    fi
  )
  verify_status=$?
  unset GH_TOKEN read_token
  if (( verify_status != 0 )); then
    if (( lock_acquired )); then github_lock_release; fi
    return "$verify_status"
  fi
  if (( host_write )); then
    ok "GitHub permissions verified for $box using $repo"
  else
    ok "Read-only GitHub access verified for $box using $repo"
  fi
}

cmd_github_setup() {
  local box="$1" repo="$2" mode="${3:-host-write}" read_token="" write_token="" host_write=1
  validate_workspace "$box"
  validate_github_repo "$repo"
  sandbox_exists "$box" || fatal "workspace '$box' does not exist"
  require_github_tls_interception "$box"
  if ! github_lock_acquire "$box"; then fatal "could not acquire GitHub workspace lock for $box"; fi
  if [[ "$mode" == "--read-only" ]]; then mode="read-only"; host_write=0; fi
  [[ "$mode" == host-write || "$mode" == read-only ]] || fatal "usage: msw github setup WORKSPACE OWNER/REPO [--read-only]"

  if (( host_write )); then
    cat <<INFO
Create two fine-grained GitHub tokens restricted to the repositories this workspace may use:
  1. Guest token: Contents = Read-only
  2. Host token:  Contents = Read and write
Add Workflows = Read and write to the host token only when you need to push .github/workflows files.
Verification repository: $repo
INFO
  else
    cat <<INFO
Create one fine-grained GitHub token restricted to the repositories this workspace may read:
  Guest token: Contents = Read-only
Verification repository: $repo
This workspace will not have a host-side push credential.
INFO
  fi
  read_token="$(read_hidden_token 'Paste the READ-ONLY token: ' MSW_GITHUB_READ_TOKEN_INPUT)"
  if (( host_write )); then
    write_token="$(read_hidden_token 'Paste the HOST WRITE token: ' MSW_GITHUB_WRITE_TOKEN_INPUT)"
    [[ "$read_token" != "$write_token" ]] || fatal "use two different tokens"
  fi

  local old_read="" old_write="" had_read=0 had_write=0 meta_file old_meta="" rollback_failed=0 preexisting_quarantine=0 quarantine_path
  meta_file="$(metadata_file "$box")"
  quarantine_path="$(quarantine_file "$box")"
  if [[ -e "$quarantine_path" || -L "$quarantine_path" ]]; then preexisting_quarantine=1; fi
  if (( preexisting_quarantine )); then
    warn "workspace '$box' is already quarantined; existing GitHub credentials will not be used as rollback state"
  else
    if old_read="$(keychain_get "$READ_KEYCHAIN_SERVICE" "$box" 2>/dev/null)"; then had_read=1; fi
    if old_write="$(keychain_get "$WRITE_KEYCHAIN_SERVICE" "$box" 2>/dev/null)"; then had_write=1; fi
    if [[ -f "$meta_file" ]]; then old_meta="$(cat "$meta_file")"; fi
  fi
  setup_transaction_arm "$box"
  if ! quarantine_workspace "$box" "GitHub setup pending verification"; then
    fatal "could not quarantine workspace before changing GitHub credentials"
  fi
  if ! rm -f "$meta_file"; then fatal "could not revoke existing GitHub metadata for $box"; fi

  keychain_set "$READ_KEYCHAIN_SERVICE" "$box" "$read_token"
  if (( host_write )); then keychain_set "$WRITE_KEYCHAIN_SERVICE" "$box" "$write_token"; else keychain_delete "$WRITE_KEYCHAIN_SERVICE" "$box"; fi
  unset read_token write_token
  write_metadata "$box" "$repo" "$mode"

  # Run verification in a fresh process. Bash disables errexit inside functions
  # used directly as an `if` condition; a child process keeps every internal
  # failure fatal while still allowing this parent to roll credentials back.
  if ! ( MSW_ALLOW_QUARANTINED=1 MSW_GITHUB_VERIFY_INHERITED=1 "${MSW_SELF_BIN:-$0}" __github-verify-transaction "$box" "$repo" "$mode" ); then
    if (( preexisting_quarantine )); then
      warn "verification failed; revoking untrusted repair credentials and keeping the workspace quarantined"
    else
      warn "verification failed; restoring the previous GitHub configuration"
    fi
    if ! rm -f "$meta_file"; then rollback_failed=1; fi
    if [[ -e "$meta_file" ]]; then rollback_failed=1; fi
    if (( had_read )); then
      if ! keychain_set "$READ_KEYCHAIN_SERVICE" "$box" "$old_read"; then rollback_failed=1; fi
    else
      if ! keychain_delete "$READ_KEYCHAIN_SERVICE" "$box"; then rollback_failed=1; fi
    fi
    if (( had_write )); then
      if ! keychain_set "$WRITE_KEYCHAIN_SERVICE" "$box" "$old_write"; then rollback_failed=1; fi
    else
      if ! keychain_delete "$WRITE_KEYCHAIN_SERVICE" "$box"; then rollback_failed=1; fi
    fi
    if (( had_read )); then
      if ! bind_github_read_token "$box" >/dev/null 2>&1; then rollback_failed=1; fi
    else
      if ! remove_github_secret "$box"; then rollback_failed=1; fi
    fi
    if (( rollback_failed == 0 )) && [[ -n "$old_meta" ]]; then
      if ! printf '%s\n' "$old_meta" >"$meta_file"; then rollback_failed=1; fi
    fi
    if (( rollback_failed )); then
      if ! rm -f "$meta_file"; then rollback_failed=1; fi
      if [[ -e "$meta_file" ]]; then rollback_failed=1; fi
      quarantine_workspace "$box" "GitHub setup rollback failed" >/dev/null 2>&1 || true
      setup_transaction_disarm
      if (( preexisting_quarantine )); then
        warn "untrusted repair credentials could not be fully revoked; workspace remains quarantined"
      else
        warn "previous GitHub configuration could not be fully restored"
      fi
      github_lock_release
      unset old_read old_write
      return 1
    fi
    if (( preexisting_quarantine )); then
      quarantine_workspace "$box" "GitHub repair verification failed" >/dev/null 2>&1 || true
      setup_transaction_disarm
      github_lock_release
      warn "GitHub repair verification failed; workspace remains quarantined"
      unset old_read old_write
      return 1
    fi
    if ! clear_quarantine "$box"; then fatal "could not clear GitHub workspace quarantine for $box"; fi
    setup_transaction_disarm
    github_lock_release
    unset old_read old_write
    return 1
  fi
  if ! clear_quarantine "$box"; then fatal "could not clear GitHub workspace quarantine for $box"; fi
  setup_transaction_disarm
  github_lock_release
  unset old_read old_write
  ok "GitHub configured for $box ($mode)"
}

cmd_github_status() {
  local target="${1:-all}" box repo read_state write_state
  printf '%-13s %-10s %-10s %s\n' WORKSPACE GUEST_READ HOST_WRITE VERIFICATION_REPO
  while IFS= read -r box; do
    if keychain_has "$READ_KEYCHAIN_SERVICE" "$box"; then read_state=present; else read_state=missing; fi
    if keychain_has "$WRITE_KEYCHAIN_SERVICE" "$box"; then write_state=present; else write_state=missing; fi
    repo="$(metadata_repo "$box" 2>/dev/null || printf '-')"
    printf '%-13s %-10s %-10s %s\n' "$box" "$read_state" "$write_state" "$repo"
  done < <(for_targets "$target")
}

cmd_github_remove() {
  local box="$1" meta_file cleanup_failed=0
  validate_workspace "$box"
  if ! github_lock_acquire "$box"; then fatal "could not acquire GitHub workspace lock for $box"; fi
  meta_file="$(metadata_file "$box")"
  rm -f "$meta_file"
  [[ ! -e "$meta_file" ]] || fatal "could not revoke GitHub host-write metadata for $box"
  if ! remove_github_secret "$box"; then cleanup_failed=1; fi
  if ! keychain_delete "$READ_KEYCHAIN_SERVICE" "$box"; then cleanup_failed=1; fi
  if ! keychain_delete "$WRITE_KEYCHAIN_SERVICE" "$box"; then cleanup_failed=1; fi
  if (( cleanup_failed )); then
    if ! quarantine_workspace "$box" "GitHub credential removal failed"; then
      fatal "GitHub credential removal failed and workspace quarantine could not be recorded"
    fi
    fatal "GitHub credential removal failed; workspace quarantined"
  fi
  if ! clear_quarantine "$box"; then fatal "could not clear GitHub workspace quarantine for $box"; fi
  github_lock_release
  ok "removed GitHub credentials for $box"
}

cmd_github() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    setup)
      (( $# >= 2 && $# <= 3 )) || fatal "usage: msw github setup WORKSPACE OWNER/REPO [--read-only]"
      cmd_github_setup "$1" "$2" "${3:-}"
      ;;
    verify)
      (( $# >= 1 && $# <= 2 )) || fatal "usage: msw github verify WORKSPACE [REPO]"
      cmd_github_verify "$1" "${2:-}"
      ;;
    status)
      cmd_github_status "${1:-all}"
      ;;
    remove)
      (( $# == 1 )) || fatal "usage: msw github remove WORKSPACE"
      cmd_github_remove "$1"
      ;;
    *) fatal "unknown github command '$sub'" ;;
  esac
}

host_network_check() {
  local failed=0 box ip host
  if [[ "${MSW_TEST_MODE:-0}" == 1 ]]; then
    local root="$HOME/.config/msw/test-host"
    [[ -f "$root/hosts" && -f "$root/loopback" ]] || return 1
    return 0
  fi
  for box in "${WORKSPACES[@]}"; do
    ip="$(workspace_ip "$box")"; host="$(workspace_host "$box")"
    /sbin/ifconfig lo0 | /usr/bin/grep -q "inet ${ip} " || { echo "$box: loopback $ip missing" >&2; failed=1; }
    /usr/bin/dscacheutil -q host -a name "$host" | /usr/bin/grep -q "$ip" || { echo "$box: hostname $host missing" >&2; failed=1; }
  done
  return "$failed"
}

cmd_check_quick() {
  local failed=0 box
  note "MicroSandbox runtime"
  "$MSB_BIN" doctor || failed=1
  note "Host browser and SSH integration"
  host_network_check || failed=1
  [[ -f "$HOME/.ssh/config.d/msw.conf" ]] || { echo "SSH config missing" >&2; failed=1; }
  [[ -x "$HOME/.local/bin/msw-ssh-proxy" ]] || { echo "SSH proxy missing" >&2; failed=1; }
  [[ -x "$ASKPASS_BIN" ]] || { echo "Git askpass helper missing" >&2; failed=1; }
  note "Base snapshot and workspace storage"
  snapshot_exists "$MSW_BASE_SNAPSHOT" || { echo "snapshot $MSW_BASE_SNAPSHOT missing" >&2; failed=1; }
  for box in "${WORKSPACES[@]}"; do
    sandbox_exists "$box" || { echo "$box: sandbox missing" >&2; failed=1; }
    volume_exists "$(workspace_volume "$box" workspace)" || { echo "$box: workspace volume missing" >&2; failed=1; }
    volume_exists "$(workspace_volume "$box" runtime)" || { echo "$box: runtime volume missing" >&2; failed=1; }
  done
  (( failed == 0 )) || fatal "one or more checks failed; rerun setup.sh"
  ok "quick checks passed"
}

check_one_deep() {
  local box="$1" was_running=0 failed=0 host direct_url docker_url direct_unit docker_name
  workspace_msb "$box" ping -q "$box" >/dev/null 2>&1 && was_running=1
  ensure_running "$box"
  host="$(workspace_host "$box")"
  direct_unit="msw-health-direct-${box}"
  docker_name="msw-health-docker-${box}"
  direct_url="http://${host}:24678/msw-health.txt"
  docker_url="http://${host}:24679/"

  note "Deep-checking $box"
  local script
  read -r -d '' script <<'SCRIPT' || true
set -Eeuo pipefail
[ "$(uname -m)" = aarch64 ]
[ "$(cat /proc/1/comm)" = systemd ]
[ "$(findmnt -n -o FSTYPE /workspace)" = ext4 ]
[ "$(findmnt -n -o FSTYPE /var/lib/msw-runtime)" = ext4 ]
systemctl is-active --quiet docker
systemctl is-active --quiet containerd
docker info >/dev/null
docker compose version >/dev/null
docker buildx version >/dev/null
curl -fsS --max-time 20 https://github.com/robots.txt >/dev/null
SCRIPT
  guest_script "$box" "$script" || failed=1

  "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=20 "$(workspace_ssh_host "$box")" true || failed=1

  guest_exec "$box" systemctl stop "$direct_unit.service" >/dev/null 2>&1 || true
  guest_exec "$box" bash -lc "printf '%s\\n' '$box-direct-ok' >/tmp/msw-health.txt && systemd-run --quiet --unit='$direct_unit' --collect python3 -m http.server 24678 --bind 0.0.0.0 --directory /tmp" || failed=1
  local attempt=0 body=""
  until body="$("$CURL_BIN" -fsS --max-time 2 "$direct_url" 2>/dev/null)"; do
    attempt=$((attempt + 1)); (( attempt < 30 )) || break; sleep 0.2
  done
  [[ "$body" == "$box-direct-ok" ]] || { echo "$box: direct published port failed" >&2; failed=1; }
  guest_exec "$box" systemctl stop "$direct_unit.service" >/dev/null 2>&1 || true

  guest_exec "$box" docker rm -f "$docker_name" >/dev/null 2>&1 || true
  guest_exec "$box" docker run -d --name "$docker_name" -p 24679:80 nginx:alpine >/dev/null || failed=1
  attempt=0; body=""
  until body="$("$CURL_BIN" -fsS --max-time 2 "$docker_url" 2>/dev/null)"; do
    attempt=$((attempt + 1)); (( attempt < 60 )) || break; sleep 0.5
  done
  [[ "$body" == *"Welcome to nginx"* ]] || { echo "$box: Docker published port failed" >&2; failed=1; }
  guest_exec "$box" docker rm -f "$docker_name" >/dev/null 2>&1 || true

  if keychain_has "$READ_KEYCHAIN_SERVICE" "$box"; then
    guest_exec "$box" sh -c 'case "${GH_TOKEN:-}" in \$MSB_GH_TOKEN*|\$GH_TOKEN*) exit 0;; *) exit 1;; esac' || {
      echo "$box: GitHub secret is not represented by a guest placeholder" >&2; failed=1;
    }
  fi

  if (( was_running == 0 )); then workspace_msb "$box" stop -q -t 60 "$box" >/dev/null 2>&1 || failed=1; fi
  (( failed == 0 )) || return 1
  ok "$box passed"
}

cmd_check() {
  local deep=0 arg failed=0 box
  for arg in "$@"; do case "$arg" in --deep) deep=1 ;; *) fatal "unknown check option: $arg" ;; esac; done
  cmd_check_quick
  (( deep == 1 )) || return 0
  require_command_path ssh "$SSH_BIN"
  require_command_path curl "$CURL_BIN"
  for box in "${WORKSPACES[@]}"; do check_one_deep "$box" || failed=1; done
  (( failed == 0 )) || fatal "deep checks failed"
  ok "all live VM, Docker, SSH, internet, and published-port checks passed"
}

managed_backup_paths() {
  cat <<'PATHS'
.microsandbox
.config/msw
.local/bin/msw
.local/bin/msw-ssh-proxy
.local/libexec/msw-git-askpass
.local/share/msw
.ssh/msw_ed25519
.ssh/msw_ed25519.pub
.ssh/config.d/msw.conf
PATHS
}

running_workspaces() {
  local box
  for box in "${WORKSPACES[@]}"; do
    if sandbox_exists "$box" && workspace_msb "$box" ping -q "$box" >/dev/null 2>&1; then
      printf '%s\n' "$box"
    fi
  done
}

cmd_backup() {
  local destination="${1:-$MSW_BACKUP_DIR}" stamp archive partial checksum info temp running_file box rel home_real
  require_command_path gtar "$GTAR_BIN"
  require_command_path zstd "$ZSTD_BIN"
  require_command_path shasum "$SHASUM_BIN"

  mkdir -p "$destination"
  destination="$(cd "$destination" && pwd -P)"
  home_real="$(cd "$HOME" && pwd -P)"
  case "$destination/" in
    "$home_real/.microsandbox/"*|"$home_real/.config/msw/"*|"$home_real/.local/share/msw/"*)
      fatal "backup destination may not be inside managed state"
      ;;
  esac

  stamp="$(date +%Y%m%d-%H%M%S)"
  archive="$destination/microsandbox-all-$stamp.tar.zst"
  partial="$archive.partial"
  checksum="$archive.sha256"
  info="$archive.info.txt"
  temp="$(mktemp -d "${TMPDIR:-/tmp}/msw-backup.XXXXXX")"
  running_file="$temp/running"
  running_workspaces >"$running_file"

  (
    cleanup_backup() {
      local rc=$? running_box
      rm -f "$partial"
      if (( rc != 0 )); then rm -f "$archive" "$checksum" "$info"; fi
      while IFS= read -r running_box; do
        [[ -n "$running_box" ]] || continue
        if ! workspace_msb "$running_box" ping -q "$running_box" >/dev/null 2>&1; then
          start_sandbox "$running_box" >/dev/null 2>&1 || warn "could not restart $running_box after backup"
        fi
      done <"$running_file"
      rm -rf "$temp"
      return "$rc"
    }
    trap cleanup_backup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP

    note "Flushing and stopping managed workspaces"
    while IFS= read -r box; do
      [[ -n "$box" ]] || continue
      guest_exec "$box" sync >/dev/null
      workspace_msb "$box" stop -q -t 120 "$box"
    done <"$running_file"
    sync

    local -a paths=()
    while IFS= read -r rel; do
      [[ -n "$rel" ]] || continue
      if [[ -e "$HOME/$rel" || -L "$HOME/$rel" ]]; then paths+=("$rel"); fi
    done < <(managed_backup_paths)
    (( ${#paths[@]} > 0 )) || fatal "nothing to back up"

    {
      printf 'MSW version: %s\n' "$MSW_VERSION"
      printf 'Created UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf 'MicroSandbox: '
      "$MSB_BIN" --version 2>/dev/null || true
      printf 'Running before backup:\n'
      sed 's/^/  /' "$running_file"
      printf '\nKeychain tokens are intentionally not included.\n'
    } >"$info"

    note "Creating sparse compressed archive"
    "$GTAR_BIN" --sparse --xattrs --acls -C "$HOME" -cf - "${paths[@]}" |
      "$ZSTD_BIN" -T0 -8 -q -o "$partial"
    [[ -s "$partial" ]] || fatal "backup archive is empty"
    mv "$partial" "$archive"
    (cd "$destination" && "$SHASUM_BIN" -a 256 "$(basename "$archive")" >"$(basename "$checksum")")
  )

  ok "backup complete"
  printf '%s\n' "$archive"
  printf '%s\n' "$checksum"
  printf '%s\n' "$info"
}

validate_backup_member() {
  local member="$1"
  [[ -n "$member" ]] || return 1
  case "$member" in
    /*|../*|*/../*|*/..|./*|*/./*|*/.|*//* ) return 1 ;;
  esac
  case "$member" in
    .microsandbox|.microsandbox/*|.config/msw|.config/msw/*|.local/bin/msw|.local/bin/msw-ssh-proxy|.local/libexec/msw-git-askpass|.local/share/msw|.local/share/msw/*|.ssh/msw_ed25519|.ssh/msw_ed25519.pub|.ssh/config.d/msw.conf)
      return 0
      ;;
    *) return 1 ;;
  esac
}

validate_backup_listing() {
  local listing="$1" member required count=0 duplicate=""
  while IFS= read -r member; do
    validate_backup_member "$member" || fatal "unsafe or unexpected archive member: $member"
    count=$((count + 1))
    (( count <= 2000000 )) || fatal "backup contains too many archive members"
  done <"$listing"

  duplicate="$(LC_ALL=C sort "$listing" | uniq -d | head -n 1)"
  [[ -z "$duplicate" ]] || fatal "backup contains a duplicate archive member: $duplicate"

  for required in \
    .microsandbox \
    .config/msw \
    .local/bin/msw \
    .local/bin/msw-ssh-proxy \
    .local/libexec/msw-git-askpass \
    .local/share/msw \
    .ssh/msw_ed25519 \
    .ssh/msw_ed25519.pub \
    .ssh/config.d/msw.conf
  do
    grep -Fqx -- "$required" "$listing" || grep -Fqx -- "$required/" "$listing" || \
      fatal "backup is incomplete; missing $required"
  done
}

validate_staged_backup() {
  local stage="$1" link target
  if find "$stage" \( -type b -o -type c -o -type p -o -type s \) -print -quit | grep -q .; then
    fatal "backup contains a device, FIFO, or socket"
  fi
  # Absolute symlinks in managed state are unnecessary for this setup and can
  # unexpectedly escape the restored tree when followed later.
  while IFS= read -r -d '' link; do
    target="$(readlink "$link")"
    [[ "$target" != /* ]] || fatal "backup contains an absolute symlink: ${link#$stage/}"
  done < <(find "$stage" -type l -print0)
}

restore_state_health() {
  "$MSB_BIN" snapshot reindex >/dev/null
  "$MSB_BIN" doctor >/dev/null
  snapshot_exists "$MSW_BASE_SNAPSHOT" || return 1
  local box
  for box in "${WORKSPACES[@]}"; do
    sandbox_exists "$box" || return 1
    volume_exists "$(workspace_volume "$box" workspace)" || return 1
    volume_exists "$(workspace_volume "$box" runtime)" || return 1
  done
}

cmd_restore() {
  local archive="${1:-}" assume_yes=0 arg checksum stage rollback listing
  [[ -n "$archive" ]] || fatal "usage: msw restore ARCHIVE [--yes]"
  shift || true
  for arg in "$@"; do
    case "$arg" in --yes|-y) assume_yes=1 ;; *) fatal "unknown restore option: $arg" ;; esac
  done
  [[ -f "$archive" ]] || fatal "backup archive not found: $archive"
  archive="$(cd "$(dirname "$archive")" && pwd -P)/$(basename "$archive")"
  require_command_path gtar "$GTAR_BIN"
  require_command_path zstd "$ZSTD_BIN"
  require_command_path shasum "$SHASUM_BIN"

  checksum="$archive.sha256"
  if [[ -f "$checksum" ]]; then
    note "Verifying SHA-256 checksum"
    (cd "$(dirname "$archive")" && "$SHASUM_BIN" -a 256 -c "$(basename "$checksum")") || fatal "backup checksum failed"
  else
    warn "checksum sidecar is missing; archive integrity cannot be authenticated"
  fi

  stage="$(mktemp -d "${TMPDIR:-/tmp}/msw-restore-stage.XXXXXX")"
  rollback="$HOME/.msw-restore-rollback-$(date +%Y%m%d-%H%M%S)"
  listing="$stage.members"

  (
    local transaction_active=0 rel source target item rc
    local -a installed=() saved=()

    rollback_restore() {
      warn "restore failed; rolling back the previous managed state"
      for item in "${installed[@]}"; do rm -rf "$HOME/$item"; done
      for item in "${saved[@]}"; do
        mkdir -p "$(dirname "$HOME/$item")"
        mv "$rollback/$item" "$HOME/$item"
      done
      "$MSB_BIN" snapshot reindex >/dev/null 2>&1 || true
    }

    cleanup_restore() {
      rc=$?
      trap - EXIT INT TERM HUP
      if (( transaction_active == 1 )); then rollback_restore; fi
      rm -rf "$stage"
      rm -f "$listing"
      exit "$rc"
    }
    trap cleanup_restore EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP

    note "Validating archive paths"
    "$ZSTD_BIN" -dc -q "$archive" | "$GTAR_BIN" -tf - >"$listing"
    validate_backup_listing "$listing"

    "$ZSTD_BIN" -dc -q "$archive" |
      "$GTAR_BIN" --extract --no-same-owner --no-same-permissions --delay-directory-restore -C "$stage" -f -
    validate_staged_backup "$stage"

    if [[ "$assume_yes" != 1 && "${MSW_ASSUME_YES:-0}" != 1 ]]; then
      cat <<CONFIRM
This replaces the managed MicroSandbox state and MSW configuration in your home directory.
Current managed files will be retained at:
  $rollback

Keychain tokens are not changed.
Type RESTORE to continue:
CONFIRM
      local answer; IFS= read -r answer
      [[ "$answer" == RESTORE ]] || fatal "restore cancelled"
    fi

    note "Stopping current managed workspaces"
    cmd_stop all >/dev/null 2>&1 || true
    mkdir -p "$rollback"
    transaction_active=1

    while IFS= read -r rel; do
      [[ -n "$rel" ]] || continue
      source="$stage/$rel"; target="$HOME/$rel"
      [[ -e "$source" || -L "$source" ]] || continue
      if [[ -e "$target" || -L "$target" ]]; then
        mkdir -p "$(dirname "$rollback/$rel")"
        mv "$target" "$rollback/$rel"
        saved+=("$rel")
      fi
      mkdir -p "$(dirname "$target")"
      mv "$source" "$target"
      installed+=("$rel")
    done < <(managed_backup_paths)

    restore_state_health || fatal "restored state did not pass health checks"
    transaction_active=0
  )

  ok "restore complete; workspaces remain stopped"
  printf 'Previous managed files: %s\n' "$rollback"
  printf 'Run: msw host repair\n'
  printf 'Then: msw check --deep\n'
}

cmd_docs() {
  local topic="${1:-cheatsheet}" file pager
  case "$topic" in
    cheatsheet|commands) file="$MSW_DOCS_DIR/MSW-CHEATSHEET.md" ;;
    setup) file="$MSW_DOCS_DIR/SETUP-GUIDE.md" ;;
    github) file="$MSW_DOCS_DIR/GITHUB-SETUP.md" ;;
    tests|test-report) file="$MSW_DOCS_DIR/TEST-REPORT.md" ;;
    *) fatal "docs topic must be cheatsheet, setup, github, or tests" ;;
  esac
  [[ -f "$file" ]] || fatal "documentation missing; rerun setup.sh"
  pager="${PAGER:-less}"
  if [[ -t 1 && "$pager" != cat ]]; then "$pager" "$file"; else cat "$file"; fi
}

