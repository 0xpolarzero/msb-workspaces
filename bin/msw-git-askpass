#!/bin/sh
set -eu

service="${MSW_KEYCHAIN_SERVICE:-msw.github.write}"
account="${MSW_KEYCHAIN_ACCOUNT:-}"
security_bin="${MSW_SECURITY_BIN:-/usr/bin/security}"
keychain_home="${MSW_KEYCHAIN_HOME:-$HOME}"
test_keychain_dir="${MSW_TEST_KEYCHAIN_DIR:-}"
prompt="${1:-}"

safe_component() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

keychain_read() {
  service_name="$1"
  account_name="$2"
  if [ -n "$test_keychain_dir" ]; then
    file="$test_keychain_dir/$(safe_component "$service_name")__$(safe_component "$account_name")"
    [ -f "$file" ] || return 1
    cat "$file"
  else
    HOME="$keychain_home" "$security_bin" find-generic-password \
      -w -s "$service_name" -a "$account_name" 2>/dev/null
  fi
}

valid_installation_token() {
  value="$1"
  case "$value" in
    ghs_*) ;;
    *) return 1 ;;
  esac
  [ "${#value}" -le 4096 ] || return 1
  case "$value" in
    *[![:graph:]]*) return 1 ;;
  esac
}

valid_scoped_record() {
  raw="$1"
  jq_bin="${MSW_JQ_BIN:-}"
  [ -n "$jq_bin" ] && [ -x "$jq_bin" ] || return 1
  "$jq_bin" -e '
    type == "object" and
    .schemaVersion == 3 and
    (.grantID | type == "string" and length > 0) and
    (.accessToken |
      type == "string" and
      length > 0 and
      length <= 4096 and
      test("^ghs_[^[:space:][:cntrl:]]+$") and
      (test("^(ghp_|gho_|ghu_|ghr_|github_pat_)"; "i") | not)
    ) and
    (.accessExpiresAt | type == "string" and length > 0) and
    (.generation | type == "number" and . > 0) and
    (.refreshToken // null) == null
  ' <<EOF >/dev/null 2>&1
$raw
EOF
}

case "$prompt" in
  *sername*|*Username*)
    printf '%s\n' 'x-access-token'
    ;;
  *assword*)
    if valid_installation_token "${MSW_GITHUB_WRITE_TOKEN:-}"; then
      printf '%s\n' "$MSW_GITHUB_WRITE_TOKEN"
    elif [ -n "${MSW_APP_KEYCHAIN_SERVICE:-}" ]; then
      raw="$(keychain_read "$MSW_APP_KEYCHAIN_SERVICE" "${MSW_APP_KEYCHAIN_ACCOUNT:-profile}")" || exit 1
      valid_scoped_record "$raw" || exit 1
      jq_bin="${MSW_JQ_BIN:-}"
      "$jq_bin" -r '.accessToken' <<EOF
$raw
EOF
    elif [ "${MSW_TEST_MODE:-0}" = 1 ] &&
      [ -n "${MSW_KEYCHAIN_SERVICE:-}" ] &&
      [ -n "${MSW_KEYCHAIN_ACCOUNT:-}" ]; then
      keychain_read "$MSW_KEYCHAIN_SERVICE" "$MSW_KEYCHAIN_ACCOUNT" || exit 1
    else
      exit 1
    fi
    ;;
  *)
    exit 1
    ;;
esac
