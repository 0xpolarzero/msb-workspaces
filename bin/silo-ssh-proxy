#!/bin/sh
set -eu

host="${1:?missing SSH host alias}"
box="${host%.msb}"

config="${SILO_CONFIG_FILE:-$HOME/.config/silo/config.sh}"
[ -f "$config" ] || {
  echo "silo: silo configuration is missing; rerun setup.sh" >&2
  exit 1
}
# The SSH proxy is invoked by ssh rather than through the silo CLI, so it reads
# the installed Silo configuration directly.
# shellcheck source=/dev/null
. "$config"

security_bin="${SILO_SECURITY_BIN:-/usr/bin/security}"
jq_bin="${SILO_JQ_BIN:-}"
if [ -z "$jq_bin" ]; then
  jq_bin="$(command -v jq 2>/dev/null || true)"
fi
workspaces_file="${SILO_WORKSPACES_FILE:-$HOME/.config/silo/workspaces.json}"
if [ ! -x "$jq_bin" ] || [ ! -f "$workspaces_file" ] ||
   [ -L "$workspaces_file" ] ||
   [ "$(wc -c <"$workspaces_file")" -gt 262144 ] ||
   ! "$jq_bin" -e --arg box "$box" '
     type == "object" and
     (keys | sort) == ["schemaVersion", "workspaces"] and
     .schemaVersion == 1 and
     (.workspaces | type == "array" and length > 0 and length <= 64) and
     ([.workspaces[].name] | length == (unique | length)) and
     all(.workspaces[]; . as $w |
       ($w | type == "object") and
       ($w | keys | sort) == ["cpu", "cpuCeiling", "memoryCeilingGiB", "memoryGiB", "name", "runtimeStorageGiB", "workspaceStorageGiB"] and
       ($w.name | type == "string" and test("^[a-z][a-z0-9-]{0,31}$")) and
       ([4,6,8,12] | index($w.cpu)) != null and
       ([4,6,8,12] | index($w.cpuCeiling)) != null and $w.cpu <= $w.cpuCeiling and
       ([16,32,48] | index($w.memoryGiB)) != null and
       ([16,32,48] | index($w.memoryCeilingGiB)) != null and $w.memoryGiB <= $w.memoryCeilingGiB and
       ([60,80,100,120] | index($w.workspaceStorageGiB)) != null and
       ([60,80,100,120] | index($w.runtimeStorageGiB)) != null) and
     (.workspaces | map(.name) | index($box) != null)
   ' "$workspaces_file" >/dev/null 2>&1; then
  echo "silo: unknown workspace '$box'" >&2
  exit 64
fi

safe_component() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

keychain_read() {
  service="$1"
  account="$2"
  if [ -n "${SILO_TEST_KEYCHAIN_DIR:-}" ]; then
    file="$SILO_TEST_KEYCHAIN_DIR/$(safe_component "$service")__$(safe_component "$account")"
    [ -f "$file" ] || return 1
    cat "$file"
  else
    "$security_bin" find-generic-password -w -s "$service" -a "$account" 2>/dev/null
  fi
}

app_credentials="${SILO_APP_CREDENTIALS_FILE:-$HOME/Library/Application Support/Silo/credentials.json}"

app_credentials_valid() {
  [ -f "$app_credentials" ] && [ ! -L "$app_credentials" ] || return 1
  [ -n "$jq_bin" ] && [ -x "$jq_bin" ] || return 1
  "$jq_bin" -e '
    type == "object" and
    (keys | sort) == ["entries", "schemaVersion"] and
    .schemaVersion == 3 and
    (.entries | type == "object") and
    all(.entries[];
      type == "object" and
      ((keys - ["accessExpiresAt", "accessMode", "accountLogin", "generation", "grantID", "installationID", "needsRestart", "owner", "provider", "quarantined", "recoveryState", "repositoryIDs", "repositoryNames", "role", "schemaVersion", "scopeDigest", "updatedAt", "verificationRepository", "workspace"]) | length) == 0 and
      ((["accessMode", "generation", "needsRestart", "provider", "quarantined", "recoveryState", "repositoryIDs", "repositoryNames", "role", "schemaVersion", "updatedAt", "workspace"] - keys) | length) == 0 and
      .schemaVersion == 3 and
      .provider == "github-app-installation" and
      (.workspace | type == "string" and length > 0) and
      (.role == "guest" or .role == "host") and
      (.generation | type == "number" and . > 0)
    )
  ' "$app_credentials" >/dev/null 2>&1
}

metadata_value() {
  role="$1"
  field="$2"
  [ -f "$app_credentials" ] && [ ! -L "$app_credentials" ] || return 1
  [ -n "$jq_bin" ] && [ -x "$jq_bin" ] || return 1
  "$jq_bin" -r --arg key "$box.$role" --arg field "$field" \
    '.entries[$key][$field] // empty' "$app_credentials" 2>/dev/null
}

app_profile_present() {
  [ "$(metadata_value guest workspace 2>/dev/null || true)" = "$box" ]
}

timestamp_epoch() {
  value="$1"
  [ -n "$value" ] || return 1
  date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$value" +%s 2>/dev/null ||
    date -u -d "$value" +%s 2>/dev/null
}

app_expiry_state() {
  access="$(metadata_value guest accessExpiresAt 2>/dev/null || true)"
  [ -n "$access" ] || return 1
  access_epoch="$(timestamp_epoch "$access")" || return 1
  now="$(date +%s)"
  soon=$((now + 3600))
  if [ "$access_epoch" -le "$now" ]; then
    printf 'authorization-required'
  elif [ "$access_epoch" -le "$soon" ]; then
    printf 'expiring'
  else
    printf 'valid'
  fi
}

app_token() {
  provider="$(metadata_value guest provider 2>/dev/null || true)"
  recovery_state="$(metadata_value guest recoveryState 2>/dev/null || true)"
  expiry_state="$(app_expiry_state 2>/dev/null || true)"
  [ "$provider" = "github-app-installation" ] || return 1
  [ "$recovery_state" = "ready" ] || return 1
  [ "$expiry_state" = valid ] || [ "$expiry_state" = expiring ] || return 1
  [ -n "$jq_bin" ] && [ -x "$jq_bin" ] || return 1

  raw="$(keychain_read "silo.github.app.$box.guest.tokens" profile)" || return 1
  printf '%s\n' "$raw" | "$jq_bin" -e '
    type == "object" and
    .schemaVersion == 3 and
    (.grantID | type == "string" and length > 0) and
    (.accessToken |
      type == "string" and
      length > 0 and
      length <= 4096 and
      test("^ghs_[^[:space:][:cntrl:]]+$") and
      (test("^(ghp_|gho_|ghu_|ghr_|github_pat_)"; "i") | not)
    ) and
    (.accessExpiresAt | type == "string" and length > 0) and
    (.generation | type == "number" and . > 0) and
    (.refreshToken // null) == null
  ' >/dev/null 2>&1 || return 1
  printf '%s\n' "$raw" | "$jq_bin" -r '.accessToken'
}

mode="${SILO_GITHUB_MODE:-local}"
case "$mode" in
  local)
    quarantine="$HOME/.config/silo/github/$box.quarantine"
    if [ -e "$quarantine" ] || [ -L "$quarantine" ]; then
      echo "silo: workspace '$box' is quarantined; repair GitHub access in Silo" >&2
      exit 1
    fi
    # The local path never exports a credential into the guest.
    ;;
  connect)
    if ! app_credentials_valid; then
      echo "silo: Silo's scoped GitHub credential file is missing or invalid" >&2
      exit 1
    fi
    if app_profile_present; then
      recovery_state="$(metadata_value guest recoveryState 2>/dev/null || true)"
      quarantined="$(metadata_value guest quarantined 2>/dev/null || true)"
      if [ "$quarantined" = true ] || [ "$recovery_state" = quarantined ]; then
        echo "silo: workspace '$box' is quarantined; repair GitHub access in Silo" >&2
        exit 1
      fi
      if ! token="$(app_token 2>/dev/null)"; then
        echo "silo: scoped GitHub access for '$box' is missing, expired, or requires reauthorization; repair it in Silo" >&2
        exit 1
      fi
      export GH_TOKEN="$token"
      unset token
    else
      echo "silo: workspace '$box' has no scoped GitHub grant; connect GitHub in Silo" >&2
      exit 1
    fi
    ;;
  *)
    echo "silo: invalid SILO_GITHUB_MODE '$mode' (expected local or connect)" >&2
    exit 1
    ;;
esac

MSB="${SILO_MSB_BIN:-$HOME/.local/bin/msb}"
if [ ! -x "$MSB" ]; then MSB="$(command -v msb 2>/dev/null || true)"; fi
[ -n "$MSB" ] && [ -x "$MSB" ] || {
  echo "silo: msb was not found; rerun setup.sh" >&2
  exit 127
}

if ! "$MSB" ping -q "$box" >/dev/null 2>&1; then
  # The host-managed port forwarder (lib/silo-port-forwarder.py) must NEVER
  # auto-start a stopped VM: it runs ssh through this proxy with
  # SILO_SSH_PROXY_NO_START=1 so a stopped workspace fails the connection
  # instead of booting.
  if [ "${SILO_SSH_PROXY_NO_START:-0}" = 1 ]; then
    echo "silo: workspace '$box' is not running; not auto-starting (port forwarder)" >&2
    exit 1
  fi
  if ! output="$("$MSB" start -q "$box" 2>&1)"; then
    sleep 1
    "$MSB" ping -q "$box" >/dev/null 2>&1 || {
      [ -n "$output" ] && echo "$output" >&2
      exit 1
    }
  fi

  attempt=0
  until "$MSB" ping -q "$box" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 120 ]; then
      echo "silo: '$box' did not become ready" >&2
      "$MSB" logs "$box" --source system --tail 50 2>/dev/null || true
      exit 1
    fi
    sleep 1
  done
fi

exec "$MSB" ssh serve "$box" --stdio
