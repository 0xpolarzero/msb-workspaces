#!/bin/sh
set -eu

host="${1:?missing SSH host alias}"
box="${host%.msb}"

config="${SILO_CONFIG_FILE:-$HOME/.config/silo/config.sh}"
[ -f "$config" ] || {
  echo "silo: silo configuration is missing; rerun setup.sh" >&2
  exit 1
}
# The SSH proxy is invoked by ssh rather than through the silo CLI, so it reads
# the installed Silo configuration directly.
# shellcheck source=/dev/null
. "$config"

jq_bin="${SILO_JQ_BIN:-}"
if [ -z "$jq_bin" ]; then
  jq_bin="$(command -v jq 2>/dev/null || true)"
fi
workspaces_file="${SILO_WORKSPACES_FILE:-$HOME/.config/silo/workspaces.json}"
if [ ! -x "$jq_bin" ] || [ ! -f "$workspaces_file" ] ||
   [ -L "$workspaces_file" ] ||
   [ "$(wc -c <"$workspaces_file")" -gt 262144 ] ||
   ! "$jq_bin" -e --arg box "$box" '
     type == "object" and
     (keys | sort) == ["schemaVersion", "workspaces"] and
     .schemaVersion == 1 and
     (.workspaces | type == "array" and length > 0 and length <= 64) and
     ([.workspaces[].name] | length == (unique | length)) and
     all(.workspaces[]; . as $w |
       ($w | type == "object") and
       ($w | keys | sort) == ["cpu", "cpuCeiling", "memoryCeilingGiB", "memoryGiB", "name", "runtimeStorageGiB", "workspaceStorageGiB"] and
       ($w.name | type == "string" and test("^[a-z][a-z0-9-]{0,31}$")) and
       ([4,6,8,12] | index($w.cpu)) != null and
       ([4,6,8,12] | index($w.cpuCeiling)) != null and $w.cpu <= $w.cpuCeiling and
       ([16,32,48] | index($w.memoryGiB)) != null and
       ([16,32,48] | index($w.memoryCeilingGiB)) != null and $w.memoryGiB <= $w.memoryCeilingGiB and
       ([60,80,100,120] | index($w.workspaceStorageGiB)) != null and
       ([60,80,100,120] | index($w.runtimeStorageGiB)) != null) and
     (.workspaces | map(.name) | index($box) != null)
   ' "$workspaces_file" >/dev/null 2>&1; then
  echo "silo: unknown workspace '$box'" >&2
  exit 64
fi

MSB="${SILO_MSB_BIN:-$HOME/.local/bin/msb}"
if [ ! -x "$MSB" ]; then MSB="$(command -v msb 2>/dev/null || true)"; fi
[ -n "$MSB" ] && [ -x "$MSB" ] || {
  echo "silo: msb was not found; rerun setup.sh" >&2
  exit 127
}

if ! "$MSB" ping -q "$box" >/dev/null 2>&1; then
  # The host-managed port forwarder (lib/silo-port-forwarder.py) must NEVER
  # auto-start a stopped VM: it runs ssh through this proxy with
  # SILO_SSH_PROXY_NO_START=1 so a stopped workspace fails the connection
  # instead of booting.
  if [ "${SILO_SSH_PROXY_NO_START:-0}" = 1 ]; then
    echo "silo: workspace '$box' is not running; not auto-starting (port forwarder)" >&2
    exit 1
  fi
  if ! output="$("$MSB" start -q "$box" 2>&1)"; then
    sleep 1
    "$MSB" ping -q "$box" >/dev/null 2>&1 || {
      [ -n "$output" ] && echo "$output" >&2
      exit 1
    }
  fi

  attempt=0
  until "$MSB" ping -q "$box" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 120 ]; then
      echo "silo: '$box' did not become ready" >&2
      "$MSB" logs "$box" --source system --tail 50 2>/dev/null || true
      exit 1
    fi
    sleep 1
  done
fi

exec "$MSB" ssh serve "$box" --stdio
